@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<style>

    .chart-wrapper {
        position: relative;
        width: 100%;
        height: 420px;
    }

    @@media(max - width:768px) {

        .chart-wrapper {
            height: 320px;
        }
    }

    .dashboard-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        transition: .25s;
        position: relative;
        overflow: hidden;
        height: 100%;
        max-width: 100%;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .dashboard-card .icon-box {
            width: 65px;
            height: 65px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        .dashboard-card h2 {
            font-size: 34px;
            font-weight: 700;
            margin-top: 10px;
        }

        .dashboard-card p {
            margin: 0;
            color: #64748b;
            font-size: 15px;
        }

    .dashboard-title {
        font-size: 40px;
        font-weight: 700;
    }

    .dashboard-subtitle {
        color: #64748b;
        font-size: 17px;
    }

    .chart-card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
    }

    .mini-text {
        font-size: 13px;
        color: #94a3b8;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .status-box {
        background: white;
        padding: 20px;
        border-radius: 18px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.05);
        height: 100%;
    }

        .status-box h5 {
            font-weight: 600;
        }

    .status-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .status-item:last-child {
            border-bottom: none;
        }

    .badge-custom {
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
    }

    @@media (max-width:768px) {

        .row {
            margin: 0 !important;
        }

        .col,
        .col-md-3,
        .col-md-4,
        .col-md-6,
        .col-lg-3,
        .col-lg-4 {
            width: 100% !important;
            max-width: 100% !important;
            flex: 0 0 100% !important;
        }
    }

    /* =======================================================
       DARK MODE DASHBOARD
    ======================================================= */

    body.dark-mode .dashboard-card,
    body.dark-mode .chart-card,
    body.dark-mode .status-box {
        background: #1e293b !important;
        border: 1px solid #334155;
        color: white !important;
    }

        body.dark-mode .dashboard-card p,
        body.dark-mode .dashboard-subtitle,
        body.dark-mode .mini-text,
        body.dark-mode .status-item span {
            color: #cbd5e1 !important;
        }

        body.dark-mode .dashboard-title,
        body.dark-mode .dashboard-card h2,
        body.dark-mode .chart-card h5,
        body.dark-mode .status-box h5 {
            color: white !important;
        }

    /* =======================================================
       CHART
    ======================================================= */

    body.dark-mode canvas {
        background: transparent !important;
    }

    /* =======================================================
       OVERLAY MOBILE
    ======================================================= */

    .overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.5);
        opacity: 0;
        visibility: hidden;
        transition: .3s;
        z-index: 998;
    }

        .overlay.active {
            opacity: 1;
            visibility: visible;
        }

    /* =======================================================
       MOBILE FIXES
    ======================================================= */

    @@media(max - width:768px) {

        .top-bar {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .dashboard-title {
            font-size: 30px !important;
            line-height: 1.1;
        }

        .dashboard-subtitle {
            font-size: 15px;
        }

        .dashboard-card,
        .chart-card,
        .status-box {
            padding: 18px !important;
        }

            .dashboard-card h2 {
                font-size: 28px !important;
                word-break: break-word;
            }

        .icon-box {
            width: 55px !important;
            height: 55px !important;
            font-size: 22px !important;
        }

        .chart-card canvas {
            max-height: 250px !important;
        }
    }

</style>

<div class="top-bar">

    <div>
        <div class="dashboard-title">
            Dashboard
        </div>

        <div class="dashboard-subtitle">
            Resumen general de tu negocio y reportes financieros.
        </div>
    </div>

    <div class="text-end">
        <div class="mini-text">
            Última actualización
        </div>

        <b id="fechaActual"></b>
    </div>

</div>

<div class="row g-4">

    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ventas del Día</p>

                    <h2>
                        $@ViewBag.VentasHoyMonto.ToString("N2")
                    </h2>

                    <span class="text-success">
                        💵 Hoy
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dcfce7;color:#16a34a">

                    🟢

                </div>

            </div>

        </div>

    </div>
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Envíos del Día</p>

                    <h2>
                        $@ViewBag.EnviosHoyMonto.ToString("N2")
                    </h2>

                    <span class="text-warning">
                        🚚 Hoy
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#ffedd5;color:#ea580c">

                    🚚

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ventas Realizadas Hoy</p>

                    <h2>
                        @ViewBag.CantidadVentasHoy
                    </h2>

                    <span class="text-primary">
                        📄 Facturas
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dbeafe;color:#2563eb">

                    📄

                </div>

            </div>

        </div>

    </div>
    <!-- VENTAS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ventas Totales</p>

                    <h2 id="ventasTotales">
                        $@ViewBag.VentasTotales.ToString("N2")
                    </h2>

                    <span class="text-success">
                        ↑ +12%
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dcfce7;color:#16a34a">

                    💰

                </div>

            </div>

        </div>

    </div>

    <!-- GANANCIA -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ganancia Neta</p>

                    <h2 id="gananciaNeta">
                        $@ViewBag.GananciaNeta.ToString("N2")
                    </h2>

                    <span class="text-primary">
                        ↑ +8%
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dbeafe;color:#2563eb">

                    📈

                </div>

            </div>

        </div>

    </div>

    <!-- ENVÍOS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Gastos de Envío</p>

                    <h2 id="gastosEnvio">
                        $@ViewBag.GastosEnvio.ToString("N2")
                    </h2>

                    <span class="text-warning">
                        🚚 Envíos activos
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#ffedd5;color:#ea580c">

                    🚚

                </div>

            </div>

        </div>

    </div>

</div>

<div class="row g-4 mt-1">

    <!-- COSTOS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Costos / Reinversión</p>

                    <h2 id="costos">
                        $@ViewBag.CostoProductos.ToString("N2")
                    </h2>

                    <span class="text-danger">
                        ↓ Gastos operativos
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#fee2e2;color:#dc2626">

                    📉

                </div>

            </div>

        </div>

    </div>

    <!-- CLIENTES -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Clientes Registrados</p>

                    <h2>
                        @ViewBag.Clientes
                    </h2>

                    <span class="text-success">
                        Clientes activos
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#f3e8ff;color:#9333ea">

                    👤

                </div>

            </div>

        </div>

    </div>

    <!-- PRODUCTOS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Productos en Catálogo</p>

                    <h2>
                        @ViewBag.Productos
                    </h2>

                    <span class="text-primary">
                        Inventario disponible
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dbeafe;color:#2563eb">

                    📦

                </div>

            </div>

        </div>

    </div>

</div>

<div class="row mt-4 g-4">

    <!-- GRAFICA -->
    <div class="col-lg-8">

        <div class="chart-card h-100">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    Ventas y Ganancias (Últimos 7 días)
                </h5>

                <span class="badge bg-primary">
                    Reporte semanal
                </span>

            </div>

            <div class="chart-wrapper">
                <canvas id="chart"></canvas>
            </div>

        </div>

    </div>

    <!-- ESTADO SISTEMA -->
    <div class="col-lg-4">

        <div class="status-box h-100">

            <h5>
                Estado del Sistema
            </h5>

            <div class="status-item">

                <span>Facturas Hoy</span>

                <span class="badge-custom bg-success text-white">
                    @ViewBag.FacturasHoy
                </span>

            </div>

            <div class="status-item">

                <span>Pedidos Pendientes</span>

                <span class="badge-custom bg-warning text-dark">
                    @ViewBag.Pendientes
                </span>

            </div>

            <div class="status-item">

                <span>Productos Bajos</span>

                <span class="badge-custom bg-danger text-white">
                    @ViewBag.ProductosBajos
                </span>

            </div>

            <div class="status-item">

                <span>Usuarios Activos</span>

                <span class="badge-custom bg-primary text-white">
                    @ViewBag.Usuarios
                </span>

            </div>

        </div>

    </div>

    <!-- VENTAS EMPLEADOS HOY -->
    <div class="col-lg-6">

        <div class="status-box h-100">

            <h5 class="mb-4">
                Ventas de Empleados Hoy
            </h5>

            @foreach (var item in ViewBag.VentasUsuariosHoy)
            {
                var color = "danger";

                if (item.Ventas >= 10)
                {
                    color = "success";
                }
                else if (item.Ventas >= 5)
                {
                    color = "warning";
                }

                <div class="status-item">

                    <span>
                        @item.Usuario
                    </span>

                    <span class="badge-custom bg-@color text-white">
                        @item.Ventas ventas
                    </span>

                </div>
            }

        </div>

    </div>

    <!-- VENTAS TOTALES -->
    <div class="col-lg-6">

        <div class="status-box h-100">

            <h5 class="mb-4">
                Ventas Totales por Usuario
            </h5>

            @foreach (var item in ViewBag.VentasUsuariosTotal)
            {
                var color = "danger";

                if (item.Total >= 100)
                {
                    color = "success";
                }
                else if (item.Total >= 50)
                {
                    color = "warning";
                }

                <div class="status-item">

                    <span>
                        @item.Usuario
                    </span>

                    <span class="badge-custom bg-@color text-white">
                        $@item.Total.ToString("N2")
                    </span>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {

    <script>

        //////////////////////////////////////////////////////
        // FECHA
        //////////////////////////////////////////////////////

        document.getElementById("fechaActual").innerText =
            new Date().toLocaleString();

        //////////////////////////////////////////////////////
        // DATA
        //////////////////////////////////////////////////////

        const labels =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Labels));

        const ventas =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.VentasSemana));

        const ganancias =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.GananciasSemana));

        //////////////////////////////////////////////////////
        // CHART
        //////////////////////////////////////////////////////

        const ctx = document.getElementById('chart');

        new Chart(ctx, {

            type: 'bar',

            data: {

                labels: labels,

                datasets: [

                    {
                        label: 'Ventas',
                        data: ventas,
                        backgroundColor: '#3b82f6',
                        borderRadius: 10,
                        barThickness: 22,
                        maxBarThickness: 28
                    },

                    {
                        label: 'Ganancias',
                        data: ganancias,
                        backgroundColor: '#22c55e',
                        borderRadius: 10,
                        barThickness: 22,
                        maxBarThickness: 28
                    }
                ]
            },

            options: {

                responsive: true,
                maintainAspectRatio: false,

                layout: {
                    padding: 15
                },

                plugins: {

                    legend: {

                        position: 'top',

                        labels: {
                            color: '#cbd5e1',
                            padding: 20,
                            font: {
                                size: 13
                            }
                        }
                    }
                },

                scales: {

                    x: {

                        ticks: {
                            color: '#94a3b8',
                            font: {
                                size: 12
                            }
                        },

                        grid: {
                            color: 'rgba(255,255,255,0.05)'
                        }
                    },

                    y: {

                        beginAtZero: true,

                        ticks: {
                            color: '#94a3b8',
                            font: {
                                size: 12
                            }
                        },

                        grid: {
                            color: 'rgba(255,255,255,0.05)'
                        }
                    }
                }
            }
        });

    </script>

}