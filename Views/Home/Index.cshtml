@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}
<link href="~/css/dashboard.css" rel="stylesheet" />

<div class="top-bar">

    <div>
        <div class="dashboard-title">
            Dashboard
        </div>

        <div class="dashboard-subtitle">
            Resumen general de tu negocio y reportes financieros.
        </div>
    </div>

    <div class="text-end">
        <div class="mini-text">
            Última actualización
        </div>

        <b id="fechaActual"></b>
    </div>

</div>
<div class="d-flex gap-2 mb-4 flex-wrap">

    <input type="date"
           id="fechaInicio"
           class="form-control"
           style="max-width:200px;" />

    <input type="date"
           id="fechaFin"
           class="form-control"
           style="max-width:200px;" />

    <button class="btn btn-primary"
            onclick="filtrarDashboard()">

        Filtrar

    </button>

    <button class="btn btn-outline-secondary"
            onclick="limpiarFiltro()">

        Limpiar

    </button>

</div>

<div class="row g-4">

    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ventas del Día</p>

                    <h2>
                        $@ViewBag.VentasHoyMonto.ToString("N2")
                    </h2>

                    <span class="text-success">
                        💵 Hoy
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dcfce7;color:#16a34a">

                    🟢

                </div>

            </div>

        </div>

    </div>
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Envíos del Día</p>

                    <h2>
                        $@ViewBag.EnviosHoyMonto.ToString("N2")
                    </h2>

                    <span class="text-warning">
                        🚚 Hoy
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#ffedd5;color:#ea580c">

                    🚚

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ventas Realizadas Hoy</p>

                    <h2>
                        @ViewBag.CantidadVentasHoy
                    </h2>

                    <span class="text-primary">
                        📄 Facturas
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dbeafe;color:#2563eb">

                    📄

                </div>

            </div>

        </div>

    </div>
    <!-- VENTAS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ventas Totales</p>

                    <h2 id="ventasTotales">
                        $@ViewBag.VentasTotales.ToString("N2")
                    </h2>

                    <span class="text-success">
                        ↑ +12%
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dcfce7;color:#16a34a">

                    💰

                </div>

            </div>

        </div>

    </div>

    <!-- GANANCIA -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Ganancia Neta</p>

                    <h2 id="gananciaNeta">
                        $@ViewBag.GananciaNeta.ToString("N2")
                    </h2>

                    <span class="text-primary">
                        ↑ +8%
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dbeafe;color:#2563eb">

                    📈

                </div>

            </div>

        </div>

    </div>

    <!-- ENVÍOS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Gastos de Envío</p>

                    <h2 id="gastosEnvio">
                        $@ViewBag.GastosEnvio.ToString("N2")
                    </h2>

                    <span class="text-warning">
                        🚚 Envíos activos
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#ffedd5;color:#ea580c">

                    🚚

                </div>

            </div>

        </div>

    </div>

</div>

<div class="row g-4 mt-1">

    <!-- COSTOS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Costos / Reinversión</p>

                    <h2 id="costos">
                        $@ViewBag.CostoProductos.ToString("N2")
                    </h2>

                    <span class="text-danger">
                        ↓ Gastos operativos
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#fee2e2;color:#dc2626">

                    📉

                </div>

            </div>

        </div>

    </div>

    <!-- CLIENTES -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Clientes Registrados</p>

                    <h2>
                        @ViewBag.Clientes
                    </h2>

                    <span class="text-success">
                        Clientes activos
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#f3e8ff;color:#9333ea">

                    👤

                </div>

            </div>

        </div>

    </div>

    <!-- PRODUCTOS -->
    <div class="col-md-4">

        <div class="dashboard-card">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <p>Productos en Catálogo</p>

                    <h2>
                        @ViewBag.Productos
                    </h2>

                    <span class="text-primary">
                        Inventario disponible
                    </span>

                </div>

                <div class="icon-box"
                     style="background:#dbeafe;color:#2563eb">

                    📦

                </div>

            </div>

        </div>

    </div>

</div>

<div class="row mt-4 g-4">

    <!-- GRAFICA -->
    <div class="col-lg-8">

        <div class="chart-card h-100">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    Ventas y Ganancias (Últimos 7 días)
                </h5>

                <span class="badge bg-primary">
                    Reporte semanal
                </span>

            </div>

            <div class="chart-wrapper">
                <canvas id="chart"></canvas>
            </div>

        </div>

    </div>

    <!-- PRODUCTOS MAS VENDIDOS -->

    <div class="col-lg-4">

        <div class="status-box h-100">

            <h5>
                Productos Más Vendidos
            </h5>

            @foreach (var item in ViewBag.ProductosMasVendidos)
            {
                <div class="status-item">

                    <span>

                        @item.NombreProducto

                    </span>

                    <span class="badge-custom bg-success text-white">

                        @item.CantidadVendida

                    </span>

                </div>
            }

        </div>

    </div>

    <!-- VENTAS EMPLEADOS HOY -->
    <div class="col-lg-4">

        <div class="status-box h-100">

            <h5 class="mb-4">
                Ventas de Empleados Hoy
            </h5>

            @foreach (var item in ViewBag.VentasUsuariosHoy)
            {
                var color = "danger";

                if (item.Ventas >= 10)
                {
                    color = "success";
                }
                else if (item.Ventas >= 5)
                {
                    color = "warning";
                }

                <div class="status-item">

                    <span>
                        @item.Usuario
                    </span>

                    <span class="badge-custom bg-@color text-white">
                        @item.Ventas ventas
                    </span>

                </div>
            }

        </div>

    </div>

    <!-- VENTAS TOTALES -->
    <div class="col-lg-4">

        <div class="status-box h-100">

            <h5 class="mb-4">
                Ventas Totales por Usuario
            </h5>

            @foreach (var item in ViewBag.VentasUsuariosTotal)
            {
                var color = "danger";

                if (item.Total >= 100)
                {
                    color = "success";
                }
                else if (item.Total >= 50)
                {
                    color = "warning";
                }

                <div class="status-item">

                    <span>
                        @item.Usuario
                    </span>

                    <span class="badge-custom bg-@color text-white">
                        $@item.Total.ToString("N2")
                    </span>

                </div>
            }

        </div>

    </div>

    <!-- ESTADO DEL SISTEMA -->

    <div class="col-lg-4">

        <div class="status-box h-100">

            <h5>
                Estado del Sistema
            </h5>

            <div class="status-item">

                <span>Facturas Hoy</span>

                <span class="badge-custom bg-success text-white">
                    @ViewBag.FacturasHoy
                </span>

            </div>

            <div class="status-item">

                <span>Pedidos Pendientes</span>

                <span class="badge-custom bg-warning text-dark">
                    @ViewBag.Pendientes
                </span>

            </div>

            <div class="status-item">

                <span>Productos Bajos</span>

                <span class="badge-custom bg-danger text-white">
                    @ViewBag.ProductosBajos
                </span>

            </div>

            <div class="status-item">

                <span>Usuarios Activos</span>

                <span class="badge-custom bg-primary text-white">
                    @ViewBag.Usuarios
                </span>

            </div>

        </div>

    </div>

    <!-- TARJETAS ACTUALES DEL DASHBOARD -->

    <!-- NUEVO REPORTE DE CANCELACIONES -->

    <div class="row mt-4 g-3 cancelaciones-cards">

        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0 cancelacion-card h-100">
                <div class="card-body">
                    <h6>Cancelaciones del período</h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalCancelaciones
                    </h2>

                    <small>
                        Facturas canceladas
                    </small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0 cancelacion-card h-100">
                <div class="card-body">
                    <h6> Monto cancelado</h6>

                    <h2 class="fw-bold">
                        $@Convert.ToDecimal(ViewBag.MontoCancelaciones).ToString("N2")
                    </h2>

                    <small>
                        Total de facturas canceladas
                    </small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0 cancelacion-card h-100">
                <div class="card-body">
                    <h6>Usuario con más cancelaciones</h6>

                    <h2 class="fw-bold">
                        @ViewBag.UsuarioMasCancelaciones
                    </h2>

                    <small>
                        @ViewBag.CantidadUsuarioMasCancelaciones cancelaciones
                    </small>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Cancelaciones por usuario
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle cancelaciones-table">

                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Cancelaciones</th>
                            <th>Monto cancelado</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (ViewBag.CancelacionesPorUsuario != null &&
                             ViewBag.CancelacionesPorUsuario.Count > 0)
                        {
                            foreach (var item in ViewBag.CancelacionesPorUsuario)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @item.Usuario
                                        </strong>
                                    </td>

                                    <td>
                                        @item.Cancelaciones
                                    </td>

                                    <td>
                                        $@Convert.ToDecimal(item.Total).ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted">
                                    No hay cancelaciones en este período.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    Cancelaciones por Tienda
                </h5>

                <span class="badge bg-danger">
                    Canceladas
                </span>
            </div>

            <div class="cancelaciones-tiendas">

                @if (ViewBag.CancelacionesPorTienda != null &&
                     ViewBag.CancelacionesPorTienda.Count > 0)
                {
                    foreach (var item in ViewBag.CancelacionesPorTienda)
                    {
                        <div class="status-item">

                            <span>
                                <strong>@item.Tienda</strong>
                            </span>

                            <div class="d-flex align-items-center gap-2">

                                <span class="badge-custom bg-danger text-white">
                                    @item.Cancelaciones
                                </span>

                                <span class="text-muted">
                                    $@Convert.ToDecimal(item.Total).ToString("N2")
                                </span>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-3">
                        No hay cancelaciones por tienda en este período.
                    </div>
                }

            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    Productos más cancelados
                </h5>

                <span class="badge bg-danger">
                    Cancelaciones
                </span>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle cancelaciones-table">

                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Unidades canceladas</th>
                            <th>Facturas</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (ViewBag.ProductosCancelados != null &&
                             ViewBag.ProductosCancelados.Count > 0)
                        {
                            foreach (var item in ViewBag.ProductosCancelados)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @item.NombreProducto
                                        </strong>
                                    </td>

                                    <td>
                                        @item.CantidadCancelada
                                    </td>

                                    <td>
                                        @item.FacturasCanceladas
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted">
                                    No hay productos cancelados en este período.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <div class="col-12">

        <div class="chart-card">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    Participación de Ventas por Usuario
                </h5>

                <span class="badge bg-info">
                    %
                </span>

            </div>

            <div style="position:relative;height:450px;">

                <canvas id="chartUsuarios"></canvas>

                


            </div>

        </div>

    </div>


    <div class="col-12 mt-4">

        <div class="chart-card">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    Productos Más Vendidos (%)
                </h5>

                <span class="badge bg-success">
                    Top Productos
                </span>

            </div>

            <div style="position:relative;height:450px;">

                <canvas id="chartProductos"></canvas>

            </div>

        </div>

    </div>

    <div class="col-12 mt-4">

        <div class="chart-card">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">

                    Ventas por Tienda

                </h5>

                <span class="badge bg-primary">

                    %

                </span>

            </div>

            <div style="height:450px;">

                <canvas id="chartTiendas"></canvas>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        //////////////////////////////////////////////////////
        // FECHA
        //////////////////////////////////////////////////////

        document.getElementById("fechaActual").innerText =
            new Date().toLocaleString();

        //////////////////////////////////////////////////////
        // DATA
        //////////////////////////////////////////////////////

        const labels =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Labels));

        const ventas =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.VentasSemana));

        const ganancias =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.GananciasSemana));

        //////////////////////////////////////////////////////
        // CHART
        //////////////////////////////////////////////////////

                function obtenerColorTexto() {

            const fondo =
                getComputedStyle(document.body)
                .backgroundColor;

            // Modo oscuro
            if (fondo === "rgb(15, 23, 42)" ||
                fondo === "rgb(30, 41, 59)") {

                return "#cbd5e1";
            }

            // Modo claro
            return "#1f2937";
        }

        const colorTexto = obtenerColorTexto();
        

                //////////////////////////////////////////////////////
        // GRAFICA BARRAS
        //////////////////////////////////////////////////////

        const ctx = document.getElementById('chart');

        new Chart(ctx, {

            type: 'bar',

            data: {

                labels: labels,

                datasets: [

                    {
                        label: 'Ventas',
                        data: ventas,
                        backgroundColor: '#3b82f6',
                        borderRadius: 10,
                        barThickness: 22,
                        maxBarThickness: 28
                    },

                    {
                        label: 'Ganancias',
                        data: ganancias,
                        backgroundColor: '#22c55e',
                        borderRadius: 10,
                        barThickness: 22,
                        maxBarThickness: 28
                    }
                ]
            },

            options: {

                responsive: true,
                maintainAspectRatio: false,

                layout: {
                    padding: 15
                },

                plugins: {

                    legend: {

                        position: 'top',

                        labels: {
                            color: '#cbd5e1',
                            padding: 20,
                            font: {
                                size: 13
                            }
                        }
                    }
                },

                scales: {

                    x: {

                        ticks: {
                            color: '#94a3b8',
                            font: {
                                size: 12
                            }
                        },

                        grid: {
                            color: 'rgba(255,255,255,0.05)'
                        }
                    },

                    y: {

                        beginAtZero: true,

                        ticks: {
                            color: '#94a3b8',
                            font: {
                                size: 12
                            }
                        },

                        grid: {
                            color: 'rgba(255,255,255,0.05)'
                        }
                    }
                }
            }

        });

                



        //////////////////////////////////////////////////////
        // GRAFICO PASTEL USUARIOS
        //////////////////////////////////////////////////////



               const usuariosLabelsOriginal =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PastelUsuariosLabels));

        const usuariosValores =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PastelUsuariosValores));


        const totalVentas =
        usuariosValores.reduce((a,b) => a + b, 0);

        const usuariosLabels =
        usuariosLabelsOriginal.map((nombre,index) => {

            let porcentaje =
                ((usuariosValores[index] / totalVentas) * 100)
                .toFixed(1);

            return `${nombre} (${porcentaje}%)`;

        });
        const ctxUsuarios =
        document.getElementById('chartUsuarios');

        new Chart(ctxUsuarios, {

            type: 'pie',

            data: {

                labels: usuariosLabels,

                datasets: [{

                    data: usuariosValores,

                    backgroundColor: [
                        '#3b82f6',
                        '#22c55e',
                        '#f59e0b',
                        '#ef4444',
                        '#8b5cf6',
                        '#06b6d4',
                        '#ec4899',
                        '#84cc16'
                    ]
                }]
            },

                    options: {

            responsive: true,
            maintainAspectRatio: false,

            plugins: {

                legend: {

                    position:
                        window.innerWidth < 768
                        ? 'bottom'
                        : 'right',

                    maxWidth:
                        window.innerWidth < 768
                        ? 280
                        : 400,

                            labels: {

            color: function () {

                return document.body.classList.contains("dark-mode")
                    ? "#e2e8f0"
                    : "#1f2937";

            },

            usePointStyle: true,

            pointStyle: "rect",

            boxWidth: 12,

            padding: 18,

            font: {
                size: window.innerWidth < 768 ? 11 : 13
            }
        }
                }
            }
        }
        });

                const productosLabelsOriginal =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PastelProductosLabels));

        const productosValores =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PastelProductosValores));

        const totalProductos =
        productosValores.reduce((a,b) => a + b, 0);

        const productosLabels =
        productosLabelsOriginal.map((nombre,index)=>{

            let cantidad = productosValores[index];

            let porcentaje =
            ((cantidad / totalProductos) * 100).toFixed(0);

                    let nombreCorto =

        window.innerWidth < 768

        ? nombre.substring(0,18)

        : nombre;

        return `${nombreCorto} (${cantidad}) ${porcentaje}%`;

        });

        

                const ctxProductos =
        document.getElementById('chartProductos');

        new Chart(ctxProductos, {

            type: 'pie',

            data: {

                labels: productosLabels,

                datasets: [{

                    data: productosValores,

                    backgroundColor: [

                        '#3b82f6',
                        '#22c55e',
                        '#f59e0b',
                        '#ef4444',
                        '#8b5cf6',
                        '#06b6d4',
                        '#ec4899',
                        '#84cc16',
                        '#f97316',
                        '#14b8a6'
                    ]
                }]
            },

                options: {

        responsive: true,

        maintainAspectRatio: false,

                        plugins: {

            legend: {

                position:
                    window.innerWidth < 768
                    ? 'bottom'
                    : 'right',

                maxWidth:
                    window.innerWidth < 768
                    ? 280
                    : 400,

                     labels: {

            color: function () {

                return document.body.classList.contains("dark-mode")
                    ? "#e2e8f0"
                    : "#1f2937";

            },

            usePointStyle: true,

            pointStyle: "rect",

            boxWidth: 12,

            padding: 18,

            font: {
                size: window.innerWidth < 768 ? 11 : 13
            }
        }
            }
        }
            }
        });

                //////////////////////////////////////////////////////
        // GRAFICO PASTEL TIENDAS
        //////////////////////////////////////////////////////

        const tiendasLabelsOriginal =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PastelTiendasLabels));

        const tiendasValores =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PastelTiendasValores));

        const totalTiendas =
        tiendasValores.reduce((a,b)=>a+b,0);

        const tiendasLabels =
        tiendasLabelsOriginal.map((nombre,index)=>{

            let total =
                tiendasValores[index];

            let porcentaje =
                totalTiendas === 0
                ? 0
                : ((total / totalTiendas)*100).toFixed(1);

            return `${nombre} ($${total.toFixed(2)}) ${porcentaje}%`;

        });

        const ctxTiendas =
        document.getElementById("chartTiendas");

        new Chart(ctxTiendas,{

            type:"pie",

            data:{

                labels:tiendasLabels,

                datasets:[{

                    data:tiendasValores,

                    backgroundColor:[

                        '#3b82f6',
                        '#22c55e',
                        '#f59e0b',
                        '#ef4444',
                        '#8b5cf6',
                        '#06b6d4',
                        '#ec4899',
                        '#84cc16',
                        '#f97316',
                        '#14b8a6'

                    ]

                }]
            },

            options:{

                responsive:true,

                maintainAspectRatio:false,

                plugins:{

                    legend:{

                        position:
                            window.innerWidth < 768
                            ? "bottom"
                            : "right",

                        maxWidth:
                            window.innerWidth < 768
                            ? 280
                            : 400,

                        labels:{

                            color:function(){

                                return document.body.classList.contains("dark-mode")

                                ? "#e2e8f0"

                                : "#1f2937";

                            },

                            usePointStyle:true,

                            pointStyle:"rect",

                            boxWidth:12,

                            padding:18,

                            font:{

                                size:
                                window.innerWidth < 768
                                ? 11
                                : 13

                            }
                        }
                    }
                }
            }

        });





                //////////////////////////////////////////////////////
        // CARGAR FECHAS
        //////////////////////////////////////////////////////

        document.getElementById("fechaInicio").value =
        '@ViewBag.FechaInicio';

        document.getElementById("fechaFin").value =
        '@ViewBag.FechaFin';

        //////////////////////////////////////////////////////
        // FILTRAR
        //////////////////////////////////////////////////////

        function filtrarDashboard() {

            let inicio =
                document.getElementById("fechaInicio").value;

            let fin =
                document.getElementById("fechaFin").value;

            window.location =
                `/Home/Index?fechaInicio=${inicio}&fechaFin=${fin}`;
        }

        //////////////////////////////////////////////////////
        // LIMPIAR
        //////////////////////////////////////////////////////

        function limpiarFiltro() {

            window.location = '/Home/Index';
        }


             

    </script>

}