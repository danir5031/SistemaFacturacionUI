@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaFacturacionUI</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
        margin: 0;
        font-family: 'Segoe UI';
        background: #f5f6fa;
        }

        .sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        background: white;
        padding: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.05);
        transition: 0.3s;
        }

        .sidebar.collapsed {
        width: 80px;
        }

        .sidebar.collapsed span,
        .sidebar.collapsed h4 {
        display: none;
        }

        .menu a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        margin: 8px 0;
        border-radius: 10px;
        text-decoration: none;
        color: #555;
        }

        .menu a.active {
        background: #eef2ff;
        border: 1px solid #3b6df6;
        color: #3b6df6;
        }

        .main {
        margin-left: 260px;
        padding: 30px;
        transition: 0.3s;
        }

        .main.expanded {
        margin-left: 90px;
        }

        .toggle-btn {
        cursor: pointer;
        font-size: 20px;
        margin-bottom: 20px;
        }

        .card-box {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
    </style>
</head>

<body>

    @{
        var rol = Context.Session.GetString("rol");
        var usuario = Context.Session.GetString("usuario");
        var nombre = Context.Session.GetString("nombre");
    }

    <div id="sidebar" class="sidebar">

        <div class="toggle-btn" onclick="toggleSidebar()">☰</div>

        <h4>
            <img src="~/img/loo.png" width="100" height="50" /> Wachtmaker
        </h4>

        <div class="menu mt-4">

            <!-- 🔥 ADMIN -->
            @if (rol == "ADMIN")
            {
                <a href="/Home" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    🏠 <span>Dashboard</span>
                </a>

                <a href="/Cliente" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active" : "")">
                    👤 <span>Clientes</span>
                </a>

                <a href="/Producto" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")">
                    📦 <span>Productos</span>
                </a>

                <a href="/Facturacion" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")">
                    🧾 <span>Facturas</span>
                </a>
            }

            <!-- 🔥 EMPLEADO -->
            @if (rol == "EMPLEADO")
            {
                <a href="/Cliente" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active" : "")">
                    👤 <span>Clientes</span>
                </a>

                <a href="/Producto" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")">
                    📦 <span>Productos</span>
                </a>

                <a href="/Facturacion" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")">
                    🧾 <span>Facturación</span>
                </a>
            }

        </div>

        <!-- 🔥 USUARIO -->
        <div style="position:absolute; bottom:20px;">
            <p><b>@(nombre ?? "Invitado")</b></p>
            <p style="font-size:12px;">@(usuario ?? "")</p>
            <a href="/Login/Logout" style="color:red;">Cerrar sesión</a>
        </div>

    </div>

    <div id="main" class="main">
        @RenderBody()
    </div>

    <script>
        function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("collapsed");
        document.getElementById("main").classList.toggle("expanded");
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>