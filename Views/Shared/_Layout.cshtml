@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaFacturacionUI</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
        margin: 0;
        font-family: 'Segoe UI';
        background: #f5f6fa;
        }

        /* ////////////////////////////////////////////////////// */
        /* DARK MODE */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode {
        background: #0f172a;
        color: white;
        }

        /* SIDEBAR */

        body.dark-mode .sidebar {
        background: #111827;
        color: white;
        border-right: 1px solid #1f2937;
        }

        /* TEXTOS */

        body.dark-mode h1,
        body.dark-mode h2,
        body.dark-mode h3,
        body.dark-mode h4,
        body.dark-mode h5,
        body.dark-mode h6,
        body.dark-mode p,
        body.dark-mode label,
        body.dark-mode span,
        body.dark-mode small {
        color: #f8fafc !important;
        }

        /* LINKS MENU */

        body.dark-mode .menu a {
        color: #e5e7eb;
        }

        body.dark-mode .menu a.active {
        background: #1e293b;
        border: 1px solid #3b82f6;
        color: #60a5fa;
        }

        /* CARD */

        body.dark-mode .card-box {
        background: #1e293b;
        color: white;
        border: 1px solid #334155;
        }

        /* INPUTS */

        body.dark-mode .form-control,
        body.dark-mode textarea,
        body.dark-mode select {
        background: #0f172a;
        border: 1px solid #334155;
        color: white;
        }

        /* PLACEHOLDER */

        body.dark-mode ::placeholder {
        color: #94a3b8 !important;
        }

        /* TABLAS */

        

        body.dark-mode .table thead {
        background: #111827;
        }

        

        /* BOTON CERRAR SESION */

        body.dark-mode .logout-btn {
        background: #7f1d1d;
        color: white !important;
        }

        /* SEARCH RESULT */

        body.dark-mode .busqueda {
        background: #0f172a !important;
        }

        /* BADGES */

        body.dark-mode .badge.bg-success {
        background: #15803d !important;
        }

        body.dark-mode .badge.bg-danger {
        background: #b91c1c !important;
        }

        /* SCROLL */

        body.dark-mode ::-webkit-scrollbar {
        width: 8px;
        }

        body.dark-mode ::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 20px;
        }

        /* ////////////////////////////////////////////////////// */
        /* TABLAS */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode .table,
        body.dark-mode table {
        background: #0f172a !important;
        color: #f8fafc !important;
        }

        body.dark-mode .table thead,
        body.dark-mode table thead {
        background: #1e293b !important;
        }

        body.dark-mode .table thead th,
        body.dark-mode table thead th {
        background: #1e293b !important;
        color: white !important;
        border-color: #334155 !important;
        }

        body.dark-mode .table tbody tr,
        body.dark-mode table tbody tr {
        background: #0f172a !important;
        }

        body.dark-mode .table tbody td,
        body.dark-mode table tbody td {
        background: #0f172a !important;
        color: #f8fafc !important;
        border-color: #334155 !important;
        }

        /* HOVER */

        body.dark-mode .table-hover tbody tr:hover {
        background: #1e293b !important;
        }

        /* ////////////////////////////////////////////////////// */
        /* CARDS */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode .card,
        body.dark-mode .card-box {
        background: #1e293b !important;
        color: white !important;
        border: 1px solid #334155 !important;
        }

        /* ////////////////////////////////////////////////////// */
        /* MODALS */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode .modal-content {
        background: #1e293b !important;
        color: white !important;
        }

        body.dark-mode .modal-header,
        body.dark-mode .modal-footer {
        border-color: #334155 !important;
        }

        /* ////////////////////////////////////////////////////// */
        /* INPUTS */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode .form-control,
        body.dark-mode textarea,
        body.dark-mode select {
        background: #0f172a !important;
        color: white !important;
        border: 1px solid #334155 !important;
        }

        body.dark-mode .form-control:focus {
        background: #0f172a !important;
        color: white !important;
        border-color: #3b82f6 !important;
        box-shadow: none !important;
        }

        /* ////////////////////////////////////////////////////// */
        /* PLACEHOLDER */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode input::placeholder,
        body.dark-mode textarea::placeholder {
        color: #94a3b8 !important;
        }

        /* ////////////////////////////////////////////////////// */
        /* BOTON CERRAR */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode .btn-close {
        filter: invert(1);
        }

        /* ////////////////////////////////////////////////////// */
        /* HOME DASHBOARD DARK MODE */
        /* ////////////////////////////////////////////////////// */

        body.dark-mode .dashboard-card,
        body.dark-mode .chart-card,
        body.dark-mode .status-box {
        background: #1e293b !important;
        color: white !important;
        border: 1px solid #334155 !important;
        }

        /* TEXTOS */

        body.dark-mode .dashboard-card p,
        body.dark-mode .dashboard-card h2,
        body.dark-mode .dashboard-card h5,
        body.dark-mode .chart-card h5,
        body.dark-mode .status-box h5,
        body.dark-mode .status-item span {
        color: white !important;
        }

        /* SUBTEXTOS */

        body.dark-mode .dashboard-subtitle,
        body.dark-mode .mini-text {
        color: #94a3b8 !important;
        }

        /* STATUS ITEM */

        body.dark-mode .status-item {
        border-bottom: 1px solid #334155 !important;
        }

        /* GRAFICA */

        body.dark-mode canvas {
        background: transparent !important;
        }

        /* CHART LABELS */

        body.dark-mode .chart-card {
        color: white !important;
        }

        /* CARDS HOVER */

        body.dark-mode .dashboard-card:hover {
        box-shadow: 0 10px 30px rgba(0,0,0,0.45) !important;
        }

        .sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        background: white;
        padding: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.05);
        transition: 0.3s;
        }

        .sidebar.collapsed {
        width: 80px;
        }

        .sidebar.collapsed span,
        .sidebar.collapsed h4 {
        display: none;
        }

        .menu a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        margin: 8px 0;
        border-radius: 10px;
        text-decoration: none;
        color: #555;
        }

        .menu a.active {
        background: #eef2ff;
        border: 1px solid #3b6df6;
        color: #3b6df6;
        }

        .main {
        margin-left: 260px;
        padding: 30px;
        transition: 0.3s;
        }

        .main.expanded {
        margin-left: 90px;
        }

        .toggle-btn {
        cursor: pointer;
        font-size: 20px;
        margin-bottom: 20px;
        }

        .card-box {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        /* //////////////////////////////////////////////////////
        FIX SIDEBAR
        ////////////////////////////////////////////////////// */

        .sidebar {
        display: flex;
        flex-direction: column;
        }

        .menu {
        flex: 1;
        }

        .user-box {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid #eee;
        }

        .user-name {
        font-weight: bold;
        margin-bottom: 3px;
        }

        .user-user {
        font-size: 12px;
        color: #777;
        margin-bottom: 10px;
        }

        .logout-link {
        color: red;
        text-decoration: none;
        font-size: 14px;
        }

        /* //////////////////////////////////////////////////////
        SIDEBAR COLAPSADO
        ////////////////////////////////////////////////////// */

        .sidebar.collapsed .user-name,
        .sidebar.collapsed .user-user,
        .sidebar.collapsed h4 span {
        display: none;
        }

        .sidebar.collapsed .menu a {
        justify-content: center;
        }

        .sidebar.collapsed .menu a span {
        display: none;
        }

        .sidebar.collapsed .user-box {
        text-align: center;
        }

        .sidebar.collapsed .toggle-btn {
        text-align: center;
        }

        /* //////////////////////////////////////////////////////
        LOGOUT
        ////////////////////////////////////////////////////// */

        .logout-link {
        color: red;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .logout-icon {
        font-size: 18px;
        }

        .sidebar.collapsed .logout-link {
        justify-content: center;
        }

        .sidebar.collapsed .logout-text {
        display: none;
        }

    </style>
</head>

<body>

    @{
        var rol = Context.Session.GetString("rol");
        var usuario = Context.Session.GetString("usuario");
        var nombre = Context.Session.GetString("nombre");
    }

    <div id="sidebar" class="sidebar">

        <div class="toggle-btn" onclick="toggleSidebar()">☰</div>
        

        <h4 style="text-align:center;">

            <img src="~/img/loo.png"
                 width="100"
                 height="50" />

            <br />

            <span>Wachtmaker</span>

        </h4>
        <div class="toggle-btn"
             onclick="toggleDarkMode()"
             id="darkModeBtn">

            🌙

        </div>

        <div class="menu mt-4">

            <!-- 🔥 ADMIN -->
            @if (rol == "ADMIN")
            {
                <a href="/Home" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    🏠 <span>Dashboard</span>
                </a>

                <a href="/Cliente" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active" : "")">
                    👤 <span>Clientes</span>
                </a>

                <a href="/Producto" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")">
                    📦 <span>Productos</span>
                </a>

                <a href="/Facturacion" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")">
                    🧾 <span>Facturas</span>
                </a>

                @if (usuario == "admin")
                {
                    <a href="/Usuario"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuario" ? "active" : "")">

                        👨‍💼 <span>Usuarios</span>

                    </a>
                }

            }

            <!-- 🔥 EMPLEADO -->
            @if (rol == "EMPLEADO")
            {
                <a href="/Cliente" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active" : "")">
                    👤 <span>Clientes</span>
                </a>

                <a href="/Producto" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")">
                    📦 <span>Productos</span>
                </a>

                <a href="/Facturacion" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")">
                    🧾 <span>Facturación</span>
                </a>
            }

        </div>

        <!-- 🔥 USUARIO -->
        <div class="user-box">

            <div class="user-name">
                @(nombre ?? "Invitado")
            </div>

            <div class="user-user">
                @(usuario ?? "")
            </div>

            <a href="/Login/Logout"
                   class="logout-link">

                <span class="logout-icon">🚪</span>

                <span class="logout-text">
                    Cerrar sesión
                </span>

            </a>

        </div>

    </div>

    <div id="main" class="main">
        @RenderBody()
    </div>

    <script>
        function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("collapsed");
        document.getElementById("main").classList.toggle("expanded");
        }

        //////////////////////////////////////////////////////
        // DARK MODE
        //////////////////////////////////////////////////////

        function toggleDarkMode() {

        document.body.classList.toggle("dark-mode");

        //////////////////////////////////////////////////////
        // GUARDAR
        //////////////////////////////////////////////////////

        let dark =
        document.body.classList.contains("dark-mode");

        localStorage.setItem("darkMode", dark);

        //////////////////////////////////////////////////////
        // ICONO
        //////////////////////////////////////////////////////

        actualizarIconoDark();
        }

        //////////////////////////////////////////////////////
        // ICONO
        //////////////////////////////////////////////////////

        function actualizarIconoDark() {

        let btn =
        document.getElementById("darkModeBtn");

        if (document.body.classList.contains("dark-mode"))
        {
        btn.innerHTML = "☀️";
        }
        else
        {
        btn.innerHTML = "🌙";
        }
        }

        //////////////////////////////////////////////////////
        // CARGAR
        //////////////////////////////////////////////////////

        window.onload = function () {

        let dark =
        localStorage.getItem("darkMode");

        if (dark === "true")
        {
        document.body.classList.add("dark-mode");
        }

        actualizarIconoDark();
        };


    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>