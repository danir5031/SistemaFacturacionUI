@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="" />

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>

        body {
        margin: 0;
        font-family: 'Segoe UI';
        background: #f5f6fa;
        overflow-x: hidden;
        }

        /* //////////////////////////////////////////////////////
        DARK MODE
        ////////////////////////////////////////////////////// */

        body.dark-mode {
        background: #020617;
        color: white;
        }

        body.dark-mode .sidebar {
        background: #0f172a;
        border-right: 1px solid #1e293b;
        }

        body.dark-mode .card-box,
        body.dark-mode .card {
        background: #1e293b !important;
        color: white !important;
        border: 1px solid #334155 !important;
        }

        body.dark-mode .modal-content {
        background: #1e293b !important;
        color: white !important;
        }

        body.dark-mode .table,
        body.dark-mode table {
        background: #0f172a !important;
        color: white !important;
        }

        body.dark-mode .table thead th {
        background: #1e293b !important;
        color: white !important;
        border-color: #334155 !important;
        }

        body.dark-mode .table tbody td {
        background: #0f172a !important;
        color: white !important;
        border-color: #334155 !important;
        }

        body.dark-mode .form-control,
        body.dark-mode textarea,
        body.dark-mode select {
        background: #020617 !important;
        color: white !important;
        border: 1px solid #334155 !important;
        }

        body.dark-mode .form-control:focus {
        background: #020617 !important;
        color: white !important;
        border-color: #2563eb !important;
        box-shadow: none !important;
        }

        body.dark-mode input::placeholder,
        body.dark-mode textarea::placeholder {
        color: #94a3b8 !important;
        }

        body.dark-mode .menu a {
        color: #e5e7eb;
        }

        body.dark-mode .menu a.active {
        background: #1e293b;
        border: 1px solid #2563eb;
        color: #60a5fa;
        }

        /* //////////////////////////////////////////////////////
        SIDEBAR
        ////////////////////////////////////////////////////// */

        .sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        background: white;
        padding: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        transition: .3s;
        box-shadow: 0 0 15px rgba(0,0,0,.05);
        overflow-y: auto;
        overflow-x: hidden;
        }

        .menu {
        flex: 1;
        margin-top: 20px;
        }

        .menu a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 12px;
        text-decoration: none;
        color: #555;
        transition: .2s;
        }

        .menu a:hover {
        background: #f1f5f9;
        }

        .menu a.active {
        background: #eef2ff;
        border: 1px solid #2563eb;
        color: #2563eb;
        }

        /* //////////////////////////////////////////////////////
        USER BOX
        ////////////////////////////////////////////////////// */

        .user-box {
        margin-top: auto;
        border-top: 1px solid #e5e7eb;
        padding-top: 15px;
        }

        .user-name {
        font-weight: bold;
        }

        .user-user {
        color: #777;
        font-size: 13px;
        margin-bottom: 10px;
        }

        .logout-link {
        text-decoration: none;
        color: red;
        display: flex;
        align-items: center;
        gap: 8px;
        }

        /* //////////////////////////////////////////////////////
        MAIN
        ////////////////////////////////////////////////////// */

        .main {
        margin-left: 250px;
        padding: 30px;
        transition: .3s;
        }

        /* //////////////////////////////////////////////////////
        CARDS
        ////////////////////////////////////////////////////// */

        .card-box {
        background: white;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
        }

        /* //////////////////////////////////////////////////////
        FACTURA BADGE
        ////////////////////////////////////////////////////// */

        .factura-badge {
        background: #1e293b;
        color: white;
        padding: 6px 10px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
        }

        /* //////////////////////////////////////////////////////
        TABLES
        ////////////////////////////////////////////////////// */

        .table-responsive {
        width: 100%;
        overflow-x: auto;
        }

        table {
        width: 100%;
        }

        /* //////////////////////////////////////////////////////
        MOBILE MENU BUTTON
        ////////////////////////////////////////////////////// */

        .mobile-menu-btn {
        background: white;
        color: #111827;
        box-shadow: 0 5px 15px rgba(0,0,0,.15);
        }

        .hide-btn {
        opacity: 0 !important;
        pointer-events: none !important;
        transform: scale(.8);
        }

        body.dark-mode .mobile-menu-btn {
        background: #2563eb;
        color: white;
        }

        /* //////////////////////////////////////////////////////
        OVERLAY
        ////////////////////////////////////////////////////// */

        #overlay {
        display: none;
        }

        /* //////////////////////////////////////////////////////
        MOBILE
        ////////////////////////////////////////////////////// */

        @@media(max-width:768px) {

        body {
        overflow-x: hidden;
        }
        /* SIDEBAR */

        .sidebar {
        left: -260px;
        width: 260px;
        background: #0f172a;
        }

        .sidebar.active {
        left: 0;
        }
        /* OVERLAY */

        #overlay.active {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.6);
        z-index: 9998;
        }
        /* MAIN */

        .main {
        margin-left: 0 !important;
        width: 100% !important;
        padding: 80px 15px 20px 15px !important;
        }
        /* MENU BUTTON */

        .mobile-menu-btn {
        display: flex !important;
        align-items: center;
        justify-content: center;
        position: fixed;
        top: 15px;
        left: 15px;
        z-index: 10000;
        width: 50px;
        height: 50px;
        border: none;
        border-radius: 14px;
        background: #2563eb;
        color: white;
        font-size: 24px;
        }
        /* TITLES */

        h1, h2, h3, h4 {
        font-size: 30px !important;
        }
        /* FLEX FIX */

        .d-flex {
        flex-wrap: wrap !important;
        }
        /* HEADER BUTTONS */

        .d-flex.justify-content-between {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 15px;
        }
        /* BUTTONS */

        .btn {
        width: 100% !important;
        }
        /* ROWS */

        .row {
        margin: 0 !important;
        }

        .col,
        .col-md-3,
        .col-md-4,
        .col-md-6,
        .col-md-8,
        .col-lg-3,
        .col-lg-4 {
        width: 100% !important;
        max-width: 100% !important;
        flex: 0 0 100% !important;
        }
        /* FILTERS */

        .d-flex.flex-wrap.gap-2 {
        display: flex !important;
        flex-direction: column !important;
        gap: 15px !important;
        }

        .d-flex.flex-wrap.gap-2 > div {
        width: 100% !important;
        min-width: 100% !important;
        }
        /* INNER FLEX */

        .d-flex.gap-2 {
        flex-direction: column !important;
        }
        /* INPUTS */

        input,
        select,
        textarea {
        width: 100% !important;
        }
        /* DATE FIX */

        input[type="date"] {
        width: 100% !important;
        }
        /* TABLE */

        table {
        min-width: 700px !important;
        }
        /* CARD */

        .card-box {
        width: 100% !important;
        overflow: hidden;
        padding: 15px;
        }
        /* PRODUCTOS */

        #tablaProductosFactura img {
        width: 40px !important;
        height: 40px !important;
        object-fit: cover;
        }
        /* ACTION BUTTONS */

        .top-buttons,
        .acciones-superiores,
        .acciones-botones,
        .btn-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
        }
        /* MODALS */

        .modal-dialog {
        margin: 10px;
        }

        .modal-content {
        border-radius: 20px;
        }
        }

        .mini-resumen-card small {
        color: #94a3b8 !important;
        font-size: 11px;
        }

        .mini-resumen-card b {
        color: inherit !important;
        font-size: 16px;
        }

        body.dark-mode .mini-resumen-card {
        background: #1e293b !important;
        border: 1px solid #334155;
        }

        body.dark-mode .mini-resumen-card b {
        color: #f8fafc !important;
        }


        /* //////////////////////////////////////////////////////
        SCROLLBAR
        ////////////////////////////////////////////////////// */

        ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
        }

        ::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 20px;
        }


        @@media(max - width:768px) {

        .modal {
        padding: 15px !important;
        }

        .modal-dialog {
        margin: auto !important;
        display: flex;
        align-items: center;
        min-height: 100vh;
        }

        .modal-content {
        width: 100%;
        border-radius: 20px;
        }
        }

        .dashboard-card h2,
        .dashboard-card h3 {
        word-break: break-word;
        font-size: 28px !important;
        }

        @@media(max - width:768px) {

        h1 {
        font-size: 24px !important;
        }

        p {
        font-size: 15px !important;
        }
        }

            /* ==========================================
               CANCELACIONES
               ========================================== */

            .cancelaciones-cards {
                margin-left: 0;
                margin-right: 0;
            }

            .cancelacion-card {
                border-radius: 10px;
                overflow: hidden;
            }

                .cancelacion-card .card-body {
                    padding: 20px;
                }

                .cancelacion-card h6 {
                    color: #344054;
                    font-weight: 500;
                    margin-bottom: 10px;
                }

                .cancelacion-card h2 {
                    color: #111827;
                    margin-bottom: 8px;
                }

                .cancelacion-card small {
                    color: #667085;
                }


            /* ==========================================
               MODO OSCURO
               ========================================== */

            body.dark-mode .cancelacion-card,
            .dark-mode .cancelacion-card {
                background-color: #1e293b !important;
                border: 1px solid #334155 !important;
            }

                body.dark-mode .cancelacion-card h6,
                .dark-mode .cancelacion-card h6 {
                    color: #e2e8f0 !important;
                }

                body.dark-mode .cancelacion-card h2,
                .dark-mode .cancelacion-card h2 {
                    color: #ffffff !important;
                }

                body.dark-mode .cancelacion-card small,
                .dark-mode .cancelacion-card small {
                    color: #cbd5e1 !important;
                }


            /* ==========================================
               TABLA DE CANCELACIONES EN MODO OSCURO
               ========================================== */

            body.dark-mode .cancelaciones-table,
            .dark-mode .cancelaciones-table {
                color: #ffffff;
            }

                body.dark-mode .cancelaciones-table th,
                .dark-mode .cancelaciones-table th {
                    color: #ffffff !important;
                }

                body.dark-mode .cancelaciones-table td,
                .dark-mode .cancelaciones-table td {
                    color: #e2e8f0 !important;
                }


            /* ==========================================
               TELÉFONO
               ========================================== */

            @@media (max-width: 767px) {

                .cancelaciones-cards {
                    row-gap: 16px !important;
                }

                .cancelacion-card {
                    margin-bottom: 0 !important;
                }

                    .cancelacion-card .card-body {
                        padding: 18px;
                    }

                    .cancelacion-card h2 {
                        font-size: 30px;
                    }
            }


            /* =========================================
   BUSCADOR DE MUNICIPIOS - MODO OSCURO
   ========================================= */

/* Caja principal */
.choices {
    width: 100%;
}

/* Campo seleccionado */
.choices__inner {
    background-color: #020617 !important;
    border: 1px solid #334155 !important;
    color: #ffffff !important;
    min-height: 40px;
    border-radius: 6px !important;
}

/* Texto dentro del campo */
.choices__inner .choices__item {
    color: #ffffff !important;
}

/* MENÚ DESPLEGABLE */
.choices__list--dropdown,
.choices__list[aria-expanded="true"] {
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    color: #1e293b !important;
    z-index: 9999 !important;
}

/* Campo de búsqueda */
.choices__list--dropdown .choices__input {
    background-color: #ffffff !important;
    color: #111827 !important;
    border: 1px solid #94a3b8 !important;
}

/* Placeholder del buscador */
.choices__list--dropdown .choices__input::placeholder {
    color: #64748b !important;
}

/* Opciones */
.choices__list--dropdown .choices__item {
    background-color: #ffffff !important;
    color: #1e293b !important;
}

/* Cuando pasas el mouse */
.choices__list--dropdown .choices__item--selectable.is-highlighted {
    background-color: #3b82f6 !important;
    color: #ffffff !important;
}

/* Opción seleccionada */
.choices__list--dropdown .choices__item--choice.is-selected {
    background-color: #e2e8f0 !important;
    color: #0f172a !important;
}

/* Flecha */
.choices[data-type*="select-one"]::after {
    border-color: #94a3b8 transparent transparent transparent !important;
}

.choices[data-type*="select-one"].is-open::after {
    border-color: transparent transparent #94a3b8 transparent !important;
}

    </style>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>

<body>

    @{
        var rol = Context.Session.GetString("rol");
        var usuario = Context.Session.GetString("usuario");
        var nombre = Context.Session.GetString("nombre");
    }

    <button class="mobile-menu-btn"
            onclick="toggleSidebar()">
        ☰
    </button>

    <div id="overlay" class="overlay"
         onclick="toggleSidebar()">
    </div>
    <div id="sidebar" class="sidebar">

        
        

        <h4 style="text-align:center;">

            <!--<img src="~/img/loo.png"
                 width="100"
                 height="50" />-->
            <img src="~/img/tao2.png"
                 width="100"
                 height="80" />

            <br />

            <!--<span>TAO</span>-->

        </h4>
        <div class="toggle-btn"
             onclick="toggleDarkMode()"
             id="darkModeBtn">

            🌙

        </div>

        <div class="menu mt-4">

            <!-- 🔥 ADMIN -->
            @if (rol == "ADMIN")
            {
                <a href="/Home" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    🏠 <span>Dashboard</span>
                </a>

                <a href="/Cliente" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active" : "")">
                    👤 <span>Clientes</span>
                </a>

                <a href="/Producto" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")">
                    📦 <span>Productos</span>
                </a>

                <a href="/Facturacion" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")">
                    🧾 <span>Facturas</span>
                </a>

                @if (usuario == "admin")
                {
                    <a href="/Usuario"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuario" ? "active" : "")">

                        👨‍💼 <span>Usuarios</span>

                    </a>
                }

            }

            <!-- 🔥 EMPLEADO -->
            @if (rol == "EMPLEADO")
            {
                <a href="/Cliente" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active" : "")">
                    👤 <span>Clientes</span>
                </a>

                <a href="/Producto" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")">
                    📦 <span>Productos</span>
                </a>

                <a href="/Facturacion" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")">
                    🧾 <span>Facturación</span>
                </a>
            }

        </div>

        <!-- 🔥 USUARIO -->
        <div class="user-box">

            <div class="user-name">
                @(nombre ?? "Invitado")
            </div>

            <div class="user-user">
                @(usuario ?? "")
            </div>

            <a href="/Login/Logout"
                   class="logout-link">

                <span class="logout-icon">🚪</span>

                <span class="logout-text">
                    Cerrar sesión
                </span>

            </a>

        </div>

    </div>

    <div id="main" class="main">
        @RenderBody()
    </div>

    <script>
        
        //////////////////////////////////////////////////////
        // DARK MODE
        //////////////////////////////////////////////////////

        function toggleDarkMode() {

        document.body.classList.toggle("dark-mode");

        //////////////////////////////////////////////////////
        // GUARDAR
        //////////////////////////////////////////////////////

        let dark =
        document.body.classList.contains("dark-mode");

        localStorage.setItem(
        "darkMode_@(usuario)",
        dark
        );

        //////////////////////////////////////////////////////
        // ICONO
        //////////////////////////////////////////////////////

        actualizarIconoDark();
        }

        //////////////////////////////////////////////////////
        // ICONO
        //////////////////////////////////////////////////////

        function actualizarIconoDark() {

        let btn =
        document.getElementById("darkModeBtn");

        if (document.body.classList.contains("dark-mode"))
        {
        btn.innerHTML = "☀️";
        }
        else
        {
        btn.innerHTML = "🌙";
        }
        }

        //////////////////////////////////////////////////////
        // CARGAR
        //////////////////////////////////////////////////////

        window.onload = function () {

        let dark =
        localStorage.getItem("darkMode_@(usuario)");

        if (dark === "true")
        {
        document.body.classList.add("dark-mode");
        }

        actualizarIconoDark();
        };


    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>

        function toggleSidebar(){

        const sidebar =
        document.getElementById("sidebar");

        const overlay =
        document.getElementById("overlay");

        const btn =
        document.querySelector(".mobile-menu-btn");

        //////////////////////////////////////////////////////
        // ABRIR / CERRAR
        //////////////////////////////////////////////////////

        sidebar.classList.toggle("active");
        overlay.classList.toggle("active");

        //////////////////////////////////////////////////////
        // BOTON MENU
        //////////////////////////////////////////////////////

        if(sidebar.classList.contains("active")){

        btn.classList.add("hide-btn");
        }
        else{

        btn.classList.remove("hide-btn");
        }
        }

        //////////////////////////////////////////////////////////
        // CERRAR AL TOCAR OVERLAY
        //////////////////////////////////////////////////////////

        document.getElementById("overlay")
        .addEventListener("click", function(){

        toggleSidebar();
        });


        let ultimoMovimiento = Date.now();

        document.addEventListener("mousemove", actualizarActividad);
        document.addEventListener("keydown", actualizarActividad);
        document.addEventListener("click", actualizarActividad);
        document.addEventListener("scroll", actualizarActividad);

        function actualizarActividad() {

        ultimoMovimiento = Date.now();

        }

        setInterval(() => {

        const minutosSinActividad =
        (Date.now() - ultimoMovimiento) / 1000 / 60;

        // Si el usuario estuvo activo durante
        // los últimos 5 minutos

        if (minutosSinActividad < 5) {

        fetch("/Login/KeepAlive", {

        method: "POST"

        });

        }

        }, 300000);

    </script>

</body>
</html>