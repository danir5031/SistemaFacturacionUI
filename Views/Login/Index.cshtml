@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <title>Login</title>
    <link rel="icon" type="image/png" href="~/img/WMK.png" />

    <!-- TAILWIND -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- ICONOS -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>

        .bg-space {
        background: radial-gradient(circle at center, #111827 0%, #030712 100%);
        }

        @@keyframes shooting-star {
        0% {
        transform: rotate(-45deg) translateX(0);
        opacity: 0;
        }

        10% {
        opacity: 1;
        }

        90% {
        opacity: 1;
        }

        100% {
        transform: rotate(-45deg) translateX(-1500px);
        opacity: 0;
        }
        }

        .shooting-star {
        position: absolute;
        height: 2px;
        background: linear-gradient(90deg,#fff,transparent);
        filter: drop-shadow(0 0 8px #6366f1);
        animation: shooting-star linear infinite;
        opacity: 0;
        }

        .shooting-star::after {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 4px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 0 15px #fff, 0 0 30px #6366f1;
        }

        @@keyframes twinkling {
        0%, 100% {
        opacity: .3;
        transform: scale(1);
        }

        50% {
        opacity: 1;
        transform: scale(1.2);
        }
        }

        .animate-twinkle {
        animation: twinkling 3s infinite;
        }

        .animate-twinkle-slow {
        animation: twinkling 5s infinite 1s;
        }

        .animate-twinkle-mid {
        animation: twinkling 4s infinite .5s;
        }

        /* BOTON LOGIN */

        .login-btn {
        position: relative;
        width: 100%;
        height: 64px;
        border: none;
        border-radius: 22px;
        background: #111111;
        overflow: hidden;
        cursor: pointer;
        font-weight: 700;
        font-size: 20px;
        color: white;
        transition: .3s ease;
        }

        /* TEXTO */

        .login-btn .text {
        position: relative;
        z-index: 5;
        letter-spacing: .5px;
        }

        /* CIRCULOS */

        .login-btn .circle {
        position: absolute;
        width: 40px;
        height: 40px;
        background: #312e81;
        border-radius: 50%;
        transition: 1.2s ease;
        z-index: 1;
        }

        /* POSICIONES INICIALES */

        .login-btn .circle1 {
        top: 50%;
        left: -40px;
        transform: translateY(-50%);
        }

        .login-btn .circle2 {
        top: 50%;
        right: -40px;
        transform: translateY(-50%);
        }

        /* HOVER */

        .login-btn:hover .circle1 {
        transform: translateY(-50%) scale(18);
        }

        .login-btn:hover .circle2 {
        transform: translateY(-50%) scale(18);
        }

        /* GLOW */

        .login-btn:hover {
        box-shadow: 0 0 20px rgba(49,46,129,.7), 0 0 50px rgba(49,46,129,.4);
        }

    </style>

</head>
<body class="overflow-hidden">

    <!-- FONDO -->
    <div class="fixed inset-0 bg-[#030712] overflow-hidden">

        <!-- GRADIENTE -->
        <div class="absolute inset-0
            bg-[radial-gradient(circle_at_center,_#111827_0%,_#030712_70%)]">
        </div>

        <!-- ESTRELLAS -->
        <div class="absolute inset-0">

            <div class="absolute top-10 left-20 w-1 h-1 bg-white rounded-full animate-twinkle"></div>

            <div class="absolute top-40 left-1/2 w-1 h-1 bg-white rounded-full animate-twinkle-slow"></div>

            <div class="absolute bottom-20 right-1/4 w-1 h-1 bg-white rounded-full animate-twinkle-mid"></div>

            <div class="absolute top-3/4 left-10 w-1 h-1 bg-white rounded-full animate-twinkle"></div>

            <div class="absolute top-1/4 right-20 w-1 h-1 bg-white rounded-full animate-twinkle-slow"></div>

            <div class="absolute top-1/3 left-1/4 w-1 h-1 bg-white rounded-full animate-twinkle-mid"></div>

            <div class="absolute bottom-1/3 left-1/2 w-1 h-1 bg-white rounded-full animate-twinkle"></div>

        </div>

        <!-- ESTRELLAS FUGACES -->
        <div class="absolute inset-0">

            <div class="shooting-star w-[150px]"
                 style="top:0;right:0;animation-duration:4s;animation-delay:1s;">
            </div>

            <div class="shooting-star w-[200px]"
                 style="top:20%;right:-10%;animation-duration:6s;animation-delay:3s;">
            </div>

            <div class="shooting-star w-[120px]"
                 style="top:40%;right:10%;animation-duration:3s;animation-delay:0s;">
            </div>

        </div>

        <!-- CONTENIDO -->
        <div class="relative z-10
            min-h-screen
            flex
            items-center
            justify-center
            p-4">

            <!-- CARD -->
            <div class="w-full
                max-w-md
                rounded-[35px]
                border
                border-white/10
                bg-white/10
                backdrop-blur-2xl
                shadow-[0_0_60px_rgba(99,102,241,0.35)]
                p-10">

                <!-- LOGO -->
                <div class="text-center mb-8">

                    <div class="w-24
                        h-24
                        mx-auto
                        rounded-3xl
                        bg-[#030712]
                        border
                        border-white/10
                        flex
                        items-center
                        justify-center
                        mb-5">

                        <!-- <img src="~/img/WMK.png"
                             class="w-12 h-12 object-contain" />-->

                        <img src="~/img/tao1.png"
                             class="w-12 h-12 object-contain" />


                    </div>

                    <!--
                    <h1 class="text-4xl
                        font-black
                        text-white
                        tracking-tight">

                        TAO

                    </h1>-->

                    <p class="text-gray-300
                        mt-2
                        tracking-[5px]
                        text-sm">

                        INICIAR SESIÓN

                    </p>

                </div>

                <!-- FORM -->
                <form method="post"
                      action="/Login/Index"
                      class="space-y-5">

                    <!-- USUARIO -->
                    <input name="user"
                           type="text"
                           placeholder="Ingresa tu usuario"
                           autocomplete="off"
                           class="w-full
                    rounded-2xl
                    bg-[#0f172a]
                    border
                    border-white/10
                    px-5
                    py-4
                    text-white
                    placeholder-white/60
                    focus:outline-none
                    focus:ring-2
                    focus:ring-indigo-500
                    focus:border-indigo-500
                    transition" />

                    <!-- PASSWORD -->
                    <input name="password"
                           type="password"
                           placeholder="Ingresa tu contraseña"
                           autocomplete="off"
                           class="w-full
                    rounded-2xl
                    bg-[#0f172a]
                    border
                    border-white/10
                    px-5
                    py-4
                    text-white
                    placeholder-white/60
                    focus:outline-none
                    focus:ring-2
                    focus:ring-indigo-500
                    focus:border-indigo-500
                    transition" />

                    <!-- ERROR -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="text-red-400 text-center text-sm">
                            @ViewBag.Error
                        </div>
                    }

                    <!-- BOTON -->
                    <button type="submit" class="login-btn">

                        <span class="circle circle1"></span>

                        <span class="circle circle2"></span>

                        <span class="text">
                            Entrar al sistema
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </div>

</body>

</html>