@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Panel Empleado";
}

<h3>Panel de Empleado</h3>
<p class="text-muted">Acceso rápido a productos y facturación.</p>

<div class="row mt-4">

    <div class="col-md-6">
        <div class="card-box text-center">
            <h4>📦 Productos</h4>
            <a href="/Productos" class="btn btn-primary mt-2">Ir a Productos</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card-box text-center">
            <h4>🧾 Facturación</h4>
            <a href="/Facturacion" class="btn btn-success mt-2">Ir a Facturación</a>
        </div>
    </div>

</div>
