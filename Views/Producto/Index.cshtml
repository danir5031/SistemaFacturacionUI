@model List<SistemaFacturacionUI.Models.Producto>
@using Microsoft.AspNetCore.Http

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rol = (Context.Session.GetString("rol") ?? "").ToUpper();
}

<style>
.img-producto{
    width:60px;
    height:60px;
    object-fit:cover;
    border-radius:10px;
    cursor:pointer;
    transition:0.3s;
}
.img-producto:hover{
    transform:scale(1.6);
}
</style>

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h3>Productos</h3>
        <p class="text-muted">Inventario y catálogo de productos.</p>
    </div>

    @if (rol == "ADMIN")
    {
        <div>
            <button class="btn btn-primary" onclick="abrirModal()">+ Nuevo Producto</button>

            <a href="/Producto/Eliminados" class="btn btn-outline-danger">
                🗑️ Eliminados
            </a>
        </div>
    }
</div>

<div class="card-box mt-3">

    <!-- 🔥 FILTROS -->
    <div class="row mb-3">

        <div class="col-md-4">
            <input id="buscador" value="@ViewBag.Buscar" class="form-control"
                   placeholder="Buscar por nombre o categoría..."
                   onkeyup="filtrarConDelay()"  />
        </div>

        <div class="col-md-2">
            <select id="filtroCategoria" class="form-control" onchange="filtrarServidor()">
                <option value="">Categoría</option>
                @foreach (var cat in ViewBag.Categorias)
                {
                    <option value="@cat"
                            selected="@(ViewBag.Categoria == cat ? "selected" : null)">

                        @cat

                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <select id="filtroStock"
                    class="form-control"
                    onchange="filtrarServidor()">

                <option value="">Stock</option>

                <option value="bajo"
                        selected="@(ViewBag.Stock == "bajo" ? "selected" : null)">
                    Bajo (&lt;5)
                </option>

                <option value="medio"
                        selected="@(ViewBag.Stock == "medio" ? "selected" : null)">
                    Medio (5-20)
                </option>

                <option value="alto"
                        selected="@(ViewBag.Stock == "alto" ? "selected" : null)">
                    Alto (&gt;20)
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <select id="filtroEstado"
                    class="form-control"
                    onchange="filtrarServidor()">

                <option value="">Estado</option>

                <option value="true"
                        selected="@(ViewBag.Estado == "true" ? "selected" : null)">
                    Disponible
                </option>

                <option value="false"
                        selected="@(ViewBag.Estado == "false" ? "selected" : null)">
                    No disponible
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <input type="date"
                   id="filtroFecha"
                   class="form-control"
                   value="@ViewBag.Fecha"
                   onchange="filtrarServidor()" />
        </div>

    </div>
    <div class="table-responsive">
        <table class="table align-middle">

            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Stock</th>
                    <th>Precio</th>
                    <th>Estado</th>

                    @if (rol == "ADMIN")
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    if(item.Activo) // 🔥 SOLO ACTIVOS
                    {
                        <tr data-nombre="@item.Nombre.ToLower()"
                            data-categoria="@item.Categoria.ToLower()"
                            data-stock="@item.Stock"
                            data-estado="@item.Disponible.ToString().ToLower()"
                            data-fecha="@item.FechaRegistro.ToString("yyyy-MM-dd")">
                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    @if (item.Imagen != null)
                                    {
                                        <img src="/Producto/VerImagen/@item.IdProducto"
                                             class="img-producto"
                                             onclick="verImagen(this.src)" />
                                    }
                                    else if (!string.IsNullOrEmpty(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl"
                                             class="img-producto"
                                             onclick="verImagen(this.src)" />
                                    }
                                    else
                                    {
                                        <img src="https://via.placeholder.com/70"
                                             class="img-producto" />
                                    }

                                    <div>

                                        <b>@item.Nombre</b><br />

                                        <small>@item.Categoria</small>

                                        @if (item.Variantes != null && item.Variantes.Any())
                                        {
                                            <br />

                                            <small style="color:#8fa8d6;">

                                                Variantes:

                                                @string.Join(", ",
                                                    item.Variantes
                                                    .Where(v => v.Activo)
                                                    .Select(v => v.NombreVariante)
                                                )

                                            </small>
                                        }

                                    </div>
                                </div>
                            </td>

                            <td>
                                @{
                                    string color = "bg-success";

                                    if (item.Stock < 10)
                                        color = "bg-danger";
                                    else if (item.Stock <= 20)
                                        color = "bg-warning";
                                }

                                <span class="badge @color">
                                    @item.Stock unid.
                                </span>
                            </td>

                            <td>
                                <b>$@item.PrecioVenta</b><br />
                                <small>Costo: $@item.Costo</small><br />

                                @{
                                    decimal margen = 0;
                                    decimal markup = 0;

                                    // 🔥 MARGEN (correcto)
                                    if (item.PrecioVenta > 0)
                                    {
                                        margen = ((item.PrecioVenta - item.Costo) / item.PrecioVenta) * 100;
                                    }

                                    // 🔥 MARKUP (limitado a 100%)
                                    if (item.Costo > 0)
                                    {
                                        markup = ((item.PrecioVenta - item.Costo) / item.Costo) * 100;

                                        if (markup > 100)
                                        {
                                            markup = 100;
                                        }
                                    }
                                    string colorMargen = "green";

                                    if (margen < 30)
                                        colorMargen = "red";
                                    else if (margen <= 60)
                                        colorMargen = "orange";
                                }

                            
                                <small style="color:@colorMargen; font-weight:bold;">
                                    Margen: @Math.Round(margen, 1)%
                            
                                </small><br />

                                <small style="color:#6c757d;">
                                    Markup: @Math.Round(markup, 1)%
                                </small>
                            </td>

                            <td>
                                <span class="badge @(item.Disponible ? "bg-success" : "bg-danger")">
                                    @(item.Disponible ? "Disponible" : "No disponible")
                                </span>
                            </td>

                            @if (rol == "ADMIN")
                            {
                                <td>
                                    <button class="btn btn-warning btn-sm"
                                            onclick="editar(@item.IdProducto)">
                                        ✏️
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            onclick="eliminar(@item.IdProducto)">
                                        🗑️
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            <!-- PAGINACION -->
            <!-- PAGINACION -->
            @if (ViewBag.TotalPaginas > 1)
            {
                <div class="d-flex justify-content-center mt-4">

                    <nav>

                        <ul class="pagination">

                            <!-- ANTERIOR -->
                            @if (ViewBag.PaginaActual > 1)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                           href="/Producto?pagina=@(ViewBag.PaginaActual - 1)&buscar=@ViewBag.Buscar&categoria=@ViewBag.Categoria&stock=@ViewBag.Stock&estado=@ViewBag.Estado&fecha=@ViewBag.Fecha">

                                        Anterior

                                    </a>

                                </li>
                            }

                            <!-- PAGINAS -->
                            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                                    <a class="page-link"
                                           href="/Producto?pagina=@i&buscar=@ViewBag.Buscar&categoria=@ViewBag.Categoria&stock=@ViewBag.Stock&estado=@ViewBag.Estado&fecha=@ViewBag.Fecha">

                                        @i

                                    </a>

                                </li>
                            }

                            <!-- SIGUIENTE -->
                            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                           href="/Producto?pagina=@(ViewBag.PaginaActual + 1)&buscar=@ViewBag.Buscar&categoria=@ViewBag.Categoria&stock=@ViewBag.Stock&estado=@ViewBag.Estado&fecha=@ViewBag.Fecha">

                                        Siguiente

                                    </a>

                                </li>
                            }

                        </ul>

                    </nav>

                </div>
            }
        </table>
    </div>
</div>

<!-- 🔥 MODAL IMAGEN -->
<div class="modal fade" id="imgModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <img id="imgGrande" style="width:100%" />
        </div>
    </div>
</div>

<!-- 🔥 MODAL PRODUCTO (TU DISEÑO ORIGINAL) -->
<div class="modal fade" id="productoModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Nuevo Producto</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="idProducto" />

                <!-- NOMBRE -->
                <label>Nombre</label>
                <input id="nombre" class="form-control mb-3" />

                <!-- CATEGORIA + STOCK -->
                <div class="row">
                    <div class="col-md-6">
                        <label>Categoría</label>
                        <input id="categoria" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label>Stock Inicial</label>
                        <input id="stock" type="number" class="form-control" value="0" />
                    </div>
                </div>

                <!-- PRECIOS -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <label>Precio Venta ($)</label>
                        <input id="precio" type="number" class="form-control" value="0" />
                    </div>

                    <div class="col-md-6">
                        <label>Costo ($)</label>
                        <input id="costo" type="number" class="form-control" value="0" />
                    </div>
                </div>

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="tieneVariantes"
                           onchange="toggleVariantes()" />

                    <label class="form-check-label">
                        Tiene variantes
                    </label>

                </div>

                <div id="variantesContainer"
                     style="display:none;">

                    <div id="listaVariantes"></div>

                    <button type="button"
                            class="btn btn-outline-primary mt-2"
                            onclick="agregarVariante()">

                        + Agregar Variante

                    </button>

                </div>

                <!-- URL -->
                <div class="mt-3">
                    <label>URL de Imagen</label>
                    <input id="imagenUrl" class="form-control" placeholder="https://..." />
                </div>

                <!-- FILE -->
                <div class="mt-2">
                    <input id="imagenFile" type="file" class="form-control" />
                </div>

                <!-- 🔥 PREVIEW DISCRETO -->
                <div class="text-center mt-3">
                    <img id="previewImagen"
                         src="https://via.placeholder.com/120"
                         style="width:120px; height:120px; object-fit:cover; border-radius:10px; opacity:0.9;" />
                </div>

                <!-- DESCRIPCIÓN -->
                <div class="mt-3">
                    <label>Descripción</label>
                    <textarea id="descripcion" class="form-control"></textarea>
                </div>



                <!-- DISPONIBLE -->
                <div class="mt-2">
                    <input id="disponible" type="checkbox" checked />
                    <label>Producto disponible para la venta</label>
                </div>

            </div>



            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="guardarProducto()">Guardar</button>
            </div>

        </div>
    </div>
</div>

@section Scripts{
<script>

function verImagen(src){
    document.getElementById("imgGrande").src = src;
    new bootstrap.Modal(document.getElementById('imgModal')).show();
}

function abrirModal(){
    limpiar();
    new bootstrap.Modal(document.getElementById('productoModal')).show();
}

function cerrarModal(){
    bootstrap.Modal.getInstance(document.getElementById('productoModal')).hide();
}

function limpiar(){
    document.getElementById("idProducto").value="";
    document.getElementById("nombre").value="";
    document.getElementById("categoria").value="";
    document.getElementById("descripcion").value="";
    document.getElementById("precio").value="";
    document.getElementById("costo").value="";
    document.getElementById("stock").value="";
    document.getElementById("imagenUrl").value="";
    document.getElementById("disponible").checked=true;
            document.getElementById("previewImagen").src = "https://via.placeholder.com/150";

                    //////////////////////////////////////////////////////
        // LIMPIAR VARIANTES
        //////////////////////////////////////////////////////

        document.getElementById("tieneVariantes").checked = false;

        document.getElementById("variantesContainer")
        .style.display = "none";

        document.getElementById("listaVariantes")
        .innerHTML = "";
}

                function editar(id){

            limpiar();

            fetch('/Producto/ObtenerProducto?id=' + id)

            .then(res => res.json())

            .then(p => {

                document.getElementById("idProducto").value = p.idProducto;

                document.getElementById("nombre").value = p.nombre;

                document.getElementById("categoria").value = p.categoria;

                document.getElementById("descripcion").value = p.descripcion;

                document.getElementById("precio").value = p.precioVenta;

                document.getElementById("costo").value = p.costo;

                document.getElementById("stock").value = p.stock;

                document.getElementById("imagenUrl").value = p.imagenUrl || "";

                document.getElementById("disponible").checked = p.disponible;

                //////////////////////////////////////////////////////
                // IMAGEN
                //////////////////////////////////////////////////////

                let preview =
                    document.getElementById("previewImagen");

                preview.src =
                    p.imagenUrl && p.imagenUrl !== ""
                    ? p.imagenUrl
                    : "/Producto/VerImagen/" + p.idProducto;

                //////////////////////////////////////////////////////
                // VARIANTES
                //////////////////////////////////////////////////////

                if(p.variantes && p.variantes.length > 0){

                    document.getElementById("tieneVariantes")
                    .checked = true;

                    toggleVariantes();

                    p.variantes.forEach(v => {

                        agregarVariante(
                            v.nombreVariante,
                            v.stock
                        );

                    });
                }

                new bootstrap.Modal(
                    document.getElementById('productoModal')
                ).show();

            });
        }

function guardarProducto(){

    let formData=new FormData();

            
                    //////////////////////////////////////////////////////
        // VARIANTES
        //////////////////////////////////////////////////////

        document
        .querySelectorAll(".variante-item")
        .forEach((v, index) => {

            let nombre =
                v.querySelector(".nombreVariante").value;

            let stock =
                v.querySelector(".stockVariante").value;

            //////////////////////////////////////////////////////
            // VALIDAR
            //////////////////////////////////////////////////////

            if(nombre && stock){

                formData.append(
                    `Variantes[${index}].NombreVariante`,
                    nombre
                );

                formData.append(
                    `Variantes[${index}].Stock`,
                    stock
                );
            }
        });

    formData.append("IdProducto",document.getElementById("idProducto").value);
    formData.append("Nombre",document.getElementById("nombre").value);
    formData.append("Categoria",document.getElementById("categoria").value);
    formData.append("Descripcion",document.getElementById("descripcion").value);
    formData.append("PrecioVenta",document.getElementById("precio").value);
    formData.append("Costo",document.getElementById("costo").value);
    formData.append("Stock",document.getElementById("stock").value);
    formData.append("ImagenUrl",document.getElementById("imagenUrl").value);
    formData.append("Disponible",document.getElementById("disponible").checked);

    let file=document.getElementById("imagenFile").files[0];

    if(file){
        formData.append("imagenFile",file);
    }

    fetch('/Producto/Guardar',{
        method:'POST',
        body:formData
    })
    .then(res=>res.json())
    .then(data=>{

        if(data==="duplicado"){
            alert("Producto ya existe");
            return;
        }

        location.reload();
    });
}

function eliminar(id){
    if(!confirm("¿Enviar a eliminados?")) return;

    fetch('/Producto/Eliminar?id='+id,{method:'POST'})
    .then(()=>location.reload());
}

        document.getElementById("imagenUrl").addEventListener("input", function () {
            let url = this.value;

            if (url) {
                document.getElementById("previewImagen").src = url;
            }
        });

                // 🔥 PREVIEW DESDE ARCHIVO
        document.getElementById("imagenFile").addEventListener("change", function () {

            let file = this.files[0];

            if (file) {
                let reader = new FileReader();

                reader.onload = function (e) {
                    document.getElementById("previewImagen").src = e.target.result;
                };

                reader.readAsDataURL(file);
            }
        });

                //////////////////////////////////////////////////////
        // DELAY BUSCADOR
        //////////////////////////////////////////////////////

        let timeoutBusqueda;

        function filtrarConDelay(){

            clearTimeout(timeoutBusqueda);

            timeoutBusqueda = setTimeout(() => {

                filtrarServidor();

            }, 700);
        }

                      //////////////////////////////////////////////////////
        // FILTROS SERVIDOR
        //////////////////////////////////////////////////////

        function filtrarServidor(){

            let buscar =
                document.getElementById("buscador").value;

            let categoria =
                document.getElementById("filtroCategoria").value;

            let stock =
                document.getElementById("filtroStock").value;

            let estado =
                document.getElementById("filtroEstado").value;

            let fecha =
                document.getElementById("filtroFecha").value;

            //////////////////////////////////////////////////////
            // URL
            //////////////////////////////////////////////////////

            let url =
                `/Producto?buscar=${encodeURIComponent(buscar)}`
                + `&categoria=${encodeURIComponent(categoria)}`
                + `&stock=${encodeURIComponent(stock)}`
                + `&estado=${encodeURIComponent(estado)}`
                + `&fecha=${encodeURIComponent(fecha)}`;

            //////////////////////////////////////////////////////
            // REDIRECT
            //////////////////////////////////////////////////////

            window.location.href = url;
        }

                //////////////////////////////////////////////////////
        // TOGGLE
        //////////////////////////////////////////////////////

        function toggleVariantes(){

            let check =
                document.getElementById("tieneVariantes");

            let div =
                document.getElementById("variantesContainer");

            div.style.display =
                check.checked
                ? "block"
                : "none";
        }

        //////////////////////////////////////////////////////
        // AGREGAR VARIANTE
        //////////////////////////////////////////////////////

                  function agregarVariante(nombre = "", stock = 0){

            let container =
                document.getElementById("listaVariantes");

            let html = `

                <div class="row mb-2 variante-item">

                    <div class="col-md-6">

                        <input type="text"
                               class="form-control nombreVariante"
                               value="${nombre}"
                               placeholder="Ej: Talla 5" />

                    </div>

                    <div class="col-md-4">

                        <input type="number"
                               class="form-control stockVariante"
                               value="${stock}"
                               placeholder="Stock" />

                    </div>

                    <div class="col-md-2">

                        <button type="button"
                                class="btn btn-danger w-100"
                                onclick="this.parentElement.parentElement.remove()">

                            X

                        </button>

                    </div>

                </div>
            `;

            container.insertAdjacentHTML(
                "beforeend",
                html
            );
        }

</script>
}