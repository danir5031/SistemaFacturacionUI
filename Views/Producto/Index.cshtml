        // DELAY BUSCADOR
        //////////////////////////////////////////////////////

        let timeoutBusqueda;

        function filtrarConDelay(){

            clearTimeout(timeoutBusqueda);

            timeoutBusqueda = setTimeout(() => {

                filtrarServidor();

            }, 700);
        }

                      //////////////////////////////////////////////////////
        // FILTROS SERVIDOR
        //////////////////////////////////////////////////////

        function filtrarServidor(){

            let buscar =
                document.getElementById("buscador").value;

            let categoria =
                document.getElementById("filtroCategoria").value;

            let stock =
                document.getElementById("filtroStock").value;

            let estado =
                document.getElementById("filtroEstado").value;

            let fecha =
                document.getElementById("filtroFecha").value;

            //////////////////////////////////////////////////////
            // URL
            //////////////////////////////////////////////////////

            let url =
                `/Producto?buscar=${encodeURIComponent(buscar)}`
                + `&categoria=${encodeURIComponent(categoria)}`
                + `&stock=${encodeURIComponent(stock)}`
                + `&estado=${encodeURIComponent(estado)}`
                + `&fecha=${encodeURIComponent(fecha)}`;

            //////////////////////////////////////////////////////
            // REDIRECT
            //////////////////////////////////////////////////////

            window.location.href = url;
        }

                //////////////////////////////////////////////////////
        // TOGGLE
        //////////////////////////////////////////////////////

        function toggleVariantes(){

            let check =
                document.getElementById("tieneVariantes");

            let div =
                document.getElementById("variantesContainer");

            div.style.display =
                check.checked
                ? "block"
                : "none";
        }

        //////////////////////////////////////////////////////
        // AGREGAR VARIANTE
        //////////////////////////////////////////////////////

                  function agregarVariante(nombre = "", stock = 0){

            let container =
                document.getElementById("listaVariantes");

            let html = `

                <div class="row mb-2 variante-item">

                    <div class="col-md-6">

                        <input type="text"
                               class="form-control nombreVariante"
                               value="${nombre}"
                               placeholder="Ej: Talla 5" />

                    </div>

                    <div class="col-md-4">

                        <input type="number"
                               class="form-control stockVariante"
                               value="${stock}"
                               placeholder="Stock" />

                    </div>

                    <div class="col-md-2">

                        <button type="button"
                                class="btn btn-danger w-100"
                                onclick="this.parentElement.parentElement.remove()">

                            X

                        </button>

                    </div>

                </div>
            `;

            container.insertAdjacentHTML(
                "beforeend",
                html
            );
        }

