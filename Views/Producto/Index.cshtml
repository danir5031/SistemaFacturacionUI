                       </span>`;

                               let descripcion = document.getElementById("detalleDescripcion");

        if(descripcion){
            descripcion.innerText =
                p.descripcion || "Sin descripción";
        }
                

                //////////////////////////////////////////////////////
                // VARIANTES
                //////////////////////////////////////////////////////

                let variantes = "Sin variantes";

                if(p.variantes && p.variantes.length > 0){

                    variantes = p.variantes
                        .map(v => `
                            <span class="badge bg-dark me-1 mb-1">
                                ${v.nombreVariante}: ${v.stock}
                            </span>
                        `)
                        .join("");
                }

                document.getElementById("detalleVariantes")
                    .innerHTML = variantes;

                //////////////////////////////////////////////////////
                // ABRIR MODAL
                //////////////////////////////////////////////////////

                new bootstrap.Modal(
                    document.getElementById("detalleProductoModal")
                ).show();

            });
