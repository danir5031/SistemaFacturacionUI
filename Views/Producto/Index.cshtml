@model List<SistemaFacturacionUI.Models.Producto>
@using Microsoft.AspNetCore.Http

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rol = (Context.Session.GetString("rol") ?? "").ToUpper();
}

<style>
.img-producto{
    width:60px;
    height:60px;
    object-fit:cover;
    border-radius:10px;
    cursor:pointer;
    transition:0.3s;
}
.img-producto:hover{
            transform: scale(1.15);
}

    .pagination {
        flex-wrap: wrap;
        gap: 6px;
    }

    @@media(max-width:768px) {

        .pagination {
            justify-content: center;
        }

        .page-link {
            min-width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px !important;
            font-size: 14px;
            padding: 0 10px;
        }

        .table-responsive {
            overflow-x: auto;
        }
    }

    .product-info-table {
        width: 100%;
    }

        .product-info-table tr {
            border-bottom: 1px solid #e5e7eb;
        }

        .product-info-table td,
        .product-info-table th {
            padding: 14px;
            vertical-align: top;
        }


        .product-info-table th {
            width: 35%;
            font-weight: 700;
            color: #111827;
        }

    .card-box {
        border-radius: 18px;
    }

    @@media(max-width:768px) {

        .card-box {
            padding: 16px !important;
        }

            .card-box h5 {
                font-size: 20px;
            }

            .card-box img {
                width: 100px !important;
                height: 100px !important;
            }

        .btn {
            border-radius: 12px;
        }

        .pagination {
            gap: 4px;
        }

        .page-link {
            font-size: 13px;
            min-width: 34px;
            height: 34px;
        }
    }

    @@media(max-width:768px) {

        .product-info-table,
        .product-info-table tbody,
        .product-info-table tr,
        .product-info-table td,
        .product-info-table th {
            display: block;
            width: 100%;
        }

            .product-info-table tr {
                margin-bottom: 18px;
                border-bottom: 1px solid #d1d5db;
                padding-bottom: 10px;
            }

            .product-info-table td,
            .product-info-table th {
                padding: 6px 0;
                text-align: left;
                word-break: break-word;
            }

            .product-info-table th {
                color: #374151;
                font-size: 15px;
            }
    }

    .product-detail-table {
        width: 100%;
    }

        .product-detail-table tr {
            border-bottom: 1px solid #e5e7eb;
        }

        .product-detail-table th,
        .product-detail-table td {
            padding: 16px 10px;
            vertical-align: middle;
        }

        .product-detail-table th {
            width: 35%;
            font-weight: 700;
            color: #111827;
            white-space: nowrap;
        }

        .product-detail-table td {
            color: #374151;
            word-break: break-word;
        }

    @@media(max-width:768px) {

        .product-detail-table tr {
            display: flex !important;
            flex-direction: column;
            align-items: flex-start;
            padding: 14px 0;
        }

        .product-detail-table th {
            width: 100% !important;
            padding-bottom: 6px !important;
            font-size: 16px;
        }

        .product-detail-table td {
            width: 100% !important;
            font-size: 15px;
            padding-top: 0 !important;
        }

        #detalleProductoModal .modal-body {
            padding: 16px !important;
        }

        #detalleProductoModal img {
            width: 100%;
            max-height: 240px;
            object-fit: cover;
        }

        #detalleProductoModal .modal-dialog {
            margin: 10px;
        }

        #detalleProductoModal .modal-content {
            border-radius: 22px;
        }
    }

    @@media(max-width:768px) {

        #detalleProductoModal .modal-dialog {
            margin: 10px;
        }

        #detalleProductoModal .modal-content {
            border-radius: 22px;
        }

        #detalleProductoModal .modal-body {
            padding: 18px !important;
        }

        #detalleProductoModal .row {
            flex-direction: column;
        }

        #detalleProductoModal .col-md-4,
        #detalleProductoModal .col-md-8 {
            width: 100%;
        }

        #detalleProductoModal img {
            max-height: 240px !important;
        }

        .product-detail-table,
        .product-detail-table tbody,
        .product-detail-table tr,
        .product-detail-table th,
        .product-detail-table td {
            display: block;
            width: 100%;
        }

            .product-detail-table tr {
                padding: 12px 0;
            }

            .product-detail-table th {
                padding-bottom: 4px;
                font-size: 15px;
            }

            .product-detail-table td {
                padding-top: 0;
                font-size: 15px;
            }
    }
</style>

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h3>Productos</h3>
        <p class="text-muted">Inventario y catálogo de productos.</p>
    </div>

    @if (rol == "ADMIN")
    {
        <div>
            <button class="btn btn-primary" onclick="abrirModal()">+ Nuevo Producto</button>

            <a href="/Producto/Eliminados" class="btn btn-outline-danger">
                🗑️ Eliminados
            </a>
        </div>
    }
</div>

<div class="card-box mt-3">

    <!-- 🔥 FILTROS -->
    <div class="row mb-3">

        <div class="col-md-4">
            <input id="buscador" value="@ViewBag.Buscar" class="form-control"
                   placeholder="Buscar por nombre o categoría..."
                   onkeyup="filtrarConDelay()"  />
        </div>

        <div class="col-md-2">
            <select id="filtroCategoria" class="form-control" onchange="filtrarServidor()">
                <option value="">Categoría</option>
                @foreach (var cat in ViewBag.Categorias)
                {
                    <option value="@cat"
                            selected="@(ViewBag.Categoria == cat ? "selected" : null)">

                        @cat

                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <select id="filtroStock"
                    class="form-control"
                    onchange="filtrarServidor()">

                <option value="">Stock</option>

                <option value="bajo"
                        selected="@(ViewBag.Stock == "bajo" ? "selected" : null)">
                    Bajo (&lt;5)
                </option>

                <option value="medio"
                        selected="@(ViewBag.Stock == "medio" ? "selected" : null)">
                    Medio (5-20)
                </option>

                <option value="alto"
                        selected="@(ViewBag.Stock == "alto" ? "selected" : null)">
                    Alto (&gt;20)
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <select id="filtroEstado"
                    class="form-control"
                    onchange="filtrarServidor()">

                <option value="">Estado</option>

                <option value="true"
                        selected="@(ViewBag.Estado == "true" ? "selected" : null)">
                    Disponible
                </option>

                <option value="false"
                        selected="@(ViewBag.Estado == "false" ? "selected" : null)">
                    No disponible
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <input type="date"
                   id="filtroFecha"
                   class="form-control"
                   value="@ViewBag.Fecha"
                   onchange="filtrarServidor()" />
        </div>

    </div>
    <div class="table-responsive d-none d-md-block">
        <!--<div class="table-responsive">-->
        <!--<table class="table align-middle">-->
           <table class="product-info-table">

            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Stock</th>
                    <th>Precio</th>
                    <th>Ubicacion</th>
                    @if (rol == "ADMIN")
                    {
                    <th>Estado</th>
                    

                    
                        <th>Acciones</th>
                    }
                    else
                    {
                        <th>Información</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    if(item.Activo) // 🔥 SOLO ACTIVOS
                    {
                        <tr data-nombre="@item.Nombre.ToLower()"
                            data-categoria="@item.Categoria.ToLower()"
                            data-stock="@item.Stock"
                            data-estado="@item.Disponible.ToString().ToLower()"
                            data-fecha="@item.FechaRegistro.ToString("yyyy-MM-dd")">
                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    @if (item.Imagen != null)
                                    {
                                        <img src="/Producto/VerImagen/@item.IdProducto"
                                             class="img-producto"
                                             onclick="verImagen(this.src)" />
                                    }
                                    else if (!string.IsNullOrEmpty(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl"
                                             class="img-producto"
                                             onclick="verImagen(this.src)" />
                                    }
                                    else
                                    {
                                        <img src="https://via.placeholder.com/70"
                                             class="img-producto" />
                                    }

                                    <div>

                                        <b>@item.Nombre</b><br />

                                        <small>@item.Categoria</small>

                                        @if (item.Variantes != null && item.Variantes.Any())
                                        {
                                            <br />

                                            <small style="color:#8fa8d6;">

                                                Variantes:

                                                @string.Join(", ",
                                                    item.Variantes
                                                    .Where(v => v.Activo)
                                                    .Select(v => $"{v.NombreVariante} ({v.Stock})")
                                                )

                                            </small>
                                        }

                                    </div>
                                </div>
                            </td>

                            <td>
                                @{
                                    string color = "bg-success";

                                    if (item.Stock < 10)
                                        color = "bg-danger";
                                    else if (item.Stock <= 20)
                                        color = "bg-warning";
                                }

                                <span class="badge @color">
                                    @item.Stock unid.
                                </span>
                            </td>

                            <td>
                                <b>$@item.PrecioVenta</b><br />
                                <small>Costo: $@item.Costo</small><br />

                                @{
                                    decimal margen = 0;
                                    decimal markup = 0;

                                    // 🔥 MARGEN (correcto)
                                    if (item.PrecioVenta > 0)
                                    {
                                        margen = ((item.PrecioVenta - item.Costo) / item.PrecioVenta) * 100;
                                    }

                                    // 🔥 MARKUP (limitado a 100%)
                                    if (item.Costo > 0)
                                    {
                                        markup = ((item.PrecioVenta - item.Costo) / item.Costo) * 100;

                                        if (markup > 100)
                                        {
                                            markup = 100;
                                        }
                                    }
                                    string colorMargen = "green";

                                    if (margen < 30)
                                        colorMargen = "red";
                                    else if (margen <= 60)
                                        colorMargen = "orange";
                                }

                            
                                <small style="color:@colorMargen; font-weight:bold;">
                                    Margen: @Math.Round(margen, 1)%
                            
                                </small><br />

                                <small style="color:#6c757d;">
                                    Markup: @Math.Round(markup, 1)%
                                </small>
                            </td>

                            @if (rol == "ADMIN")
                            {
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        @(item.Descripcion.Length > 50
                                            ? item.Descripcion.Substring(0, 50) + "..."
                                            : item.Descripcion)
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin descripción
                                        </span>
                                    }

                                </td>
                            }

                            <td>
                                <span class="badge @(item.Disponible ? "bg-success" : "bg-danger")">
                                    @(item.Disponible ? "Disponible" : "No disponible")
                                </span>
                            </td>

                            @if (rol == "ADMIN")
                            {
                                <td>
                                    <button class="btn btn-warning btn-sm"
                                            onclick="editar(@item.IdProducto)">
                                        ✏️
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            onclick="eliminar(@item.IdProducto)">
                                        🗑️
                                    </button>
                                </td>
                            }
                            else
                            {
                                <td>

                                    <button class="btn btn-info btn-sm"
                                            onclick="verDetalle(@item.IdProducto)">

                                        👁️ Ver

                                    </button>

                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            
        </table>
    </div>

    <!-- MOBILE CARDS -->

    <div class="d-block d-md-none">

        @foreach (var item in Model)
        {
            if (item.Activo)
            {
                <div class="card-box mb-3 p-3">
                    <!--<div class="card-box mb-3"> -->

                    <div class="text-center mb-3">

                        @if (item.Imagen != null)
                        {
                            <img src="/Producto/VerImagen/@item.IdProducto"
                                 onclick="verImagen(this.src)"
                                 style="
                            width:90px;
                            height:90px;
                            object-fit:cover;
                            border-radius:16px;
                            cursor:pointer;" />
                        }
                        else if (!string.IsNullOrEmpty(item.ImagenUrl))
                        {
                            <img src="@item.ImagenUrl"
                                 onclick="verImagen(this.src)"
                                 style="
                            width:90px;
                            height:90px;
                            object-fit:cover;
                            border-radius:16px;
                            cursor:pointer;" />
                        }

                    </div>

                    <h5 class="fw-bold">
                        @item.Nombre
                    </h5>

                    <small class="text-muted">
                        @item.Categoria
                    </small>

                    <hr />

                    <div class="mb-2">

                        <span class="badge bg-primary">
                            @item.Stock unid.
                        </span>

                    </div>

                    <div class="mb-2">

                        <b style="font-size:22px;">
                            $@item.PrecioVenta
                        </b>

                    </div>

                  

                    <div class="mb-2">

                        <span class="badge @(item.Disponible ? "bg-success" : "bg-danger")">

                            @(item.Disponible ? "Disponible" : "No disponible")

                        </span>

                    </div>

                    @if (rol == "ADMIN")
                    {
                        <div class="mt-2 p-2"
                             style="
                            background:rgba(0,0,0,.03);
                            border-radius:10px;">

                            <small class="fw-bold">
                                Ubicacion
                            </small>

                            <div style="
                                font-size:14px;
                                margin-top:5px;">

                                @(string.IsNullOrWhiteSpace(item.Descripcion)
                                    ? "Sin descripción"
                                    : item.Descripcion)

                            </div>

                        </div>
                    }

                    @if (item.Variantes != null && item.Variantes.Any())
                    {
                        <div class="mt-2">

                            <small style="color:#8fa8d6;">

                                Variantes:

                                @string.Join(", ",
                                    item.Variantes
                                    .Where(v => v.Activo)
                                    .Select(v => $"{v.NombreVariante} ({v.Stock})")
                                )

                            </small>

                        </div>
                    }

                    <hr />

                    @if (rol == "ADMIN")
                    {
                        <div class="d-flex gap-2">

                            <button class="btn btn-warning w-100"
                                    onclick="editar(@item.IdProducto)">

                                ✏️ Editar

                            </button>

                            <button class="btn btn-danger w-100"
                                    onclick="eliminar(@item.IdProducto)">

                                🗑️

                            </button>

                        </div>
                    }
                    else
                    {
                        <button class="btn btn-info w-100"
                                onclick="verDetalle(@item.IdProducto)">

                            👁️ Ver información

                        </button>
                    }

                </div>
            }
        }

    </div>
    <!-- PAGINACION -->
    <!-- PAGINACION -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-center mt-4">

            <nav>

                <ul class="pagination">

                    <!-- ANTERIOR -->
                    @if (ViewBag.PaginaActual > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                                   href="/Producto?pagina=@(ViewBag.PaginaActual - 1)&buscar=@ViewBag.Buscar&categoria=@ViewBag.Categoria&stock=@ViewBag.Stock&estado=@ViewBag.Estado&fecha=@ViewBag.Fecha">

                                Anterior

                            </a>

                        </li>
                    }

                    <!-- PAGINAS -->
                    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                            <a class="page-link"
                                   href="/Producto?pagina=@i&buscar=@ViewBag.Buscar&categoria=@ViewBag.Categoria&stock=@ViewBag.Stock&estado=@ViewBag.Estado&fecha=@ViewBag.Fecha">

                                @i

                            </a>

                        </li>
                    }

                    <!-- SIGUIENTE -->
                    @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
                    {
                        <li class="page-item">

                            <a class="page-link"
                                   href="/Producto?pagina=@(ViewBag.PaginaActual + 1)&buscar=@ViewBag.Buscar&categoria=@ViewBag.Categoria&stock=@ViewBag.Stock&estado=@ViewBag.Estado&fecha=@ViewBag.Fecha">

                                Siguiente

                            </a>

                        </li>
                    }

                </ul>

            </nav>

        </div>
    }
</div>

<!-- 🔥 MODAL IMAGEN -->
<div class="modal fade" id="imgModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-transparent border-0">
            <img id="imgGrande"
                 style="
            width:100%;
            border-radius:20px;
            max-height:90vh;
            object-fit:contain;" />
        </div>
    </div>
</div>

<!-- 🔥 MODAL PRODUCTO (TU DISEÑO ORIGINAL) -->
<div class="modal fade" id="productoModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Nuevo Producto</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="idProducto" />

                <!-- NOMBRE -->
                <label>Nombre</label>
                <input id="nombre" class="form-control mb-3" />

                <!-- CATEGORIA + STOCK -->
                <div class="row">
                    <div class="col-md-6">
                        <label>Categoría</label>
                        <input id="categoria" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label>Stock Inicial</label>
                        <input id="stock" type="number" class="form-control" value="0" />
                    </div>
                </div>

                <!-- PRECIOS -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <label>Precio Venta ($)</label>
                        <input id="precio" type="number" class="form-control" value="0" />
                    </div>

                    <div class="col-md-6">
                        <label>Costo ($)</label>
                        <input id="costo" type="number" class="form-control" value="0" />
                    </div>
                </div>

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="tieneVariantes"
                           onchange="toggleVariantes()" />

                    <label class="form-check-label">
                        Tiene variantes
                    </label>

                </div>

                <div id="variantesContainer"
                     style="display:none;">

                    <div id="listaVariantes"></div>

                    <button type="button"
                            class="btn btn-outline-primary mt-2"
                            onclick="agregarVariante()">

                        + Agregar Variante

                    </button>

                </div>

                <!-- URL -->
                <div class="mt-3">
                    <label>URL de Imagen</label>
                    <input id="imagenUrl" class="form-control" placeholder="https://..." />
                </div>

                <!-- FILE -->
                <div class="mt-2">
                    <input id="imagenFile" type="file" class="form-control" />
                </div>

                <!-- 🔥 PREVIEW DISCRETO -->
                <div class="text-center mt-3">
                    <img id="previewImagen"
                         src="https://via.placeholder.com/120"
                         style="width:120px; height:120px; object-fit:cover; border-radius:10px; opacity:0.9;" />
                </div>

                <!-- DESCRIPCIÓN -->
                <div class="mt-3">
                    <label>Descripción</label>
                    <textarea id="descripcion" class="form-control"></textarea>
                </div>



                <!-- DISPONIBLE -->
                <div class="mt-2">
                    <input id="disponible" type="checkbox" checked />
                    <label>Producto disponible para la venta</label>
                </div>

            </div>



            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="guardarProducto()">Guardar</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="detalleProductoModal">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content border-0"
             style="
            border-radius:25px;
            overflow:hidden;
            background:#f8fafc;">

            <div class="modal-header border-0 px-4 pt-4">

                <h3 class="fw-bold">
                    Información del Producto
                </h3>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body px-4 pb-4">

                <div class="row">

                    <!-- IMAGEN -->

                    <div class="col-md-4 text-center">

                        <div style="
                            background:white;
                            border-radius:20px;
                            padding:20px;
                            box-shadow:0 5px 20px rgba(0,0,0,.05);">

                            <img id="detalleImagen"
                                 style="
                            width:100%;
                            max-height:300px;
                            object-fit:contain;
                            border-radius:18px;" />

                        </div>

                    </div>

                    <!-- INFO -->

                    <div class="col-md-8">

                        <div style="
                            background:white;
                            border-radius:20px;
                            padding:25px;
                            box-shadow:0 5px 20px rgba(0,0,0,.05);">

                            <table class="product-detail-table">

                                <tbody>

                                    <tr>
                                        <th width="35%">Nombre</th>

                                        <td id="detalleNombre"></td>
                                    </tr>

                                    <tr>
                                        <th>Categoría</th>

                                        <td id="detalleCategoria"></td>
                                    </tr>

                                    <tr>
                                        <th>Precio</th>

                                        <td id="detallePrecio"></td>
                                    </tr>

                                    

                                    <tr>
                                        <th>Stock</th>

                                        <td id="detalleStock"></td>
                                    </tr>

                                    <tr>
                                        <th>Estado</th>

                                        <td id="detalleEstado"></td>
                                    </tr>

                                    @if (rol == "ADMIN")
                                    {
                                        <tr>
                                            <th>Descripción</th>
                                            <td id="detalleDescripcion"></td>
                                        </tr>
                                    }

                                    <tr>
                                        <th>Variantes</th>

                                        <td id="detalleVariantes"></td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{
<script>

function verImagen(src){
    document.getElementById("imgGrande").src = src;
    new bootstrap.Modal(document.getElementById('imgModal')).show();
}

function abrirModal(){
    limpiar();
    new bootstrap.Modal(document.getElementById('productoModal')).show();
}

function cerrarModal(){
