@model SistemaFacturacionUI.Models.Factura

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <title>Ticket</title>

    <style>

            @@page {
                size: 80mm auto;
                margin: 0;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                background: #fff;
            }

            body {
                width: 72mm;
                margin: 0 auto;
                font-family: Arial,sans-serif;
                background: #fff;
            }

            .ticket {
                width: 72mm;
                padding: 3mm;
            }

            .center {
                text-align: center;
            }

            .logo {
                width: 100px;
                display: block;
                margin: auto;
                margin-bottom: 8px;
            }

            .titulo {
                font-size: 14px;
                font-weight: bold;
                margin: 5px 0;
            }

            .linea {
                border-top: 1px dashed #000;
                margin: 5px 0;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            td {
                font-size: 12px;
                padding: 2px 0;
                vertical-align: top;
            }

            .producto {
                width: 55%;
            }

            .cant {
                width: 15%;
                text-align: center;
            }

            .precio {
                width: 30%;
                text-align: right;
            }

            .total {
                text-align: center;
                font-size: 28px;
                font-weight: bold;
                margin: 10px 0;
            }

            .btn-print {
                width: 100%;
                padding: 10px;
                background: #000;
                color: #fff;
                border: none;
                margin-top: 10px;
                cursor: pointer;
            }

            @@media print {

                html,
                body {
                    width: 72mm;
                }

                .btn-print {
                    display: none !important;
                }
            }

    </style>

</head>

<body>
    <div class="ticket">
    <!-- LOGO -->

    <div class="center">
        
            <!-- <img src="~/img/loo.png"
             class="logo" />-->
            <img src="~/img/tao2.png"
                 class="logo" />

    </div>

    <div class="center">

            <!--<h3 class="titulo">
                TAO
        </h3>-->

    </div>

    <div class="linea"></div>

    <!-- DATOS -->

    <table>

        <tr>
            <td><b>Factura:</b></td>
            <td>@Model.NumeroFactura</td>
        </tr>

        <tr>
            <td><b>Fecha:</b></td>
            <td>
                @(Model.FechaEnvio.HasValue
        ? Model.FechaEnvio.Value.ToString(
            "dddd, dd 'de' MMMM 'del' yyyy",
            new System.Globalization.CultureInfo("es-ES")
        )
        : "-")
            </td>
        </tr>

        <tr>
            <td><b>Cliente:</b></td>
            <td>@Model.NombreCliente</td>
        </tr>

        <tr>
            <td><b>Tel:</b></td>
            <td>@Model.Telefono</td>
        </tr>

        <tr>
            <td><b>Pago:</b></td>
            <td>@Model.MetodoPago</td>
        </tr>

        <tr>
            <td><b>Horario:</b></td>
            <td>
                @(Model.Horario == "EXACTO"
                    ? Model.HoraExacta
                    : Model.Horario)
            </td>
        </tr>
            <tr>
                <td><b>Vendedor:</b></td>

                <td>
                    @(Model.Usuario != null
                        ? Model.Usuario.Usuario1
                        : "-")
                </td>
            </tr>

    </table>

    <div class="linea"></div>

    <!-- PRODUCTOS -->

    <table>

        <thead>

            <tr>

                <td class="producto"><b>Producto</b></td>
                <td class="cant"><b>Cant</b></td>
                <td class="precio"><b>Total</b></td>

            </tr>

        </thead>

        <tbody>

            @foreach (var d in Model.Detalles)
            {
                <tr>

                    <td>

                            @(d.Producto != null
        ? d.Producto.Nombre +
          (!string.IsNullOrEmpty(d.Variante)
            ? " - " + d.Variante
            : "")
        : "Producto")

                        <br />

                        <small>

                            $@d.Precio c/u

                        </small>

                    </td>

                    <td align="center">

                        @d.Cantidad

                    </td>

                    <td align="right">

                        $@(d.Cantidad * d.Precio)

                    </td>

                </tr>
            }
            

        </tbody>

    </table>

    <div class="linea"></div>

    <!-- TOTALES -->

    <table>

        <tr>

            <td>Subtotal:</td>

            <td align="right">
                $@Model.Subtotal
            </td>

        </tr>

        <tr>

            <td>Envío:</td>

            <td align="right">
                $@Model.Envio
            </td>

        </tr>

        <tr>

            <td>Descuento:</td>

            <td align="right">
                $@Model.Descuento
            </td>

        </tr>

    </table>

    <div class="linea"></div>

    <div class="center total">

        @*TOTAL: $@Model.Total*@
            TOTAL:
            $@(Model.MetodoPago == "Transferencia"
                ? "0.00"
                : Model.Total.ToString("0.00"))

    </div>

    <div class="linea"></div>

    <!-- DIRECCIÓN -->

    <div>

        <b>Dirección:</b>

        <p style="font-size:12px;">

            @Model.Direccion

        </p>

    </div>

    <!-- COMENTARIO -->
    @if (!string.IsNullOrWhiteSpace(Model.Comentario))
    {
        <div>

            <b>Comentario:</b>

            <p style="font-size:12px;">

                @Model.Comentario

            </p>

        </div>
    }

    <div class="linea"></div>

    <div class="center">

        Gracias por su compra ❤️

    </div>

    <!-- IMPRIMIR -->

    <button class="btn-print"
            onclick="window.print()">

        🖨 Imprimir Ticket

    </button>
    </div>
</body>
</html>