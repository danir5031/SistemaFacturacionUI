        //////////////////////////////////////////////////////

        let municipio =
            document.getElementById("municipio").value.trim();

        if (municipio === "")
        {
            alert("Debes ingresar el municipio.");

            document.getElementById("municipio").focus();

            return;
        }

            let data = {
                 IdFactura: facturaEditando,

                NombreCliente:
                    document.getElementById("nombreCliente").value,

                Telefono:
                    document.getElementById("telefono").value,

                Direccion:
                    document.getElementById("direccion").value,

                Departamento:
                    document.getElementById("departamento").value,

                Municipio:
                    document.getElementById("municipio").value,

                Tienda:
                    document.getElementById("tienda").value,

                Comentario:
                    document.getElementById("comentario").value,

                Horario:
                    document.getElementById("horario").value,

                HoraExacta:
                    document.getElementById("horaExacta").value,

                FechaEnvio:
                    document.getElementById("fechaEnvio").value,

                Subtotal:
                    subtotalGlobal,

                Envio:
                    parseFloat(document.getElementById("envio").value) || 0,

                Descuento:
                    parseFloat(document.getElementById("valorDescuento").value) || 0,

                Total:
                    parseFloat(
                        document.getElementById("totalFinal")
                        .innerText
                        .replace("$", "")
                    ),

                MetodoPago:
                    metodoPago,

                Estado:
                    "Completada",

                Detalles:
                    detalles
            };

            console.log(data);

              const fechaSeleccionada =
    document.getElementById("fechaEnvio").value;

const hoy = new Date();

const fechaHoy =
    hoy.getFullYear() + "-" +
    String(hoy.getMonth() + 1).padStart(2, "0") + "-" +
    String(hoy.getDate()).padStart(2, "0");

if (fechaSeleccionada < fechaHoy)
{
    alert("No puedes seleccionar una fecha anterior al día de hoy.");
    return;
}

        if (facturaEditando > 0) {

            guardarNormal(data);

            return;

        }

                    fetch("/Facturacion/VerificarCliente?telefono=" + encodeURIComponent(data.Telefono))
        .then(r => r.json())
        .then(info => {

            if (!info.mostrar) {

                // AQUÍ va exactamente el fetch original
                guardarNormal(data);

                return;
            }

            mostrarHistorial(info);

            document.getElementById("btnContinuarFactura").onclick = function () {

                bootstrap.Modal.getInstance(
                    document.getElementById("modalHistorialCliente")
                ).hide();

                guardarNormal(data);
            };

        });
        }


                 function guardarNormal(data) {

            fetch(facturaEditando > 0
                ? '/Facturacion/ActualizarFactura'
                : '/Facturacion/GuardarFactura', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(data)

            })
            .then(res => res.json())
            .then(r => {

                console.log(r);

                if (r === true) {

                    alert("Factura guardada correctamente 🔥");

                    location.reload();

                } else {

                    alert("Error: " + r);

                }

            })
            .catch(error => {

                console.log(error);

                alert("Ocurrió un error al guardar");

            });

        }



        //////////////////////////////////////////////////////
        // MOSTRAR FORM
        //////////////////////////////////////////////////////

        function abrirFormulario() {

    let form =
        document.getElementById("formFactura");

    let lista =
        document.getElementById("listaFacturas");

    form.style.display = "block";

    lista.style.display = "none";

    //////////////////////////////////////////////////////
    // SI ES NUEVA FACTURA
    //////////////////////////////////////////////////////

    if (facturaEditando === 0)
    {
        document.getElementById("lecturaInteligente")
            .style.display = "block";
                    document.getElementById("buscarClienteBox")
            .style.display = "block";

        document.getElementById("btnNuevaFactura")
            .style.display = "none";
    }
}

        //////////////////////////////////////////////////////
        // CANCELAR
        //////////////////////////////////////////////////////

        function cancelar() {

            facturaEditando = 0;
            document.getElementById("nombreCliente").readOnly = false;

            //////////////////////////////////////////////////////
            // LIMPIAR CAMPOS
            //////////////////////////////////////////////////////

            document.getElementById("nombreCliente").value = "";
            document.getElementById("telefono").value = "";
            document.getElementById("direccion").value = "";
                    document.getElementById("tienda").value = "";
            document.getElementById("comentario").value = "";
            document.getElementById("municipio").value = "";
            document.getElementById("fechaEnvio").value = "";
            document.getElementById("horaExacta").value = "";

            document.getElementById("departamento").selectedIndex = 0;
            document.getElementById("horario").selectedIndex = 0;

            //////////////////////////////////////////////////////
            // TABLA
            //////////////////////////////////////////////////////

            document.getElementById("tablaProductosFactura").innerHTML = "";

            //////////////////////////////////////////////////////
            // TOTALES
            //////////////////////////////////////////////////////

            subtotalGlobal = 0;

            document.getElementById("subtotal").innerText = "$0.00";
            document.getElementById("totalFinal").innerText = "$0.00";

            //////////////////////////////////////////////////////
            // MOSTRAR LISTA
            //////////////////////////////////////////////////////

            document.getElementById("formFactura").style.display = "none";

            document.getElementById("lecturaInteligente").style.display = "block";

                    document.getElementById("buscarClienteBox").style.display = "block";

        document.getElementById("buscarCliente").value = "";

        document.getElementById("resultadoClientes").innerHTML = "";

            document.getElementById("btnNuevaFactura").style.display = "inline-block";

            document.getElementById("listaFacturas").style.display = "block";

            //////////////////////////////////////////////////////
            // BOTÓN
            //////////////////////////////////////////////////////

            document.querySelector(
                '.btn.btn-primary.w-100.mt-4'
            ).innerText = "Confirmar e Imprimir Factura";
        }

                //////////////////////////////////////////////////////
        // FILTRAR FACTURAS
        //////////////////////////////////////////////////////

                function filtrarFacturas() {

            let texto =
                document.getElementById("buscadorFacturas")
                .value
                .toLowerCase()
                .trim();

            let horario =
                document.getElementById("filtroHorario").value
                .toLowerCase();

            let pago =
                document.getElementById("filtroPago").value
                .toLowerCase();

            let estado =
                document.getElementById("filtroEstado").value
                .toLowerCase();

            document.querySelectorAll("#listaFacturas tbody tr")
                .forEach(fila => {

                    let cliente =
                        (fila.dataset.cliente || "").toLowerCase();

                    let telefono =
                        (fila.dataset.telefono || "").toLowerCase();

                    let factura =
                        (fila.dataset.factura || "").toLowerCase();

                    let horarioFila =
                        (fila.dataset.horario || "").toLowerCase();

                    let pagoFila =
                        (fila.dataset.pago || "").toLowerCase();

                    let estadoFila =
                        (fila.dataset.estado || "").toLowerCase();

                    let mostrar = true;

                    //////////////////////////////////////////////////////
                    // BUSCADOR GENERAL
                    //////////////////////////////////////////////////////

                    if (
                        texto &&
                        !cliente.includes(texto) &&
                        !telefono.includes(texto) &&
                        !factura.includes(texto)
                    ) {
                        mostrar = false;
                    }

                    //////////////////////////////////////////////////////
                    // HORARIO
                    //////////////////////////////////////////////////////

                    if (horario && horarioFila !== horario) {
                        mostrar = false;
                    }

                    //////////////////////////////////////////////////////
                    // PAGO
                    //////////////////////////////////////////////////////

                    if (pago && pagoFila !== pago) {
                        mostrar = false;
                    }

                    //////////////////////////////////////////////////////
                    // ESTADO
                    //////////////////////////////////////////////////////

                    if (estado && estadoFila !== estado) {
                        mostrar = false;
                    }

                    fila.style.display = mostrar ? "" : "none";
                });
        }

                //////////////////////////////////////////////////////
        // BUSCADOR GENERAL GLOBAL
        //////////////////////////////////////////////////////

        function buscarGeneral() {

            let texto =
                document.getElementById("buscadorFacturas")
                .value
                .trim();

            //////////////////////////////////////////////////////
            // SI VACÍO
            //////////////////////////////////////////////////////

            if (texto === "")
            {
                return;
            }

            //////////////////////////////////////////////////////
            // REDIRECT
            //////////////////////////////////////////////////////

            window.location.href =
                "/Facturacion?buscar=" +
                encodeURIComponent(texto);
        }

                //////////////////////////////////////////////////////
        // CANCELAR FACTURA
        //////////////////////////////////////////////////////

        function cancelarFactura(id) {

            if (!confirm("¿Deseas cancelar esta factura?"))
                return;

            fetch('/Facturacion/CancelarFactura?id=' + id, {

                method: 'POST'

            })

            .then(res => res.json())

            .then(r => {

                if (r === true)
                {
                    alert("Factura cancelada correctamente");

                    location.reload();
                }
                else
                {
                    alert(r);
                }

            })

            .catch(error => {

                console.log(error);

                alert("Ocurrió un error");
            });
        }

                //////////////////////////////////////////////////////
        // ELIMINAR DEFINITIVAMENTE
        //////////////////////////////////////////////////////

        function eliminarFactura(id) {

            //////////////////////////////////////////////////////
            // DOBLE CONFIRMACIÓN
            //////////////////////////////////////////////////////

            if (!confirm("⚠️ Esta factura será eliminada permanentemente"))
                return;

            if (!confirm("¿Seguro? Esta acción NO se puede deshacer"))
                return;

            //////////////////////////////////////////////////////
            // FETCH
            //////////////////////////////////////////////////////

            fetch('/Facturacion/EliminarFactura?id=' + id, {

                method: 'POST'

            })

            .then(res => res.json())

            .then(r => {

                if (r === true)
                {
                    alert("Factura eliminada correctamente");

                    location.reload();
                }
                else
                {
                    alert(r);
                }

            })

            .catch(error => {

                console.log(error);

                alert("Ocurrió un error");
            });
        }
        
                     //////////////////////////////////////////////////////
        // EDITAR FACTURA
        //////////////////////////////////////////////////////

        function editarFactura(id) {

            fetch('/Facturacion/ObtenerFactura?id=' + id)

            .then(res => res.json())

            .then(f => {

                //////////////////////////////////////////////////////
                // VALIDAR
                //////////////////////////////////////////////////////

                if (f === "No se puede editar")
                {
                    alert(f);
                    return;
                }

                //////////////////////////////////////////////////////
                // MODO EDICIÓN
                //////////////////////////////////////////////////////

                facturaEditando = f.idFactura;
                document.getElementById("lecturaInteligente")
    .style.display = "none";
            document.getElementById("buscarClienteBox")
            .style.display = "none";

document.getElementById("btnNuevaFactura")
    .style.display = "none";
                document.getElementById("nombreCliente").readOnly = true;

                //////////////////////////////////////////////////////
                // MOSTRAR FORM
                //////////////////////////////////////////////////////

                abrirFormulario();
                document.getElementById("nombreCliente").readOnly = false;

                //////////////////////////////////////////////////////
                // DATOS
                //////////////////////////////////////////////////////

                document.getElementById("nombreCliente").value =
                    f.nombreCliente || "";

                document.getElementById("telefono").value =
                    f.telefono || "";

                document.getElementById("direccion").value =
                    f.direccion || "";

                document.getElementById("departamento").value =
                    f.departamento || "";

                document.getElementById("municipio").value =
                    f.municipio || "";

                            document.getElementById("tienda").value =
            f.tienda || "";

                document.getElementById("comentario").value =
                    f.comentario || "";

                document.getElementById("horario").value =
                    f.horario || "TM";

                document.getElementById("horaExacta").value =
                    f.horaExacta || "";

                if (f.fechaEnvio)
                {
                    document.getElementById("fechaEnvio").value =
                        f.fechaEnvio.split('T')[0];
                }

                document.getElementById("envio").value =
                    f.envio;

                document.getElementById("valorDescuento").value =
                    f.descuento;

                //////////////////////////////////////////////////////
                // MÉTODO PAGO
                //////////////////////////////////////////////////////

                seleccionarPago(f.metodoPago);

                //////////////////////////////////////////////////////
                // LIMPIAR TABLA
                //////////////////////////////////////////////////////

                document.getElementById("tablaProductosFactura")
                    .innerHTML = "";

                //////////////////////////////////////////////////////
                // PRODUCTOS
                //////////////////////////////////////////////////////

                f.detalles.forEach(d => {

                            agregarProducto(
            d.idProducto,
            d.nombre,
            d.precio,
            d.imagen,
            d.stock + d.cantidad,
            d.idVariante || 0,
            d.variante || ""
        );

                    //////////////////////////////////////////////////////
                    // COLOCAR CANTIDAD REAL
                    //////////////////////////////////////////////////////

                    let input = document.querySelector(
                        `.cantidad[data-id="${d.idProducto}"]`
                    );

                    if (input)
                    {
                        input.value = d.cantidad;
                    }
                });

                actualizarSubtotal();

                //////////////////////////////////////////////////////
                // BOTÓN
                //////////////////////////////////////////////////////

                document.querySelector(
                    '.btn.btn-primary.w-100.mt-4'
                ).innerText = "Actualizar Factura";
            });
        }

