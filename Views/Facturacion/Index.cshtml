       //////////////////////////////////////////////////////
// LECTURA INTELIGENTE
//////////////////////////////////////////////////////

function procesarMensaje() {

    let texto =
        document.getElementById("mensajeIA")
        .value
        .trim();

    if (!texto)
    {
        alert("Pega un mensaje");
        return;
    }

    //////////////////////////////////////////////////////
    // NORMALIZAR
    //////////////////////////////////////////////////////

    let textoLower =
        texto.toLowerCase();

    //////////////////////////////////////////////////////
    // FECHA
    //////////////////////////////////////////////////////

    let fechaRegex =
        /(\d{1,2})\/(ene|feb|mar|abr|may|jun|jul|ago|sep|oct|nov|dic)\/(\d{4})/i;

    let fechaMatch =
        texto.match(fechaRegex);

    if (fechaMatch)
    {
        let dia =
            fechaMatch[1].padStart(2, '0');

        let mesTexto =
            fechaMatch[2].toLowerCase();

        let anio =
            fechaMatch[3];

        let meses = {
            ene: "01",
            feb: "02",
            mar: "03",
            abr: "04",
            may: "05",
            jun: "06",
            jul: "07",
            ago: "08",
            sep: "09",
            oct: "10",
            nov: "11",
            dic: "12"
        };

        let mes =
            meses[mesTexto];

        document.getElementById("fechaEnvio").value =
            `${anio}-${mes}-${dia}`;
    }

    //////////////////////////////////////////////////////
    // HORARIO
    //////////////////////////////////////////////////////

    if (textoLower.includes(" tm "))
    {
        document.getElementById("horario").value = "TM";
    }
    else if (textoLower.includes(" tt "))
    {
        document.getElementById("horario").value = "TT";
    }
    else if (textoLower.includes(" pr "))
    {
        document.getElementById("horario").value = "PR";
    }

    //////////////////////////////////////////////////////
    // TELEFONOS
    //////////////////////////////////////////////////////

    let telefonos =
        texto.match(/(\d{4}[- ]?\d{4})/g);

    if (telefonos && telefonos.length > 0)
    {
        let telefono =
            telefonos[0]
            .replace("-", "")
            .replace(" ", "");

        document.getElementById("telefono").value =
            telefono;
    }

    //////////////////////////////////////////////////////
    // LINEAS
    //////////////////////////////////////////////////////

    let lineas =
        texto.split("\n")
        .map(x => x.trim())
        .filter(x => x !== "");

    //////////////////////////////////////////////////////
    // NOMBRE
    //////////////////////////////////////////////////////

    let nombre = "";

    for (let linea of lineas)
    {
        let l =
            linea.toLowerCase();

        //////////////////////////////////////////////////
        // IGNORAR
        //////////////////////////////////////////////////

        if (
            l.includes("/") ||
            l.includes("$") ||
            l.includes("tm") ||
            l.includes("tt") ||
            l.includes("pr") ||
            /\d{4}/.test(l) ||
            l.includes("colonia") ||
            l.includes("calle") ||
            l.includes("pasaje") ||
            l.includes("casa") ||
            l.includes("block")
        )
        {
            continue;
        }

        //////////////////////////////////////////////////
        // POSIBLE NOMBRE
        //////////////////////////////////////////////////

        if (linea.length > 3)
        {
            nombre = linea;
            break;
        }
    }

    if (nombre)
    {
        document.getElementById("nombreCliente").value =
            nombre;
    }

    //////////////////////////////////////////////////////
    // DIRECCION
    //////////////////////////////////////////////////////

    let direccion = "";

    for (let linea of lineas)
    {
        let l =
            linea.toLowerCase();

        if (
            l.includes("colonia") ||
            l.includes("calle") ||
            l.includes("pasaje") ||
            l.includes("casa") ||
            l.includes("block") ||
            l.includes("avenida") ||
            l.includes("urb")
        )
        {
            direccion = linea;
            break;
        }
    }

    if (direccion)
    {
        document.getElementById("direccion").value =
            direccion;
    }

    //////////////////////////////////////////////////////
    // ALERTA
    //////////////////////////////////////////////////////

    alert("Datos procesados correctamente 🔥");
}

