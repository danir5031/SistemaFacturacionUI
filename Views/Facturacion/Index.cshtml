            //////////////////////////////////////////////////////

            document.getElementById("buscarCliente").value =
                nombre;

            document.getElementById("resultadoClientes").innerHTML =
                "";
        }

                //////////////////////////////////////////////////////
        // BUSCAR CLIENTES
        //////////////////////////////////////////////////////

        function buscarClientes(valor) {

            let contenedor =
                document.getElementById("resultadoClientes");

            contenedor.innerHTML = "";

            //////////////////////////////////////////////////////
            // VALIDAR
            //////////////////////////////////////////////////////

            if (valor.trim().length < 2)
            {
                return;
            }

            //////////////////////////////////////////////////////
            // FETCH
            //////////////////////////////////////////////////////

            fetch('/Facturacion/BuscarClientes?filtro=' +
                encodeURIComponent(valor))

            .then(res => res.json())

            .then(data => {

                //////////////////////////////////////////////////////
                // SIN RESULTADOS
                //////////////////////////////////////////////////////

                if (!data || data.length === 0)
                {
                    contenedor.innerHTML = `
                        <div class="alert alert-warning mt-2">
                            No se encontraron clientes
                        </div>
                    `;
                    return;
                }

                //////////////////////////////////////////////////////
                // RECORRER
                //////////////////////////////////////////////////////

                data.forEach(c => {

                    contenedor.innerHTML += `
                        <div class="card-box mb-2"
                             style="cursor:pointer; padding:12px;"
                             onclick="seleccionarCliente(
                                '${(c.nombre || '').replace(/'/g, "\\'")}',
                                '${(c.telefono || '').replace(/'/g, "\\'")}',
                                '${(c.direccion || '').replace(/'/g, "\\'")}'
                             )">

                            <b>${c.nombre}</b>
                            <br>
                            <small>${c.telefono}</small>
                            <br>
                            <small style="color:#64748b;">
                                ${c.direccion || ''}
                            </small>

                        </div>
                    `;
                });
            });
        }

