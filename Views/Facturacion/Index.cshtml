<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>

        let subtotalGlobal = 0;
        let metodoPago = "Efectivo";
        let facturaEditando = 0;

        //////////////////////////////////////////////////////
        // BUSCAR PRODUCTOS
        //////////////////////////////////////////////////////

                function buscarProducto(valor) {

            let tabla = document.getElementById("tablaProductosFactura");

            //////////////////////////////////////////////////////
            // LIMPIAR BÚSQUEDAS ANTERIORES
            //////////////////////////////////////////////////////

            document.querySelectorAll(".busqueda")
                .forEach(x => x.remove());

            //////////////////////////////////////////////////////
            // SI ESTÁ VACÍO
            //////////////////////////////////////////////////////

            if (valor.trim().length < 2)
                return;

            //////////////////////////////////////////////////////
            // FETCH
            //////////////////////////////////////////////////////

            fetch('/Facturacion/ObtenerProductos?filtro=' + encodeURIComponent(valor))

            .then(res => res.json())

            .then(data => {

                //////////////////////////////////////////////////////
                // SI NO HAY RESULTADOS
                //////////////////////////////////////////////////////

                if (!data || data.length === 0)
                {
                    tabla.innerHTML += `
                    <tr class="busqueda">

                        <td colspan="4"
                            style="color:#64748b;">

                            No se encontraron productos

                        </td>

                    </tr>
                    `;

                    return;
                }

                //////////////////////////////////////////////////////
                // RECORRER PRODUCTOS
                //////////////////////////////////////////////////////

                data.forEach(p => {

                    tabla.innerHTML += `
                    <tr class="busqueda"
                        style="cursor:pointer; background:#f8fafc;"
                                        onclick="agregarProducto(
            ${p.idProducto},
            '${p.nombre.replace(/'/g, "\\'")}',
            ${p.precioVenta},
            '${p.imagenUrl || ''}',
            ${p.stock},
            ${p.idVariante || 0},
                    '${(
            p.esVariante
            ? p.nombre.replace(/^.*? - /, '')
            : ''
        ).replace(/'/g, "\\'")}'
        )">

                        <td colspan="4">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    🔍 ${p.nombre}

                                    <br>

                                    <small style="color:#64748b;">
                                        Stock disponible: ${p.stock}
                                    </small>

                                </div>

                                <div>
                                    $${parseFloat(p.precioVenta).toFixed(2)}
                                </div>

                            </div>

                        </td>

                    </tr>
                    `;
                });

            })

            .catch(error => {

                console.log(error);

            });
        }

        //////////////////////////////////////////////////////
        // AGREGAR PRODUCTO
        //////////////////////////////////////////////////////

                function agregarProducto(
            id,
            nombre,
            precio,
            imagen,
            stock,
            idVariante = 0,
            variante = ""
        ) {

            //////////////////////////////////////////////////////
            // LIMPIAR
            //////////////////////////////////////////////////////

            document.querySelectorAll(".busqueda")
                .forEach(x => x.remove());

            document.getElementById("buscadorProducto").value = "";

            //////////////////////////////////////////////////////
            // VALIDAR EXISTE
            //////////////////////////////////////////////////////

            let inputExistente = document.querySelector(
                `.cantidad[data-id="${id}"][data-variante="${idVariante}"]`
            );

            if (inputExistente)
            {
                let actual = parseInt(inputExistente.value);

                if (actual < stock)
                {
                    inputExistente.value = actual + 1;
                }
                else
                {
                    alert("No hay más stock disponible");
                }

                actualizarSubtotal();

                return;
            }

            //////////////////////////////////////////////////////
            // ID ÚNICO
            //////////////////////////////////////////////////////

            let filaId =
                "fila_" + id + "_" + idVariante;

            //////////////////////////////////////////////////////
            // TABLA
            //////////////////////////////////////////////////////

            let tabla =
                document.getElementById("tablaProductosFactura");

            //////////////////////////////////////////////////////
            // HTML
            //////////////////////////////////////////////////////

            tabla.innerHTML += `

            <tr id="${filaId}">

                <td>

                    <div class="d-flex align-items-center gap-2">

                        <img src="${
                            imagen && imagen !== ''
                            ? imagen
                            : '/Producto/VerImagen/' + id
                        }"
                        width="40"
                        height="40"
                        style="
                            border-radius:8px;
                            object-fit:cover;
                        ">

                        <div>

                            ${nombre}

                            <br>

                            <small style="color:#64748b;">
                                Stock: ${stock}
                            </small>

                        </div>

                    </div>

                </td>

                <td>

                    <input type="number"
                           value="1"
                           min="1"
                           max="${stock}"

                           class="form-control cantidad"

                           data-id="${id}"

                           data-variante="${idVariante}"

                           data-nombrevariante="${variante}"

                           data-precio="${precio}"

                           style="width:80px;"

                           oninput="validarCantidad(this, ${stock})">

                </td>

                <td>

                    $${parseFloat(precio).toFixed(2)}

                </td>

                <td>

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            onclick="eliminarProducto('${filaId}')">

                        X

                    </button>

                </td>

            </tr>
            `;

            actualizarSubtotal();
        }

                function validarCantidad(input, stock) {

            let valor = parseInt(input.value) || 1;

            if (valor > stock)
            {
                input.value = stock;

                alert("Stock máximo disponible: " + stock);
            }

            if (valor < 1)
            {
                input.value = 1;
            }

            actualizarSubtotal();
        }

        //////////////////////////////////////////////////////
        // ELIMINAR PRODUCTO
        //////////////////////////////////////////////////////

                 function eliminarProducto(idFila) {

            let fila =
                document.getElementById(idFila);

            if (fila)
            {
                fila.remove();
            }

            actualizarSubtotal();
        }

        //////////////////////////////////////////////////////
        // SELECCIONAR PAGO
        //////////////////////////////////////////////////////

        function seleccionarPago(tipo) {

            metodoPago = tipo;

            document.getElementById("btnEfectivo")
                .classList.remove("active");

            document.getElementById("btnTransferencia")
                .classList.remove("active");

            if (tipo === "Efectivo")
            {
                document.getElementById("btnEfectivo")
                    .classList.add("active");
            }
            else
            {
                document.getElementById("btnTransferencia")
                    .classList.add("active");
            }
        }

        //////////////////////////////////////////////////////
        // SUBTOTAL
        //////////////////////////////////////////////////////

        function actualizarSubtotal() {

            let total = 0;

            document.querySelectorAll(".cantidad").forEach(input => {

                let cantidad = parseInt(input.value) || 0;

                let precio = parseFloat(input.dataset.precio) || 0;

                total += cantidad * precio;
            });

            subtotalGlobal = total;

            document.getElementById("subtotal").innerText =
                "$" + total.toFixed(2);

            calcularTotal();
        }

        //////////////////////////////////////////////////////
        // TOTAL
        //////////////////////////////////////////////////////

        function calcularTotal() {

            let envio =
                parseFloat(document.getElementById("envio").value) || 0;

            let tipo =
                document.getElementById("tipoDescuento").value;

            let valor =
                parseFloat(document.getElementById("valorDescuento").value) || 0;

            let descuento = 0;

            if (tipo === "porcentaje")
            {
                descuento = subtotalGlobal * (valor / 100);
            }

            if (tipo === "fijo")
            {
                descuento = valor;
            }

            let total = subtotalGlobal + envio - descuento;

            if (total < 0)
                total = 0;

            document.getElementById("totalFinal").innerText =
                "$" + total.toFixed(2);
        }

        //////////////////////////////////////////////////////
        // HORARIO
        //////////////////////////////////////////////////////

        function cambiarHorario() {

            let horario =
                document.getElementById("horario").value;

            let div =
                document.getElementById("horaExactaDiv");

            if (horario === "EXACTO")
            {
                div.style.display = "block";
            }
            else
            {
                div.style.display = "none";
            }
        }

        let idSolicitudFactura = null;

        //////////////////////////////////////////////////////
        // GUARDAR FACTURA
        //////////////////////////////////////////////////////

        function confirmarFactura() {

    const btn = document.getElementById("btnGuardarFactura");

    // Evitar doble clic
    if (btn.disabled)
        return;

    // =====================================================
    // PRODUCTOS
    // =====================================================

    let detalles = [];

    document.querySelectorAll(".cantidad").forEach(input => {

        detalles.push({
            IdProducto: parseInt(input.dataset.id),
            IdVariante: parseInt(input.dataset.variante) || null,
            Variante: input.dataset.nombrevariante || "",
            Cantidad: parseInt(input.value),
            Precio: parseFloat(input.dataset.precio)
        });

    });

    if (detalles.length === 0) {

        alert("Agrega productos");

        return;
    }


    // =====================================================
    // DEPARTAMENTO
    // =====================================================

    let departamento =
        document.getElementById("departamento").value.trim();

    if (departamento === "") {

        alert("Debes seleccionar un departamento.");

        document.getElementById("departamento").focus();

        return;
    }


    // =====================================================
    // MUNICIPIO
    // =====================================================

    let municipio =
        document.getElementById("municipio").value.trim();

    if (municipio === "") {

        alert("Debes ingresar el municipio.");

        document.getElementById("municipio").focus();

        return;
    }


    // =====================================================
    // FECHA
    // =====================================================

    const fechaSeleccionada =
        document.getElementById("fechaEnvio").value;

    const hoy = new Date();

    const fechaHoy =
        hoy.getFullYear() + "-" +
        String(hoy.getMonth() + 1).padStart(2, "0") + "-" +
        String(hoy.getDate()).padStart(2, "0");


    if (fechaSeleccionada && fechaSeleccionada < fechaHoy) {

        alert("No puedes seleccionar una fecha anterior al día de hoy.");

        return;
    }


    // =====================================================
    // GENERAR ID ÚNICO DE LA SOLICITUD
    // =====================================================

    if (facturaEditando === 0 && idSolicitudFactura === null) {

        if (window.crypto &&
            typeof window.crypto.randomUUID === "function") {

            idSolicitudFactura =
                window.crypto.randomUUID();

        } else {

            // Compatibilidad si el sitio está en HTTP
            idSolicitudFactura =
                'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'
                .replace(/[xy]/g, function (c) {

                    const r =
                        Math.random() * 16 | 0;

                    const v =
                        c === 'x'
                            ? r
                            : (r & 0x3 | 0x8);

                    return v.toString(16);
                });
        }
    }


    // =====================================================
    // DATOS
    // =====================================================

    let data = {

        IdFactura: facturaEditando,

        IdSolicitud:
            facturaEditando === 0
                ? idSolicitudFactura
                : null,

        NombreCliente:
            document.getElementById("nombreCliente").value,

        Telefono:
            document.getElementById("telefono").value,

        Direccion:
            document.getElementById("direccion").value,

        Referencia:
            document.getElementById("referencia").value,

        Departamento:
            document.getElementById("departamento").value,

        Municipio:
            document.getElementById("municipio").value,

            IdTienda:
    parseInt(document.getElementById("tienda").value) || null,

        //Tienda:
            //document.getElementById("tienda").value,

        Comentario:
            document.getElementById("comentario").value,

        Horario:
            document.getElementById("horario").value,

        HoraExacta:
            document.getElementById("horaExacta").value,

        FechaEnvio:
            fechaSeleccionada,

        Subtotal:
            subtotalGlobal,

        Envio:
            parseFloat(
                document.getElementById("envio").value
            ) || 0,

        Descuento:
            parseFloat(
                document.getElementById("valorDescuento").value
            ) || 0,

        Total:
            parseFloat(
                document.getElementById("totalFinal")
                    .innerText
                    .replace("$", "")
            ),

        MetodoPago:
            metodoPago,

        Estado:
            "Completada",

        Detalles:
            detalles
    };


    console.log("Factura a guardar:", data);


    // =====================================================
    // AHORA SÍ BLOQUEAMOS EL BOTÓN
    // =====================================================

    btn.disabled = true;

    btn.innerHTML = `
        <span class="spinner-border spinner-border-sm"></span>
        Guardando...
    `;


    // =====================================================
    // EDICIÓN
    // =====================================================

    if (facturaEditando > 0) {

        guardarNormal(data);

        return;
    }


    // =====================================================
    // VERIFICAR HISTORIAL DEL CLIENTE
    // =====================================================

    fetch(
        "/Facturacion/VerificarCliente?telefono=" +
        encodeURIComponent(data.Telefono)
    )

    .then(r => {

        if (!r.ok)
            throw new Error("Error al verificar cliente.");

        return r.json();
    })

    .then(info => {

        if (!info.mostrar) {

            guardarNormal(data);

            return;
        }


        mostrarHistorial(info);


        document.getElementById("btnContinuarFactura").onclick =
            function () {

                bootstrap.Modal.getInstance(
                    document.getElementById("modalHistorialCliente")
                ).hide();

                guardarNormal(data);
            };
    })

    .catch(error => {

        console.error(error);

        alert(
            "No se pudo verificar el historial del cliente."
        );

        btn.disabled = false;

        btn.innerHTML =
            "Confirmar e Imprimir Factura";
    });
}


                 function guardarNormal(data) {

    const btn =
        document.getElementById("btnGuardarFactura");


    const controlador =
        facturaEditando > 0
            ? "/Facturacion/ActualizarFactura"
            : "/Facturacion/GuardarFactura";


    const controller =
        new AbortController();

    const timeout =
        setTimeout(() => {
            controller.abort();
        }, 60000);


    fetch(controlador, {

        method: "POST",

        headers: {
            "Content-Type": "application/json"
        },

        body: JSON.stringify(data),

        signal: controller.signal
    })

    .then(res => {

        clearTimeout(timeout);

        if (!res.ok)
            throw new Error(
                "El servidor respondió con un error."
            );

        return res.json();
    })

    .then(r => {

        console.log("Respuesta:", r);


        if (r === true) {

            alert(
                "Factura guardada correctamente 🔥"
            );

            location.reload();

            return;
        }


        alert(
            "Error: " + r
        );


        btn.disabled = false;

        btn.innerHTML =
            "Confirmar e Imprimir Factura";
    })

    .catch(error => {

        clearTimeout(timeout);

        console.error(error);


        if (error.name === "AbortError") {

            alert(
                "El servidor está tardando demasiado. " +
                "La solicitud puede seguir procesándose. " +
                "Puedes esperar unos segundos antes de intentar nuevamente."
            );

        } else {

            alert(
                "Ocurrió un error al guardar la factura."
            );
        }


        btn.disabled = false;

        btn.innerHTML =
            "Confirmar e Imprimir Factura";
    });
}



