        document.getElementById("departamento")
    .addEventListener("change", function () {

        const departamento = this.value;

        const municipio =
            document.getElementById("municipio");

        // Limpiar municipios anteriores
        municipio.innerHTML = "";

        if (!departamento) {

            municipio.innerHTML =
                '<option value="">Primero selecciona un departamento</option>';

            $('#municipio').val(null).trigger('change');

            return;
        }

        const municipios =
            municipiosPorDepartamento[departamento] || [];

        // Opción inicial
        municipio.innerHTML =
            '<option value="">Seleccione un municipio</option>';

        // Agregar municipios
        municipios.forEach(function (nombre) {

            const option =
                document.createElement("option");

            option.value = nombre;
            option.textContent = nombre;

            municipio.appendChild(option);

        });

        // Actualizar Select2
        $('#municipio')
            .val(null)
            .trigger('change');

    });

    </script>