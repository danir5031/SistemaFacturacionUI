@using Microsoft.AspNetCore.Http
@model List<SistemaFacturacionUI.Models.Factura>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Facturación";

    var rol = Context.Session.GetString("rol");
}
<style>

    .productos-tooltip{

    position:relative;

    display:inline-flex;

    align-items:center;

    gap:6px;

    background:#1f2937;

    border:1px solid #374151;

    color:#60a5fa;

    padding:7px 12px;

    border-radius:10px;

    cursor:pointer;

    font-weight:600;

    transition:.2s;
}

.productos-tooltip:hover{

    background:#334155;
}

.tooltip-productos{

    display:none;

    position:absolute;

    top:42px;

    left:0;

    width:300px;

    background:#111827;

    border:1px solid #374151;

    border-radius:12px;

    padding:14px;

    box-shadow:0 15px 40px rgba(0,0,0,.35);

    z-index:999999;
}

.productos-tooltip:hover .tooltip-productos{

    display:block;
}

.tooltip-titulo{

    font-weight:bold;

    color:#93c5fd;

    margin-bottom:10px;

    border-bottom:1px solid #374151;

    padding-bottom:6px;
}

.producto-item{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:5px 0;

    color:white;
}

.cantidad{

    color:#60a5fa;

    font-weight:bold;
}
    
</style>

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h3>Facturas</h3>
        <p class="text-muted">Historial de ventas y pedidos.</p>
    </div>

    <button type="button"
        id="btnNuevaFactura"
        class="btn btn-primary"
        onclick="abrirFormulario()">

        + Nueva Factura

    </button>
</div>

<!-- ================= FORMULARIO ================= -->
<div id="formFactura" style="display:none;" class="mt-4">

    <h4>Crear Factura</h4>
    <p class="text-muted">Ingresa los datos manualmente o usa lectura inteligente.</p>

    <!-- LECTURA INTELIGENTE -->
    <div id="lecturaInteligente"
     class="card-box mb-3"
     style="background:#eef2ff; border:1px solid #dbeafe;">

        <label><b>⚡ Lectura Inteligente</b></label>

        <div class="d-flex gap-2 mt-2">

            <textarea id="mensajeIA"
                      class="form-control"
                      placeholder="Pega el mensaje del cliente aquí"></textarea>

            <button type="button"
                    class="btn btn-primary"
                    onclick="procesarMensaje()">

                Procesar

            </button>

        </div>

    </div>
    <!-- BUSCAR CLIENTE -->
    <div id="buscarClienteBox" class="mt-3">

        <label>Buscar Cliente Registrado</label>

        <input type="text"
               id="buscarCliente"
               class="form-control"
               placeholder="Buscar cliente por nombre o teléfono..."
               onkeyup="buscarClientes(this.value)" />

        <div id="resultadoClientes"
             class="mt-2"></div>

    </div>

    <div class="row">

        <!-- IZQUIERDA -->
        <div class="col-md-8">

            <div class="card-box mb-3">

                <h5>Datos del Envío</h5>

                <div class="mt-3">

                    <label>Nombre del Cliente</label>

                    <input id="nombreCliente"
                           class="form-control" />

                </div>

                <div class="row mt-2">

                    <div class="col-md-6">

                        <label>Teléfono</label>

                        <input id="telefono"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label>Horario</label>

                        <select id="horario"
                                class="form-control"
                                onchange="cambiarHorario()">

                            <option value="TM">TM</option>
                            <option value="TT">TT</option>
                            <option value="PR">PR</option>
                            <option value="EXACTO">Hora exacta</option>

                        </select>

                    </div>

                </div>

                <div id="horaExactaDiv"
                     class="mt-2"
                     style="display:none;">

                    <label>Hora exacta</label>

                    <input type="time"
                           id="horaExacta"
                           class="form-control" />

                </div>

                <div class="mt-2">

                    <label>Fecha de Envío</label>

                    <input type="date"
                           id="fechaEnvio"
                           class="form-control" />

                </div>

                <div class="mt-2">

                    <label>Dirección</label>

                    <textarea id="direccion"
                              class="form-control"></textarea>

                </div>

                <!-- NUEVOS CAMPOS -->
                <div class="row mt-2">

                    <div class="col-md-6">

                        <label>Departamento</label>

                        <select id="departamento"
                                class="form-control" required>

                            <option value="">Seleccione</option>

                            <option>San Salvador</option>
                            <option>La Libertad</option>
                            <option>Santa Ana</option>
                            <option>San Miguel</option>
                            <option>Sonsonate</option>
                            <option>Usulután</option>
                            <option>La Paz</option>
                            <option>Chalatenango</option>
                            <option>Ahuachapán</option>
                            <option>Cuscatlán</option>
                            <option>Morazán</option>
                            <option>Cabañas</option>
                            <option>San Vicente</option>
                            <option>La Unión</option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label>Municipio</label>

                        <input id="municipio"
                               class="form-control" required />

                    </div>

                    <div class="mt-2">

                        <label>🏪 Tienda</label>

                        <input id="tienda"
                               class="form-control"
                               maxlength="100"
                               placeholder="Ej. WMK o Zen" />

                    </div>

                </div>

                <div class="mt-2">

                    <label>Comentario</label>

                    <textarea id="comentario"
                              class="form-control"
                              rows="3"
                              placeholder="Comentario adicional de la entrega..."></textarea>

                </div>

            </div>

            <!-- PRODUCTOS -->
            <div class="card-box">

                <h5>Productos</h5>

                <input class="form-control mt-2"
                       id="buscadorProducto"
                       placeholder="Buscar producto para agregar..."
                       onkeyup="buscarProducto(this.value)" />
                <div class="table-responsive">
                    <table class="table mt-3">

                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody id="tablaProductosFactura">
                        </tbody>

                    </table>
                </div>
            </div>

        </div>

        <!-- DERECHA -->
        <div class="col-md-4">

            <div class="card-box">

                <h5>Resumen</h5>

                <div class="d-flex justify-content-between mt-3">

                    <span>Subtotal</span>

                    <span id="subtotal">$0.00</span>

                </div>

                <div class="d-flex justify-content-between mt-2">

                    <span>Envío</span>

                    <input type="number"
                           id="envio"
                           value="2.85"
                           step="0.01"
                           class="form-control"
                           style="width:100px"
                           oninput="calcularTotal()" />

                </div>

                <!-- DESCUENTO -->
                <div class="mt-3">

                    <label>Descuento</label>

                    <div class="d-flex gap-2">

                        <select id="tipoDescuento"
                                class="form-control"
                                onchange="calcularTotal()">

                            <option value="0">Sin</option>
                            <option value="porcentaje">%</option>
                            <option value="fijo">$</option>

                        </select>

                        <input type="number"
                               id="valorDescuento"
                               class="form-control"
                               placeholder="0"
                               step="0.01"
                               oninput="calcularTotal()" />

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <b>Total</b>

                    <h4 id="totalFinal">$0.00</h4>

                </div>

                <div class="mt-3">

                    <label>Método de Pago</label>

                    <div class="d-flex gap-2 mt-2">

                        <button type="button"
                                id="btnEfectivo"
                                class="btn btn-outline-primary w-50 active"
                                onclick="seleccionarPago('Efectivo')">

                            Efectivo

                        </button>

                        <button type="button"
                                id="btnTransferencia"
                                class="btn btn-outline-secondary w-50"
                                onclick="seleccionarPago('Transferencia')">

                            Transferencia

                        </button>

                    </div>

                </div>

                <button type="button"
                        class="btn btn-primary w-100 mt-4"
                        onclick="confirmarFactura()">

                    Confirmar e Imprimir Factura

                </button>

                <button type="button"
                        class="btn btn-light w-100 mt-2"
                        onclick="cancelar()">

                    Cancelar

                </button>

            </div>

        </div>

    </div>

</div>

<!-- ================= LISTA ================= -->
<div id="listaFacturas"
     class="card-box mt-3">

    <!-- 🔥 FILTROS -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">

        <!-- BUSCADOR -->
        <div style="min-width:320px;">

            <label class="mb-1 fw-semibold">
                Buscar
            </label>

            <div class="d-flex gap-2">

                <input id="buscadorFacturas"
                       class="form-control"
                       placeholder="Buscar nombre, teléfono o factura..."
                       onkeydown="detenerEnter(event)" />

                <button class="btn btn-primary"
                        type="button"
                        onclick="buscarGeneral()">

                    🔍

                </button>

                <button type="button"
                        class="btn btn-secondary"
                        onclick="limpiarBusqueda()">

                    ✖

                </button>

            </div>

        </div>

        <!-- FECHA ENVÍO -->
        <div style="min-width:180px;">

            <label class="mb-1 fw-semibold">
                Fecha Envío
            </label>

            <input type="date"
                   id="filtroFechaEnvio"
                   class="form-control"
                   onchange="filtrarPorFechaEnvio()" />

        </div>

        <!-- FECHA REGISTRO -->
        <!-- FECHA REGISTRO -->
        <div style="min-width:380px;">

            <label class="mb-1 fw-semibold">
                Fecha Registro
            </label>

            <div class="d-flex gap-2">

                <input type="date"
                       id="fechaInicioRegistro"
                       class="form-control" />

                <input type="date"
                       id="fechaFinRegistro"
                       class="form-control" />

                <button class="btn btn-primary"
                        type="button"
                        onclick="filtrarPorRangoRegistro()">

                    🔍

                </button>

            </div>

        </div>

        <!-- HORARIO -->
        <div style="min-width:140px;">

            <label class="mb-1 fw-semibold">
                Horario
            </label>

            <select id="filtroHorario"
                    class="form-control"
                    onchange="filtrarFacturas()">

                <option value="">Todos</option>
                <option value="TM">TM</option>
                <option value="TT">TT</option>
                <option value="PR">PR</option>
                <option value="EXACTO">Exacto</option>

            </select>

        </div>

        <!-- PAGO -->
        <div style="min-width:160px;">

            <label class="mb-1 fw-semibold">
                Pago
            </label>

            <select id="filtroPago"
                    class="form-control"
                    onchange="filtrarFacturas()">

                <option value="">Todos</option>
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>

            </select>

        </div>

        <!-- ESTADO -->
        <div style="min-width:160px;">

            <label class="mb-1 fw-semibold">
                Estado
            </label>

            <select id="filtroEstado"
                    class="form-control"
                    onchange="filtrarFacturas()">

                <option value="">Todos</option>
                <option value="Completada">Completada</option>
                <option value="Cancelada">Cancelada</option>

            </select>

        </div>

    </div>

    @if (rol == "ADMIN")
    {
        <div class="d-flex gap-2 mb-3">

            <button class="btn btn-dark"
                    onclick="generarEtiquetas()">

                🖨 Generar Etiquetas

            </button>

            <button class="btn btn-success"
                    onclick="exportarExcel()">

                📥 Exportar Excel

            </button>

            

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }
    <div class="table-responsive">
        <table class="table">

            <thead>
                <tr>
                    @if (rol == "ADMIN")
                    {
                        <th style="width:50px;">

                            <input type="checkbox"
                                   id="checkTodos"
                                   onclick="seleccionarTodos()" />

                        </th>
                    }
                    <th>Factura</th>

                    <th>Cliente</th>

                    @if (rol == "ADMIN")
{
    <th style="width:280px;">
        Productos
    </th>
}
                    <th>Teléfono</th>

                    <th>Usuario</th>

                    <th>Fecha Envío</th>

                    <th>Fecha Registro</th>

                    <th>Horario</th>

                    <th>Pago</th>

                    <th>Tienda</th>

                    <th>Estado</th>

                    <th>Total</th>
                    
                        <th style="width:50px; text-align:center;">
                            TQ
                        </th>

                    <th>Acciones</th>

                </tr>
            </thead>

            <tbody>

                @foreach (var f in Model)
                {
                    <tr data-cliente="@f.NombreCliente"
                        data-telefono="@f.Telefono"
                        data-factura="@f.NumeroFactura"
                        data-horario="@f.Horario"
                        data-pago="@f.MetodoPago"
                        data-estado="@f.Estado"
                         data-fechaenvio="@($"{f.FechaEnvio:yyyy-MM-dd}")">
                    
                        @if (rol == "ADMIN")
                        {
                            <td>

                                <input type="checkbox"
                                       class="checkFactura"
                                       value="@f.IdFactura" />

                            </td>
                        }
                        <!-- FACTURA -->
                        <td style="font-size:12px; max-width:120px;">

                            <span class="factura-badge">

                                @f.NumeroFactura

                            </span>

                        </td>

                        <!-- CLIENTE -->
                        <td>

                            @f.NombreCliente

                        </td>

                       @if (rol == "ADMIN")
{
    var lista = f.Detalles.ToList();

    <td>

    <div class="productos-tooltip">

        📦 @lista.Count producto@(lista.Count == 1 ? "" : "s")

        <div class="tooltip-productos">

            <div class="tooltip-titulo">
                Productos
            </div>

            @foreach (var p in lista)
            {
                <div class="producto-item">

                    <span>• @p.Producto?.Nombre</span>

                </div>
            }

        </div>

    </div>

</td>
}

                        <!-- TELÉFONO -->
                        <td>
                            @f.Telefono
                        </td>

                        <!-- USUARIO -->
                        <td>
                            @(f.Usuario != null ? f.Usuario.Usuario1 : "-")
                        </td>

                        <!-- FECHA ENVÍO -->
                        <td>

                            @(f.FechaEnvio.HasValue
                                ? f.FechaEnvio.Value.ToString("dd/MM/yyyy")
                                : "-")

                        </td>

                        <!-- FECHA REGISTRO -->
                        <td>

                            @f.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")

                        </td>


                        <!-- HORARIO -->
                        <td>

                            @if (f.Horario == "EXACTO")
                            {
                                <span>

                                    @f.HoraExacta

                                </span>
                            }
                            else
                            {
                                @f.Horario
                            }

                        </td>

                        <!-- MÉTODO PAGO -->
                        <td>

                            @if (f.MetodoPago == "Transferencia")
                            {
                                <span class="badge bg-primary">
                                    Transferencia
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Efectivo
                                </span>
                            }

                        </td>
                        <td>

                            @if (!string.IsNullOrWhiteSpace(f.Tienda))
                            {
                                <span class="badge bg-info text-dark">
                                    @f.Tienda
                                </span>
                            }
                            else
                            {
                                <span>-</span>
                            }

                        </td>

                        <!-- ESTADO -->
                        <td>

                            @if (f.Estado == "Cancelada")
                            {
                                <span class="badge bg-danger">
                                    Cancelada
                                </span>
                            }
                            else if (f.Estado == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pendiente
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Completada
                                </span>
                            }

                        </td>

                        <!-- TOTAL -->
                        <td>

                            $@f.Total

                        </td>
                        
                            <td style="text-align:center;">

                                @if (f.TicketGenerado)
                                {
                                    <span title="Ticket actualizado"
                                          style="
                                    width:15px;
                                    height:15px;
                                    background:#22c55e;
                                    border-radius:50%;
                                    display:inline-block;
                                    "></span>
                                }
                                else
                                {
                                    <span style="
                                    width:15px;
                                    height:15px;
                                    background:#ef4444;
                                    border-radius:50%;
                                    display:inline-block;
                                    "></span>
                                }

                            </td>
                        

                        <td>

                            <div class="d-flex gap-1 align-items-center">

                                <!-- VER -->
                                <a href="/Facturacion/Ticket/@f.IdFactura"
                                       target="_blank"
                                       class="btn btn-sm btn-dark">

                                    👁

                                </a>

                                <!-- EDITAR -->
                                <button class="btn btn-sm btn-warning"
                                        onclick="editarFactura(@f.IdFactura)">

                                    ✏️

                                </button>

                                <!-- CANCELAR -->
                                @if (rol == "ADMIN")
                                {
                                    @if (f.Estado != "Cancelada")
                                    {
                                        <button class="btn btn-sm btn-danger"
                                                onclick="cancelarFactura(@f.IdFactura)"
                                                title="Cancelar factura">

                                            🗑️

                                        </button>
                                    }
                                }

                                @if (Context.Session.GetString("usuario") == "admin")
                                {
                                    <button class="btn btn-sm btn-dark"
                                            onclick="eliminarFactura(@f.IdFactura)"
                                            title="Eliminar definitivamente">

                                        ❌

                                    </button>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    </div>
    @{

        var totalCanceladas = Model
    .Count(x => x.Estado == "Cancelada");

var montoCancelado = Model
    .Where(x => x.Estado == "Cancelada")
    .Sum(x => x.Total);

    var totalVentas = Model
        .Where(x => x.Estado != "Cancelada")
        .Sum(x => x.Total);

    var totalEnvios = Model
        .Where(x => x.Estado != "Cancelada")
        .Sum(x => x.Envio);

    var totalFacturas = Model
        .Count(x => x.Estado != "Cancelada");

    var totalEfectivo = Model
        .Where(x =>
            x.Estado != "Cancelada" &&
            x.MetodoPago == "Efectivo")
        .Sum(x => x.Total);

    var totalTransferencia = Model
        .Where(x =>
            x.Estado != "Cancelada" &&
            x.MetodoPago == "Transferencia")
        .Sum(x => x.Total);

        var ventasPorTienda = Model
    .Where(x =>
        x.Estado != "Cancelada" &&
        !string.IsNullOrWhiteSpace(x.Tienda))
    .GroupBy(x => x.Tienda.Trim().ToUpper())
    .Select(g => new
    {
        Nombre = g.First().Tienda.Trim(),
        Total = g.Sum(x => x.Total)
    })
    .OrderByDescending(x => x.Total)
    .ToList();

        var ventasPorUsuario = Model

    .Where(x =>
        x.Estado != "Cancelada" &&
        x.Usuario != null)

    .GroupBy(x => x.Usuario.Usuario1.Trim().ToUpper())

    .Select(g => new
    {
        Nombre = g.First().Usuario.Usuario1.Trim(),
        Total = g.Sum(x => x.Total),
        Cantidad = g.Count()
    })

    .OrderByDescending(x => x.Total)

    .ToList();


}
    @if (rol == "ADMIN")
    {
        <div class="row mt-3 g-2">

            <!-- FACTURAS -->
            <div class="col">
                <div class="card-box mini-resumen-card py-2 px-2 text-center">

                    <small class="d-block">
                        Facturas
                    </small>

                    <b>
                        @totalFacturas
                    </b>

                </div>
            </div>

            <!-- VENTAS -->
            <div class="col">
                <div class="card-box mini-resumen-card py-2 px-2 text-center">

                    <small class="d-block">
                        Ventas
                    </small>

                    <b class="text-success">
                        $@totalVentas.ToString("0.00")
                    </b>

                </div>
            </div>

            <!-- EFECTIVO -->
            <div class="col">
                <div class="card-box mini-resumen-card py-2 px-2 text-center">

                    <small class="d-block">
                        Efectivo
                    </small>

                    <b class="text-success">
                        $@totalEfectivo.ToString("0.00")
                    </b>

                </div>
            </div>

            <!-- TRANSFERENCIA -->
            <div class="col">
                <div class="card-box mini-resumen-card py-2 px-2 text-center">

                    <small class="d-block">
                        Transferencia
                    </small>

                    <b class="text-info">
                        $@totalTransferencia.ToString("0.00")
                    </b>

                </div>
            </div>

            <!-- ENVIOS -->
            <div class="col">
                <div class="card-box mini-resumen-card py-2 px-2 text-center">

                    <small class="d-block">
                        Envíos
                    </small>

                    <b class="text-primary">
                        $@totalEnvios.ToString("0.00")
                    </b>

                </div>
            </div>

            <!-- CANCELADOS -->
<div class="col">
    <div class="card-box mini-resumen-card py-2 px-2 text-center">

        <small class="d-block">
            ❌ Cancelados
        </small>

        <b class="text-danger" style="color:#dc2626;">
            $@montoCancelado.ToString("0.00")
        </b>

        <div style="font-size:11px;color:#9ca3af;">
            @totalCanceladas factura@(totalCanceladas == 1 ? "" : "s")
        </div>

    </div>
</div>

            @foreach (var tienda in ventasPorTienda)
            {
                <div class="col">

                    <div class="card-box mini-resumen-card py-2 px-2 text-center">

                        <small class="d-block">
                            🏪 @tienda.Nombre.ToUpper()
                        </small>

                        <b class="text-warning">
                            $@tienda.Total.ToString("0.00")
                        </b>

                    </div>

                </div>
            }

            @foreach (var usuario in ventasPorUsuario)
            {
                <div class="col">

                    <div class="card-box mini-resumen-card py-2 px-2 text-center">

                        <small class="d-block">
                            👤 @usuario.Nombre.ToUpper()
                        </small>

                        <b class="text-primary">
                            $@usuario.Total.ToString("0.00")
                        </b>

                        <div style="font-size:11px;color:#6b7280;">
                            @usuario.Cantidad factura@(usuario.Cantidad == 1 ? "" : "s")
                        </div>

                    </div>

                </div>
            }

        </div>
    }
</div>

<div class="modal fade"
