        function editarFactura(id) {

            fetch('/Facturacion/ObtenerFactura?id=' + id)

            .then(res => res.json())

            .then(f => {

                //////////////////////////////////////////////////////
                // VALIDAR
                //////////////////////////////////////////////////////

                if (f === "No se puede editar")
                {
                    alert(f);
                    return;
                }

                //////////////////////////////////////////////////////
                // MODO EDICIÓN
                //////////////////////////////////////////////////////

                facturaEditando = f.idFactura;
                document.getElementById("lecturaInteligente")
    .style.display = "none";
            document.getElementById("buscarClienteBox")
            .style.display = "none";

document.getElementById("btnNuevaFactura")
    .style.display = "none";
                document.getElementById("nombreCliente").readOnly = true;

                //////////////////////////////////////////////////////
                // MOSTRAR FORM
                //////////////////////////////////////////////////////

                abrirFormulario();
                document.getElementById("nombreCliente").readOnly = false;

                //////////////////////////////////////////////////////
                // DATOS
                //////////////////////////////////////////////////////

                document.getElementById("nombreCliente").value =
                    f.nombreCliente || "";

                document.getElementById("telefono").value =
                    f.telefono || "";

                document.getElementById("direccion").value =
                    f.direccion || "";

                document.getElementById("departamento").value =
                    f.departamento || "";

                document.getElementById("municipio").value =
                    f.municipio || "";

                document.getElementById("comentario").value =
                    f.comentario || "";

                document.getElementById("horario").value =
                    f.horario || "TM";

                document.getElementById("horaExacta").value =
                    f.horaExacta || "";

                if (f.fechaEnvio)
                {
                    document.getElementById("fechaEnvio").value =
                        f.fechaEnvio.split('T')[0];
                }

                document.getElementById("envio").value =
                    f.envio;

                document.getElementById("valorDescuento").value =
                    f.descuento;

                //////////////////////////////////////////////////////
                // MÉTODO PAGO
                //////////////////////////////////////////////////////

                seleccionarPago(f.metodoPago);

                //////////////////////////////////////////////////////
                // LIMPIAR TABLA
                //////////////////////////////////////////////////////

                document.getElementById("tablaProductosFactura")
                    .innerHTML = "";

                //////////////////////////////////////////////////////
                // PRODUCTOS
                //////////////////////////////////////////////////////

                f.detalles.forEach(d => {

                    agregarProducto(
                        d.idProducto,
                        d.nombre,
                        d.precio,
                        d.imagen,
                        d.stock + d.cantidad
                    );

                    //////////////////////////////////////////////////////
                    // COLOCAR CANTIDAD REAL
                    //////////////////////////////////////////////////////

                    let input = document.querySelector(
                        `.cantidad[data-id="${d.idProducto}"]`
                    );

                    if (input)
                    {
                        input.value = d.cantidad;
                    }
                });

                actualizarSubtotal();

                //////////////////////////////////////////////////////
                // BOTÓN
                //////////////////////////////////////////////////////

                document.querySelector(
                    '.btn.btn-primary.w-100.mt-4'
                ).innerText = "Actualizar Factura";
            });
        }

