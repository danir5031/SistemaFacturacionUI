@section Scripts {

    <script>

        let subtotalGlobal = 0;
        let metodoPago = "Efectivo";
        let facturaEditando = 0;

        //////////////////////////////////////////////////////
        // BUSCAR PRODUCTOS
        //////////////////////////////////////////////////////

                function buscarProducto(valor) {

            let tabla = document.getElementById("tablaProductosFactura");

            //////////////////////////////////////////////////////
            // LIMPIAR BÚSQUEDAS ANTERIORES
            //////////////////////////////////////////////////////

            document.querySelectorAll(".busqueda")
                .forEach(x => x.remove());

            //////////////////////////////////////////////////////
            // SI ESTÁ VACÍO
            //////////////////////////////////////////////////////

            if (valor.trim().length < 2)
                return;

            //////////////////////////////////////////////////////
            // FETCH
            //////////////////////////////////////////////////////

            fetch('/Facturacion/ObtenerProductos?filtro=' + encodeURIComponent(valor))

            .then(res => res.json())

            .then(data => {

                //////////////////////////////////////////////////////
                // SI NO HAY RESULTADOS
                //////////////////////////////////////////////////////

                if (!data || data.length === 0)
                {
                    tabla.innerHTML += `
                    <tr class="busqueda">

                        <td colspan="4"
                            style="color:#64748b;">

                            No se encontraron productos

                        </td>

                    </tr>
                    `;

                    return;
                }

                //////////////////////////////////////////////////////
                // RECORRER PRODUCTOS
                //////////////////////////////////////////////////////

                data.forEach(p => {

                    tabla.innerHTML += `
                    <tr class="busqueda"
                        style="cursor:pointer; background:#f8fafc;"
                                        onclick="agregarProducto(
            ${p.idProducto},
            '${p.nombre.replace(/'/g, "\\'")}',
            ${p.precioVenta},
            '${p.imagenUrl || ''}',
            ${p.stock},
            ${p.idVariante || 0},
                    '${(
            p.esVariante
            ? p.nombre.replace(/^.*? - /, '')
            : ''
        ).replace(/'/g, "\\'")}'
        )">

                        <td colspan="4">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    🔍 ${p.nombre}

                                    <br>

                                    <small style="color:#64748b;">
                                        Stock disponible: ${p.stock}
                                    </small>

                                </div>

                                <div>
                                    $${parseFloat(p.precioVenta).toFixed(2)}
                                </div>

                            </div>

                        </td>

                    </tr>
                    `;
                });

            })

            .catch(error => {

                console.log(error);

            });
        }

        //////////////////////////////////////////////////////
        // AGREGAR PRODUCTO
        //////////////////////////////////////////////////////

                function agregarProducto(
            id,
            nombre,
            precio,
            imagen,
            stock,
            idVariante = 0,
            variante = ""
        ) {

            //////////////////////////////////////////////////////
            // LIMPIAR
            //////////////////////////////////////////////////////

            document.querySelectorAll(".busqueda")
                .forEach(x => x.remove());

            document.getElementById("buscadorProducto").value = "";

            //////////////////////////////////////////////////////
            // VALIDAR EXISTE
            //////////////////////////////////////////////////////

            let inputExistente = document.querySelector(
                `.cantidad[data-id="${id}"][data-variante="${idVariante}"]`
            );

            if (inputExistente)
            {
                let actual = parseInt(inputExistente.value);

                if (actual < stock)
                {
                    inputExistente.value = actual + 1;
                }
                else
                {
                    alert("No hay más stock disponible");
                }

                actualizarSubtotal();

                return;
            }

            //////////////////////////////////////////////////////
            // ID ÚNICO
            //////////////////////////////////////////////////////

            let filaId =
                "fila_" + id + "_" + idVariante;

            //////////////////////////////////////////////////////
            // TABLA
            //////////////////////////////////////////////////////

            let tabla =
                document.getElementById("tablaProductosFactura");

            //////////////////////////////////////////////////////
            // HTML
            //////////////////////////////////////////////////////

            tabla.innerHTML += `

            <tr id="${filaId}">

                <td>

                    <div class="d-flex align-items-center gap-2">

                        <img src="${
                            imagen && imagen !== ''
                            ? imagen
                            : '/Producto/VerImagen/' + id
                        }"
                        width="40"
                        height="40"
                        style="
                            border-radius:8px;
                            object-fit:cover;
                        ">

                        <div>

                            ${nombre}

                            <br>

                            <small style="color:#64748b;">
                                Stock: ${stock}
                            </small>

                        </div>

                    </div>

                </td>

                <td>

                    <input type="number"
                           value="1"
                           min="1"
                           max="${stock}"

                           class="form-control cantidad"

                           data-id="${id}"

                           data-variante="${idVariante}"

                           data-nombrevariante="${variante}"

                           data-precio="${precio}"

                           style="width:80px;"

                           oninput="validarCantidad(this, ${stock})">

                </td>

                <td>

                    $${parseFloat(precio).toFixed(2)}

                </td>

                <td>

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            onclick="eliminarProducto('${filaId}')">

                        X

                    </button>

                </td>

            </tr>
            `;

            actualizarSubtotal();
        }

                function validarCantidad(input, stock) {

            let valor = parseInt(input.value) || 1;

            if (valor > stock)
            {
                input.value = stock;

                alert("Stock máximo disponible: " + stock);
            }

            if (valor < 1)
            {
                input.value = 1;
            }

            actualizarSubtotal();
        }

        //////////////////////////////////////////////////////
        // ELIMINAR PRODUCTO
        //////////////////////////////////////////////////////

                 function eliminarProducto(idFila) {

            let fila =
                document.getElementById(idFila);

            if (fila)
            {
                fila.remove();
            }

            actualizarSubtotal();
        }

        //////////////////////////////////////////////////////
        // SELECCIONAR PAGO
        //////////////////////////////////////////////////////

        function seleccionarPago(tipo) {

            metodoPago = tipo;

            document.getElementById("btnEfectivo")
                .classList.remove("active");

            document.getElementById("btnTransferencia")
                .classList.remove("active");

            if (tipo === "Efectivo")
            {
                document.getElementById("btnEfectivo")
                    .classList.add("active");
            }
            else
            {
                document.getElementById("btnTransferencia")
                    .classList.add("active");
            }
        }

        //////////////////////////////////////////////////////
        // SUBTOTAL
        //////////////////////////////////////////////////////

        function actualizarSubtotal() {

            let total = 0;

            document.querySelectorAll(".cantidad").forEach(input => {

                let cantidad = parseInt(input.value) || 0;

                let precio = parseFloat(input.dataset.precio) || 0;

                total += cantidad * precio;
            });

            subtotalGlobal = total;

            document.getElementById("subtotal").innerText =
                "$" + total.toFixed(2);

            calcularTotal();
        }

        //////////////////////////////////////////////////////
        // TOTAL
        //////////////////////////////////////////////////////

        function calcularTotal() {

            let envio =
                parseFloat(document.getElementById("envio").value) || 0;

            let tipo =
                document.getElementById("tipoDescuento").value;

            let valor =
                parseFloat(document.getElementById("valorDescuento").value) || 0;

            let descuento = 0;

            if (tipo === "porcentaje")
            {
                descuento = subtotalGlobal * (valor / 100);
            }

            if (tipo === "fijo")
            {
                descuento = valor;
            }

            let total = subtotalGlobal + envio - descuento;

            if (total < 0)
                total = 0;

            document.getElementById("totalFinal").innerText =
                "$" + total.toFixed(2);
        }

        //////////////////////////////////////////////////////
        // HORARIO
        //////////////////////////////////////////////////////

        function cambiarHorario() {

            let horario =
                document.getElementById("horario").value;

            let div =
                document.getElementById("horaExactaDiv");

            if (horario === "EXACTO")
            {
                div.style.display = "block";
            }
            else
            {
                div.style.display = "none";
            }
        }



        //////////////////////////////////////////////////////
        // GUARDAR FACTURA
        //////////////////////////////////////////////////////

        function confirmarFactura() {

            let detalles = [];

            document.querySelectorAll(".cantidad").forEach(input => {

                        detalles.push({

            IdProducto: parseInt(input.dataset.id),

            IdVariante: parseInt(input.dataset.variante) || null,

            Variante: input.dataset.nombrevariante || "",

            Cantidad: parseInt(input.value),

            Precio: parseFloat(input.dataset.precio)

        });

            });

            if (detalles.length === 0)
            {
                alert("Agrega productos");
                return;
            }

                    //////////////////////////////////////////////////////
        // VALIDAR DEPARTAMENTO
        //////////////////////////////////////////////////////

        let departamento =
            document.getElementById("departamento").value.trim();

        if (departamento === "")
        {
            alert("Debes seleccionar un departamento.");

