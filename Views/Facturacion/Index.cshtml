@using Microsoft.AspNetCore.Http
@model List<SistemaFacturacionUI.Models.Factura>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Facturación";

    var rol = Context.Session.GetString("rol");
}

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h3>Facturas</h3>
        <p class="text-muted">Historial de ventas y pedidos.</p>
    </div>

    <button type="button"
        id="btnNuevaFactura"
        class="btn btn-primary"
        onclick="abrirFormulario()">

        + Nueva Factura

    </button>
</div>

<!-- ================= FORMULARIO ================= -->
<div id="formFactura" style="display:none;" class="mt-4">

    <h4>Crear Factura</h4>
    <p class="text-muted">Ingresa los datos manualmente o usa lectura inteligente.</p>

    <!-- LECTURA INTELIGENTE -->
    <div id="lecturaInteligente"
     class="card-box mb-3"
     style="background:#eef2ff; border:1px solid #dbeafe;">

        <label><b>⚡ Lectura Inteligente</b></label>

        <div class="d-flex gap-2 mt-2">

            <textarea id="mensajeIA"
                      class="form-control"
                      placeholder="Pega el mensaje del cliente aquí"></textarea>

            <button type="button"
                    class="btn btn-primary"
                    onclick="procesarMensaje()">

                Procesar

            </button>

        </div>

    </div>
    <!-- BUSCAR CLIENTE -->
    <div id="buscarClienteBox" class="mt-3">

        <label>Buscar Cliente Registrado</label>

        <input type="text"
               id="buscarCliente"
               class="form-control"
               placeholder="Buscar cliente por nombre o teléfono..."
               onkeyup="buscarClientes(this.value)" />

        <div id="resultadoClientes"
             class="mt-2"></div>

    </div>

    <div class="row">

        <!-- IZQUIERDA -->
        <div class="col-md-8">

            <div class="card-box mb-3">

                <h5>Datos del Envío</h5>

                <div class="mt-3">

                    <label>Nombre del Cliente</label>

                    <input id="nombreCliente"
                           class="form-control" />

                </div>

                <div class="row mt-2">

                    <div class="col-md-6">

                        <label>Teléfono</label>

                        <input id="telefono"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label>Horario</label>

                        <select id="horario"
                                class="form-control"
                                onchange="cambiarHorario()">

                            <option value="TM">TM</option>
                            <option value="TT">TT</option>
                            <option value="PR">PR</option>
                            <option value="EXACTO">Hora exacta</option>

                        </select>

                    </div>

                </div>

                <div id="horaExactaDiv"
                     class="mt-2"
                     style="display:none;">

                    <label>Hora exacta</label>

                    <input type="time"
                           id="horaExacta"
                           class="form-control" />

                </div>

                <div class="mt-2">

                    <label>Fecha de Envío</label>

                    <input type="date"
                           id="fechaEnvio"
                           class="form-control" />

                </div>

                <div class="mt-2">

                    <label>Dirección</label>

                    <textarea id="direccion"
                              class="form-control"></textarea>

                </div>

                <!-- NUEVOS CAMPOS -->
                <div class="row mt-2">

                    <div class="col-md-6">

                        <label>Departamento</label>

                        <select id="departamento"
                                class="form-control">

                            <option value="">Seleccione</option>

                            <option>San Salvador</option>
                            <option>La Libertad</option>
                            <option>Santa Ana</option>
                            <option>San Miguel</option>
                            <option>Sonsonate</option>
                            <option>Usulután</option>
                            <option>La Paz</option>
                            <option>Chalatenango</option>
                            <option>Ahuachapán</option>
                            <option>Cuscatlán</option>
                            <option>Morazán</option>
                            <option>Cabañas</option>
                            <option>San Vicente</option>
                            <option>La Unión</option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label>Municipio</label>

                        <input id="municipio"
                               class="form-control" />

                    </div>

                </div>
                <div class="mt-2">

                    <label>Comentario</label>

                    <textarea id="comentario"
                              class="form-control"
                              rows="3"
                              placeholder="Comentario adicional de la entrega..."></textarea>

                </div>

            </div>

            <!-- PRODUCTOS -->
            <div class="card-box">

                <h5>Productos</h5>

                <input class="form-control mt-2"
                       id="buscadorProducto"
                       placeholder="Buscar producto para agregar..."
                       onkeyup="buscarProducto(this.value)" />

                <table class="table mt-3">

                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody id="tablaProductosFactura">
                    </tbody>

                </table>

            </div>

        </div>

        <!-- DERECHA -->
        <div class="col-md-4">

            <div class="card-box">

                <h5>Resumen</h5>

                <div class="d-flex justify-content-between mt-3">

                    <span>Subtotal</span>

                    <span id="subtotal">$0.00</span>

                </div>

                <div class="d-flex justify-content-between mt-2">

                    <span>Envío</span>

                    <input type="number"
                           id="envio"
                           value="2.85"
                           step="0.01"
                           class="form-control"
                           style="width:100px"
                           oninput="calcularTotal()" />

                </div>

                <!-- DESCUENTO -->
                <div class="mt-3">

                    <label>Descuento</label>

                    <div class="d-flex gap-2">

                        <select id="tipoDescuento"
                                class="form-control"
                                onchange="calcularTotal()">

                            <option value="0">Sin</option>
                            <option value="porcentaje">%</option>
                            <option value="fijo">$</option>

                        </select>

                        <input type="number"
                               id="valorDescuento"
                               class="form-control"
                               placeholder="0"
                               step="0.01"
                               oninput="calcularTotal()" />

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <b>Total</b>

                    <h4 id="totalFinal">$0.00</h4>

                </div>

                <div class="mt-3">

                    <label>Método de Pago</label>

                    <div class="d-flex gap-2 mt-2">

                        <button type="button"
                                id="btnEfectivo"
                                class="btn btn-outline-primary w-50 active"
                                onclick="seleccionarPago('Efectivo')">

                            Efectivo

                        </button>

                        <button type="button"
                                id="btnTransferencia"
                                class="btn btn-outline-secondary w-50"
                                onclick="seleccionarPago('Transferencia')">

                            Transferencia

                        </button>

                    </div>

                </div>

                <button type="button"
                        class="btn btn-primary w-100 mt-4"
                        onclick="confirmarFactura()">

                    Confirmar e Imprimir Factura

                </button>

                <button type="button"
                        class="btn btn-light w-100 mt-2"
                        onclick="cancelar()">

                    Cancelar

                </button>

            </div>

        </div>

    </div>

</div>

<!-- ================= LISTA ================= -->
<div id="listaFacturas"
     class="card-box mt-3">

    <!-- 🔥 FILTROS -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">

        <!-- BUSCADOR -->
        <div style="min-width:320px;">

            <label class="mb-1 fw-semibold">
                Buscar
            </label>

            <div class="d-flex gap-2">

                <input id="buscadorFacturas"
                       class="form-control"
                       placeholder="Buscar nombre, teléfono o factura..."
                       onkeydown="detenerEnter(event)" />

                <button class="btn btn-primary"
                        type="button"
                        onclick="buscarGeneral()">

                    🔍

                </button>

                <button type="button"
                        class="btn btn-secondary"
                        onclick="limpiarBusqueda()">

                    ✖

                </button>

            </div>

        </div>

        <!-- FECHA ENVÍO -->
        <div style="min-width:180px;">

            <label class="mb-1 fw-semibold">
                Fecha Envío
            </label>

            <input type="date"
                   id="filtroFechaEnvio"
                   class="form-control"
                   oninput="filtrarPorFechaEnvio()" />

        </div>

        <!-- FECHA REGISTRO -->
        <!-- FECHA REGISTRO -->
        <div style="min-width:380px;">

            <label class="mb-1 fw-semibold">
                Fecha Registro
            </label>

            <div class="d-flex gap-2">

                <input type="date"
                       id="fechaInicioRegistro"
                       class="form-control" />

                <input type="date"
                       id="fechaFinRegistro"
                       class="form-control" />

                <button class="btn btn-primary"
                        type="button"
                        onclick="filtrarPorRangoRegistro()">

                    🔍

                </button>

            </div>

        </div>

        <!-- HORARIO -->
        <div style="min-width:140px;">

            <label class="mb-1 fw-semibold">
                Horario
            </label>

            <select id="filtroHorario"
                    class="form-control"
                    onchange="filtrarFacturas()">

                <option value="">Todos</option>
                <option value="TM">TM</option>
                <option value="TT">TT</option>
                <option value="PR">PR</option>
                <option value="EXACTO">Exacto</option>

            </select>

        </div>

        <!-- PAGO -->
        <div style="min-width:160px;">

            <label class="mb-1 fw-semibold">
                Pago
            </label>

            <select id="filtroPago"
                    class="form-control"
                    onchange="filtrarFacturas()">

                <option value="">Todos</option>
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>

            </select>

        </div>

        <!-- ESTADO -->
        <div style="min-width:160px;">

            <label class="mb-1 fw-semibold">
                Estado
            </label>

            <select id="filtroEstado"
                    class="form-control"
                    onchange="filtrarFacturas()">

                <option value="">Todos</option>
                <option value="Completada">Completada</option>
                <option value="Cancelada">Cancelada</option>

            </select>

        </div>

    </div>

    @if (rol == "ADMIN")
    {
        <div class="d-flex gap-2 mb-3">

            <button class="btn btn-dark"
                    onclick="generarEtiquetas()">

                🖨 Generar Etiquetas

            </button>

            <button class="btn btn-success"
                    onclick="exportarExcel()">

                📥 Exportar Excel

            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }

    <table class="table">

        <thead>
            <tr>
                @if (rol == "ADMIN")
                {
                    <th style="width:50px;">

                        <input type="checkbox"
                               id="checkTodos"
                               onclick="seleccionarTodos()" />

                    </th>
                }
                <th>Factura</th>

                <th>Cliente</th>
                <th>Teléfono</th>

                <th>Usuario</th>

                <th>Fecha Envío</th>

                <th>Fecha Registro</th>

                <th>Horario</th>

                <th>Pago</th>

                <th>Estado</th>

                <th>Total</th>
                @if (rol == "ADMIN")
                {
                    <th style="width:50px; text-align:center;">
                        TQ
                    </th>
                }

                <th>Acciones</th>

            </tr>
        </thead>

        <tbody>

            @foreach (var f in Model)
            {
                <tr data-cliente="@f.NombreCliente"
                    data-telefono="@f.Telefono"
                    data-factura="@f.NumeroFactura"
                    data-horario="@f.Horario"
                    data-pago="@f.MetodoPago"
                    data-estado="@f.Estado"
                    data-fechaenvio="@(f.FechaEnvio.HasValue ? f.FechaEnvio.Value.ToString("yyyy-MM-dd") : "")">
                    
                    @if (rol == "ADMIN")
                    {
                        <td>

                            <input type="checkbox"
                                   class="checkFactura"
                                   value="@f.IdFactura" />

                        </td>
                    }
                    <!-- FACTURA -->
                    <td style="font-size:12px; max-width:120px;">

                        <span style="
                            background:#f1f5f9;
                            padding:4px 8px;
                            border-radius:8px;
                            font-size:11px;
                            color:#475569;
                            display:inline-block;">

                            @f.NumeroFactura

                        </span>

                    </td>

                    <!-- CLIENTE -->
                    <td>

                        @f.NombreCliente

                    </td>
                    <!-- TELÉFONO -->
                    <td>
                        @f.Telefono
                    </td>

                    <!-- USUARIO -->
                    <td>
                        @(f.Usuario != null ? f.Usuario.Usuario1 : "-")
                    </td>

                    <!-- FECHA ENVÍO -->
                    <td>

                        @(f.FechaEnvio.HasValue
                            ? f.FechaEnvio.Value.ToString("dd/MM/yyyy")
                            : "-")

                    </td>

                    <!-- FECHA REGISTRO -->
                    <td>

                        @f.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")

                    </td>

                    <!-- HORARIO -->
                    <td>

                        @if (f.Horario == "EXACTO")
                        {
                            <span>

                                @f.HoraExacta

                            </span>
                        }
                        else
                        {
                            @f.Horario
                        }

                    </td>

                    <!-- MÉTODO PAGO -->
                    <td>

                        @if (f.MetodoPago == "Transferencia")
                        {
                            <span class="badge bg-primary">
                                Transferencia
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Efectivo
                            </span>
                        }

                    </td>

                    <!-- ESTADO -->
                    <td>

                        @if (f.Estado == "Cancelada")
                        {
                            <span class="badge bg-danger">
                                Cancelada
                            </span>
                        }
                        else if (f.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning text-dark">
                                Pendiente
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Completada
                            </span>
                        }

                    </td>

                    <!-- TOTAL -->
                    <td>

                        $@f.Total

                    </td>
                    @if (rol == "ADMIN")
                    {
                        <td style="text-align:center;">

                            @if (f.TicketGenerado)
                            {
                                <span style="
                                width:15px;
                                height:15px;
                                background:#22c55e;
                                border-radius:50%;
                                display:inline-block;
                                "></span>
                            }
                            else
                            {
                                <span style="
                                width:15px;
                                height:15px;
                                background:#ef4444;
                                border-radius:50%;
                                display:inline-block;
                                "></span>
                            }

                        </td>
                    }

                    <td>

                        <div class="d-flex gap-1 align-items-center">

                            <!-- VER -->
                            <a href="/Facturacion/Ticket/@f.IdFactura"
                                   target="_blank"
                                   class="btn btn-sm btn-dark">

                                👁

                            </a>

                            <!-- EDITAR -->
                            <button class="btn btn-sm btn-warning"
                                    onclick="editarFactura(@f.IdFactura)">

                                ✏️

                            </button>

                            <!-- CANCELAR -->
                            @if (rol == "ADMIN")
                            {
                                @if (f.Estado != "Cancelada")
                                {
                                    <button class="btn btn-sm btn-danger"
                                            onclick="cancelarFactura(@f.IdFactura)">

                                        🗑️

                                    </button>
                                }
                            }

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        let subtotalGlobal = 0;
        let metodoPago = "Efectivo";
        let facturaEditando = 0;

        //////////////////////////////////////////////////////
        // BUSCAR PRODUCTOS
        //////////////////////////////////////////////////////

                function buscarProducto(valor) {

            let tabla = document.getElementById("tablaProductosFactura");

            //////////////////////////////////////////////////////
            // LIMPIAR BÚSQUEDAS ANTERIORES
            //////////////////////////////////////////////////////

            document.querySelectorAll(".busqueda")
                .forEach(x => x.remove());

            //////////////////////////////////////////////////////
            // SI ESTÁ VACÍO
            //////////////////////////////////////////////////////

            if (valor.trim().length < 2)
                return;

            //////////////////////////////////////////////////////
            // FETCH
            //////////////////////////////////////////////////////

            fetch('/Facturacion/ObtenerProductos?filtro=' + encodeURIComponent(valor))

            .then(res => res.json())

            .then(data => {

                //////////////////////////////////////////////////////
                // SI NO HAY RESULTADOS
                //////////////////////////////////////////////////////

                if (!data || data.length === 0)
                {
                    tabla.innerHTML += `
                    <tr class="busqueda">

                        <td colspan="4"
                            style="color:#64748b;">

                            No se encontraron productos

                        </td>

                    </tr>
                    `;

                    return;
                }

                //////////////////////////////////////////////////////
                // RECORRER PRODUCTOS
                //////////////////////////////////////////////////////

                data.forEach(p => {

                    tabla.innerHTML += `
                    <tr class="busqueda"
                        style="cursor:pointer; background:#f8fafc;"
                        onclick="agregarProducto(
                            ${p.idProducto},
                            '${p.nombre.replace(/'/g, "\\'")}',
                            ${p.precioVenta},
                            '${p.imagenUrl || ''}',
                            ${p.stock}
                        )">

                        <td colspan="4">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    🔍 ${p.nombre}

                                    <br>

                                    <small style="color:#64748b;">
                                        Stock disponible: ${p.stock}
                                    </small>

                                </div>

                                <div>
                                    $${parseFloat(p.precioVenta).toFixed(2)}
                                </div>

                            </div>

                        </td>

                    </tr>
                    `;
                });

            })

            .catch(error => {

                console.log(error);

            });
        }

        //////////////////////////////////////////////////////
        // AGREGAR PRODUCTO
        //////////////////////////////////////////////////////

                function agregarProducto(id, nombre, precio, imagen, stock) {

            //////////////////////////////////////////////////////
            // LIMPIAR BÚSQUEDA
            //////////////////////////////////////////////////////

            document.querySelectorAll(".busqueda")
                .forEach(x => x.remove());

            document.getElementById("buscadorProducto").value = "";

            //////////////////////////////////////////////////////
            // VALIDAR EXISTE
            //////////////////////////////////////////////////////

            let inputExistente = document.querySelector(`.cantidad[data-id="${id}"]`);

            if (inputExistente)
            {
                let actual = parseInt(inputExistente.value);

                if (actual < stock)
                {
                    inputExistente.value = actual + 1;
                }
                else
                {
                    alert("No hay más stock disponible");
                }

                actualizarSubtotal();

                return;
            }

            //////////////////////////////////////////////////////
            // AGREGAR FILA
            //////////////////////////////////////////////////////

            let tabla = document.getElementById("tablaProductosFactura");

            tabla.innerHTML += `
            <tr id="fila_${id}">

                <td>

                    <div class="d-flex align-items-center gap-2">

                        <img src="${imagen && imagen !== '' ? imagen : '/Producto/VerImagen/' + id}"
                             width="40"
                             height="40"
                             style="border-radius:8px; object-fit:cover;">

                        <div>

                            ${nombre}

                            <br>

                            <small style="color:#64748b;">
                                Stock: ${stock}
                            </small>

                        </div>

                    </div>

                </td>

                <td>

                    <input type="number"
                           value="1"
                           min="1"
                           max="${stock}"
                           class="form-control cantidad"
                           data-id="${id}"
                           data-precio="${precio}"
                           style="width:80px;"
                           oninput="validarCantidad(this, ${stock})">

                </td>

                <td>

                    $${parseFloat(precio).toFixed(2)}

                </td>

                <td>

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            onclick="eliminarProducto(${id})">

                        X

                    </button>

                </td>

            </tr>
            `;

            actualizarSubtotal();
        }

                function validarCantidad(input, stock) {

            let valor = parseInt(input.value) || 1;

            if (valor > stock)
            {
                input.value = stock;

                alert("Stock máximo disponible: " + stock);
            }

            if (valor < 1)
            {
                input.value = 1;
            }

            actualizarSubtotal();
        }

        //////////////////////////////////////////////////////
        // ELIMINAR PRODUCTO
        //////////////////////////////////////////////////////

                function eliminarProducto(id) {

            let fila = document.getElementById("fila_" + id);

            if (fila)
            {
                fila.remove();
            }

            //////////////////////////////////////////////////////
            // LIMPIAR BÚSQUEDA BUG
            //////////////////////////////////////////////////////

            document.querySelectorAll(".busqueda")
                .forEach(x => x.remove());

            document.getElementById("buscadorProducto").value = "";

            actualizarSubtotal();
        }

        //////////////////////////////////////////////////////
        // SELECCIONAR PAGO
        //////////////////////////////////////////////////////

        function seleccionarPago(tipo) {

            metodoPago = tipo;

            document.getElementById("btnEfectivo")
                .classList.remove("active");

            document.getElementById("btnTransferencia")
                .classList.remove("active");

            if (tipo === "Efectivo")
            {
                document.getElementById("btnEfectivo")
                    .classList.add("active");
            }
            else
            {
                document.getElementById("btnTransferencia")
                    .classList.add("active");
            }
        }

        //////////////////////////////////////////////////////
        // SUBTOTAL
        //////////////////////////////////////////////////////

        function actualizarSubtotal() {

            let total = 0;

            document.querySelectorAll(".cantidad").forEach(input => {

                let cantidad = parseInt(input.value) || 0;

                let precio = parseFloat(input.dataset.precio) || 0;

                total += cantidad * precio;
            });

            subtotalGlobal = total;

            document.getElementById("subtotal").innerText =
                "$" + total.toFixed(2);

            calcularTotal();
        }

        //////////////////////////////////////////////////////
        // TOTAL
        //////////////////////////////////////////////////////

        function calcularTotal() {

            let envio =
                parseFloat(document.getElementById("envio").value) || 0;

            let tipo =
                document.getElementById("tipoDescuento").value;

            let valor =
                parseFloat(document.getElementById("valorDescuento").value) || 0;

            let descuento = 0;

            if (tipo === "porcentaje")
            {
                descuento = subtotalGlobal * (valor / 100);
            }

            if (tipo === "fijo")
            {
                descuento = valor;
            }

            let total = subtotalGlobal + envio - descuento;

            if (total < 0)
                total = 0;

            document.getElementById("totalFinal").innerText =
                "$" + total.toFixed(2);
        }

        //////////////////////////////////////////////////////
        // HORARIO
        //////////////////////////////////////////////////////

        function cambiarHorario() {

            let horario =
                document.getElementById("horario").value;

            let div =
                document.getElementById("horaExactaDiv");

            if (horario === "EXACTO")
            {
                div.style.display = "block";
            }
            else
            {
                div.style.display = "none";
            }
        }



        //////////////////////////////////////////////////////
        // GUARDAR FACTURA
        //////////////////////////////////////////////////////

        function confirmarFactura() {

            let detalles = [];

            document.querySelectorAll(".cantidad").forEach(input => {

                detalles.push({

                    IdProducto: parseInt(input.dataset.id),

                    Cantidad: parseInt(input.value),

                    Precio: parseFloat(input.dataset.precio)

                });

            });

            if (detalles.length === 0)
            {
                alert("Agrega productos");
                return;
            }

            let data = {
                 IdFactura: facturaEditando,

                NombreCliente:
                    document.getElementById("nombreCliente").value,

