@model List<SistemaFacturacionUI.Models.Cliente>
@using Microsoft.AspNetCore.Http
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h3>Clientes</h3>
        <p class="text-muted">Gestiona el directorio de tus clientes.</p>
    </div>

    <div>
        <button class="btn btn-primary" onclick="abrirNuevo()">+ Nuevo Cliente</button>
        @if (Context.Session.GetString("rol") == "ADMIN")
        {
            <button class="btn btn-danger"
                    onclick="eliminarSeleccionados()">

                🗑️

            </button>
        }
        @if (Context.Session.GetString("rol") == "ADMIN")
        {
            <a href="/Cliente/Eliminados" class="btn btn-outline-danger w-100 mt-2">
                🗑️ Eliminados
            </a>
        }
    </div>
</div>

<div class="card-box mt-3">

    <!-- 🔍 BUSCADOR -->
    <input id="buscador" class="form-control mb-3"
           placeholder="Buscar por nombre o teléfono..."
           onkeyup="buscar()" />
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    @if (Context.Session.GetString("rol") == "ADMIN")
                    {
                        <th>
                            <input type="checkbox"
                                   onclick="seleccionarTodos(this)" />
                        </th>
                    }
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody id="tablaClientes">
                @foreach (var item in Model)
                {
                    <tr id="fila_@item.Idcliente">
                        @if (Context.Session.GetString("rol") == "ADMIN")
                        {
                            <td>

                                <input type="checkbox"
                                       class="checkCliente"
                                       value="@item.Idcliente" />

                            </td>
                        }
                        <td>@item.Nombre</td>
                        <td>@item.Telefono</td>
                        <td>@item.Direccion</td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <button class="btn btn-sm btn-warning"
                                    onclick="editar(@item.Idcliente, '@item.Nombre', '@item.Telefono', '@item.Direccion')">
                                ✏️
                            </button>

                            <!-- ELIMINAR SOLO ADMIN -->
                            @if (Context.Session.GetString("rol") == "ADMIN")
                            {
                                <button class="btn btn-sm btn-danger"
                                        onclick="confirmarEliminar(@item.Idcliente)">

                                    🗑️

                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="clienteModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="tituloModal">Nuevo Cliente</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="idcliente" />

                <input id="nombre" class="form-control mb-2" placeholder="Nombre completo" />
                <input id="telefono" class="form-control mb-2" placeholder="Teléfono (8 dígitos)" />
                <textarea id="direccion" class="form-control" placeholder="Dirección"></textarea>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardar(event)">Guardar</button>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>

        let editando = false;

        // ABRIR NUEVO
        function abrirNuevo() {
            editando = false;

            document.getElementById("tituloModal").innerText = "Nuevo Cliente";
            document.getElementById("idcliente").value = "";
            document.getElementById("nombre").value = "";
            document.getElementById("telefono").value = "";
            document.getElementById("direccion").value = "";

            new bootstrap.Modal(document.getElementById('clienteModal')).show();
        }

        // EDITAR
        function editar(id, nombre, telefono, direccion) {
            editando = true;

            document.getElementById("tituloModal").innerText = "Editar Cliente";
            document.getElementById("idcliente").value = id;
            document.getElementById("nombre").value = nombre;
            document.getElementById("telefono").value = telefono;
            document.getElementById("direccion").value = direccion;

            new bootstrap.Modal(document.getElementById('clienteModal')).show();
        }

        // GUARDAR
        function guardar(e) {

            if (e) e.preventDefault();

            let telefono = document.getElementById("telefono").value;

            if (!/^\d{8}$/.test(telefono)) {
                alert("El teléfono debe tener 8 dígitos");
                return;
            }

            let data = {
                Idcliente: parseInt(document.getElementById("idcliente").value) || 0,
                Nombre: document.getElementById("nombre").value,
                Telefono: telefono,
                Direccion: document.getElementById("direccion").value
            };

            let url = data.Idcliente > 0 ? '/Cliente/Editar' : '/Cliente/Crear';

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(() => location.reload())
            .catch(err => console.error(err));
        }

        // CONFIRMAR
        function confirmarEliminar(id) {
            if (confirm("¿Eliminar este cliente?")) {
                eliminar(id);
            }
        }

        // ELIMINAR
        function eliminar(id) {
            fetch('/Cliente/Eliminar?id=' + id, { method: 'POST' })
            .then(() => location.reload());
        }

        // ELIMINAR MÚLTIPLE
        function eliminarSeleccionados() {

            let seleccionados = [];

            document.querySelectorAll('.checkCliente:checked').forEach(cb => {
                seleccionados.push(parseInt(cb.value));
            });

            if (seleccionados.length === 0) {
                alert("Selecciona al menos uno");
                return;
            }

            if (!confirm("Eliminar " + seleccionados.length + " clientes?")) return;

            fetch('/Cliente/EliminarMultiple', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(seleccionados)
            })
            .then(() => location.reload());
        }

        // BUSCADOR
        function buscar() {
            let input = document.getElementById("buscador").value.toLowerCase();

            document.querySelectorAll("#tablaClientes tr").forEach(fila => {
                let nombre = fila.children[1].innerText.toLowerCase();
                let telefono = fila.children[2].innerText.toLowerCase();

                fila.style.display =
                    nombre.includes(input) || telefono.includes(input)
                        ? ""
                        : "none";
            });
        }

        // CHECKBOX
        function seleccionarTodos(source) {
            document.querySelectorAll('.checkCliente').forEach(cb => {
                cb.checked = source.checked;
            });
        }

    </script>
}