@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h3>Productos</h3>
        <p class="text-muted">Inventario y catálogo de productos.</p>
    </div>

    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productoModal">
        + Nuevo Producto
    </button>
</div>

<div class="card-box mt-3">

    <input class="form-control mb-3" placeholder="Buscar por nombre o categoría..." />

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Stock</th>
                <th>Precio / Costo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody id="tablaProductos">

            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <img src="https://via.placeholder.com/40" style="border-radius:8px;">
                        <div>
                            <b>Peluche Jesús Rojo</b><br />
                            <small>Peluches</small>
                        </div>
                    </div>
                </td>

                <td>
                    <span class="badge bg-success">8 unid.</span>
                </td>

                <td>
                    <b>$17.50</b><br />
                    <small>Costo: $8.00</small>
                </td>

                <td>
                    <span class="badge bg-success">Disponible</span>
                </td>

                <td>✏️ 🗑️</td>
            </tr>

        </tbody>
    </table>
</div>

<!-- MODAL PRO -->
<div class="modal fade" id="productoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Nuevo Producto</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- NOMBRE -->
                <div class="mb-3">
                    <label>Nombre</label>
                    <input id="nombre" class="form-control" />
                </div>

                <!-- FILA -->
                <div class="row">
                    <div class="col-md-6">
                        <label>Categoría</label>
                        <input id="categoria" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label>Stock Inicial</label>
                        <input id="stock" type="number" class="form-control" value="0" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <label>Precio Venta ($)</label>
                        <input id="precio" type="number" class="form-control" value="0" />
                    </div>

                    <div class="col-md-6">
                        <label>Costo ($)</label>
                        <input id="costo" type="number" class="form-control" value="0" />
                    </div>
                </div>

                <!-- IMAGEN -->
                <div class="mt-3">
                    <label>Imagen del Producto</label>

                    <input type="file" id="imagenFile" class="form-control mb-2" accept="image/*" />

                    <input type="text" id="imagenUrl" class="form-control" placeholder="O pega URL de imagen (https://...)" />
                </div>

                <!-- DESCRIPCIÓN -->
                <div class="mt-3">
                    <label>Descripción</label>
                    <textarea id="descripcion" class="form-control"></textarea>
                </div>

                <!-- CHECK -->
                <div class="form-check mt-3">
                    <input type="checkbox" id="estado" class="form-check-input" checked />
                    <label class="form-check-label">
                        Producto disponible para la venta
                    </label>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="agregarProducto()">Guardar</button>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        function agregarProducto() {

            let nombre = document.getElementById("nombre").value;
            let categoria = document.getElementById("categoria").value;
            let stock = document.getElementById("stock").value;
            let precio = document.getElementById("precio").value;
            let costo = document.getElementById("costo").value;

            if (!nombre || !stock) {
                alert("Completa los campos");
                return;
            }

            let estado = stock > 0 ? "Disponible" : "Oculto";
            let colorStock = stock > 0 ? "success" : "danger";
            let colorEstado = stock > 0 ? "success" : "secondary";

            let tabla = document.getElementById("tablaProductos");

            tabla.innerHTML += `
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <img src="https://via.placeholder.com/40" style="border-radius:8px;">
                        <div>
                            <b>${nombre}</b><br />
                            <small>${categoria}</small>
                        </div>
                    </div>
                </td>

                <td>
                    <span class="badge bg-${colorStock}">${stock} unid.</span>
                </td>

                <td>
                    <b>$${precio}</b><br />
                    <small>Costo: $${costo}</small>
                </td>

                <td>
                    <span class="badge bg-${colorEstado}">${estado}</span>
                </td>

                <td>✏️ 🗑️</td>
            </tr>
        `;

            document.getElementById("nombre").value = "";
            document.getElementById("categoria").value = "";
            document.getElementById("stock").value = "";
            document.getElementById("precio").value = "";
            document.getElementById("costo").value = "";
        }
    </script>
}